    {
      "source_id": "FY2025",
      "raw_sha256": "8c620b0b2a555f37552f3310731dff808f11d43d150f3e7bb28264c65995306b",
      "physical_page": 13,
      "printed_page": 13,
      "literal": "剩余产能待市场扩大后再行建设。",
      "support_boundary": "在建产能7万吨为15万吨项目部分，设计产能55万吨/实际产能303,590.49吨原标签需保留，不擅改成标准产能利用率。"
    },
    {
      "source_id": "FY2025",
