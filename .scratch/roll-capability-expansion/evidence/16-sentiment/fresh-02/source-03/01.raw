rollSentimentCorpus03({"bizCode":"","bizMsg":"","code":0,"extra":{},"hitsTotal":10000,"msg":"OK","result":{"cmsArticleWebOld":[{"date":"2026-10-18 15:40:51","image":"","code":"202610183899133870","title":"民生健康：前三季度<em>净利润</em>同比<em>下降</em>26.36%","content":"前三季度实现营业收入7.44亿元，同比增长19.43%；归属于上市公司股东的<em>净利润</em>为8426.00万元，同比<em>下降</em>26.36%。<em>净利润</em><em>下降</em>主要系本报告期内持有的技源集团股份产生的公允价值变动、理财产品及结构性存款的公允价值变动所致。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610183899133870.html"},{"date":"2026-10-18 16:02:00","image":"","code":"202610183899140928","title":"东兴证券：第三季度<em>净利润</em>同比<em>下降</em>24.85%","content":"南财智讯10月18日电，东兴证券发布三季度报告，第三季度公司实现营业收入9.79亿元，<em>下降</em>28.06%；归属于上市公司股东的<em>净利润</em>5.86亿元，<em>下降</em>24.85%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610183899140928.html"},{"date":"2026-10-18 15:52:00","image":"","code":"202610183899138759","title":"民生健康：第三季度<em>净利润</em>同比<em>下降</em>97.30%","content":"前三季度公司实现营业收入7.44亿元，同比增长19.43%；前三季度归属于上市公司股东的<em>净利润</em>8426.00万元，同比<em>下降</em>26.36%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610183899138759.html"},{"date":"2026-10-18 15:38:56","image":"","code":"202610183899138116","title":"信达证券：前三季度<em>净利润</em>同比<em>下降</em>4.83%","content":"<em>净利润</em>变动主要系当期所得税费用增加导致<em>净利润</em>减少。小财注：公司Q3<em>净利润</em>1.91亿，Q2<em>净利润</em>6.45亿，据此计算，Q3<em>净利润</em>环比<em>下降</em>70%。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610183899138116.html"},{"date":"2026-10-18 16:01:00","image":"","code":"202610183899141073","title":"信达证券：第三季度<em>净利润</em>同比<em>下降</em>42.03%","content":"南财智讯10月18日电，信达证券发布三季度报告，第三季度公司实现营业收入8.70亿元，<em>下降</em>11.37%；归属于上市公司股东的<em>净利润</em>1.91亿元，<em>下降</em>42.03%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610183899141073.html"},{"date":"2026-10-18 14:45:44","image":"","code":"202610183899130158","title":"民士达：前三季度<em>净利润</em>约7832.56万元<em> </em>同比<em>下降</em>14.09%","content":"上证智讯 10月16日晚间，民士达发布2026年三季度报告称，公司前三季度实现营业收入约3.57亿元，同比增长4.08%；归属于上市公司股东的<em>净利润</em>约7832.56万元，同比<em>下降</em>14.09%；归属于上市公司股东的扣除非经常性损益后的<em>净利润</em>约6826.83万元，同比<em>下降</em>21.74%；","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899130158.html"},{"date":"2026-10-18 16:45:39","image":"","code":"202610183899149726","title":"民生健康：前三季度<em>净利润</em>约8426万元<em> </em>同比<em>下降</em>26.36%","content":"其中，第三季度单季实现营业收入约2.08亿元，同比增长30.04%；归属于上市公司股东的<em>净利润</em>约87万元，同比<em>下降</em>97.30%；扣除非经常性损益的<em>净利润</em>约867万元，同比增长0.32%；基本每股收益0.0024元。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899149726.html"},{"date":"2026-10-18 16:28:49","image":"","code":"202610183899145958","title":"爱施德：前三季度<em>净利润</em>约1.16亿元<em> </em>同比<em>下降</em>65.57%","content":"上证智讯 10月16日晚间，爱施德发布2026年第三季度报告称，年初至报告期末，公司实现营业收入约441.55亿元，同比增长12.14%；归属于上市公司股东的<em>净利润</em>约1.16亿元，同比<em>下降</em>65.57%；归属于上市公司股东的扣除非经常性损益的<em>净利润</em>约2.30亿元，同比<em>下降</em>26.82%","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899145958.html"},{"date":"2026-10-18 16:45:38","image":"","code":"202610183899148942","title":"信达证券：前三季度<em>净利润</em>约12.88亿元<em> </em>同比<em>下降</em>4.83%","content":"上证智讯 10月18日晚间，信达证券发布2026年第三季度报告称，公司前三季度实现营业收入约33.05亿元，同比增长9.48%；归属于上市公司股东的<em>净利润</em>约12.88亿元，同比<em>下降</em>4.83%；归属于上市公司股东的扣除非经常性损益的<em>净利润</em>约13.45亿元，同比<em>下降</em>0.49%；基本每股收益","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899148942.html"},{"date":"2026-10-18 16:28:48","image":"","code":"202610183899144483","title":"苏奥传感：前三季度<em>净利润</em>约3753万元<em> </em>同比<em>下降</em>56.26%","content":"第三季度公司实现营业收入约5.12亿元，同比<em>下降</em>11.41%；归属于上市公司股东的<em>净利润</em>约480万元，同比<em>下降</em>83.18%。 　　公司表示，<em>净利润</em><em>下降</em>主要系销售<em>下降</em>以及汇兑损失增加等因素所致。 　　本文由AI生成，不构成投资建议。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899144483.html"},{"date":"2026-10-18 15:40:13","image":"","code":"202610183899133293","title":"信达证券：第三季度<em>净利润</em>1.91亿元<em> </em>同比<em>下降</em>42.03%","content":"信达证券10月18日公告，2026年第三季度实现营业收入8.7