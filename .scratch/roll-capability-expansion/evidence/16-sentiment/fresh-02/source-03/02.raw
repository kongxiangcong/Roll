rollSentimentCorpus03({"bizCode":"","bizMsg":"","code":0,"extra":{},"hitsTotal":10000,"msg":"OK","result":{"cmsArticleWebOld":[{"date":"2026-10-18 14:45:44","image":"","code":"202610183899129234","title":"ST通葡：前三季度净利润<em>亏损</em>约6117万元","content":"上证智讯 10月16日晚间，ST通葡发布2026年第三季度报告称，公司前三季度实现营业收入约3.64亿元，同比下降26.10%；归属于上市公司股东的净利润<em>亏损</em>约6117万元；扣除非经常性损益后的净利润<em>亏损</em>约5212万元；经营活动产生的现金流量净额约-1.77亿元。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899129234.html"},{"date":"2026-10-18 14:45:44","image":"","code":"202610183899129338","title":"泰瑞机器：前三季度营<em>业</em>收入约7.58亿元<em> 亏损</em>约1141万元","content":"上证智讯 10月16日晚间，泰瑞机器发布2026年第三季度报告称，公司前三季度实现营业收入约7.58亿元，同比下降12.58%；归属于上市公司股东的净利润<em>亏损</em>约1141万元，同比下降117.22%；归属于上市公司股东的扣除非经常性损益的净利润<em>亏损</em>约1481万元，同比下降124.84%","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899129338.html"},{"date":"2026-10-16 17:29:00","image":"","code":"202610163898472449","title":"ST通葡：第三季度净<em>亏损</em>3069.20万元","content":"前三季度公司实现营业收入3.64亿元，同比下降26.10%；前三季度归属于上市公司股东的净<em>亏损</em>6117.30万元，同比增长率不适用。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610163898472449.html"},{"date":"2026-10-18 14:45:44","image":"","code":"202610183899128940","title":"集泰股份：前三季度营收约7.84亿元<em> </em>净利润<em>亏损</em>约768.17万元","content":"上证智讯 10月16日晚间，集泰股份发布2026年三季度报告称，公司前三季度实现营业收入约7.84亿元，同比下降5.04%；归属于上市公司股东的净利润<em>亏损</em>约768.17万元，同比下降78.18%；扣除非经常性损益后的净利润<em>亏损</em>约1276.77万元，同比下降81.16%。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899128940.html"},{"date":"2026-10-17 16:44:00","image":"https://np-newspic.dfcfw.com/download/D25254339263182816635_w210h154.jpg","code":"202610173899048488","title":"刷屏！知名港星投资巨<em>亏</em>！总想一夜暴富<em> </em>不敢告诉家人<em>亏损</em>金额","content":"明星投资<em>亏损</em>越来越常见。 　　近日，中国香港明星方力申投资巨亏的消息刷屏。他自曝因买入NFT亏去大量资金，“亏得比我之前炒股还多，<em>亏损</em>金额至今不敢告诉家人。”此外，韩国“炒股综艺”也热门起来，不少明星自曝巨额<em>亏损</em>。 　　目前，全球股市正经历新一轮震荡。","mediaName":"券商中国","url":"http://finance.eastmoney.com/a/202610173899048488.html"},{"date":"2026-10-19 04:31:03","image":"","code":"202610193899236824","title":"今日数据精选：全球人形机器人收入前五全是中国企<em>业</em>；售电行<em>业</em>陷入<em>亏损</em>","content":"业内人士补充，上述统计仅为电力交易系统账面<em>亏损</em>结果，如果叠加企业运营成本、市场开发费用，实际陷入<em>亏损</em>的售电公司数量还会进一步增加。值得注意的是，批零倒挂、售电行业大面积<em>亏损</em>并非广东独有的区域性问题，国内多个省份都面临相似的市场压力，广西的行业问题尤为突出。","mediaName":"上观新闻","url":"http://finance.eastmoney.com/a/202610193899236824.html"},{"date":"2026-10-16 21:24:56","image":"","code":"202610163898639582","title":"女研究员近4年老鼠仓<em>亏损</em>收场","content":"老鼠仓的尽头是<em>亏损</em>？ 　　当然，恽某并非孤例，近年来披露的多起老鼠仓罚单一再证明：靠未公开信息套利往往以<em>亏损</em>收场。即便主体从公募基金经理延伸至保险资管研究员，“<em>亏损</em>收场”这一结局却高度相似。","mediaName":"财联社","url":"http://insurance.eastmoney.com/a/202610163898639582.html"},{"date":"2026-10-16 16:47:00","image":"","code":"202610163898424225","title":"亚洲水泥（中国）：预计前三季度<em>亏损</em>约3.01亿元","content":"10月16日，亚洲水泥（中国）（00743）发布公告，公司预计2026年前三季度归母净<em>亏损</em>约3.01亿元，去年同期则盈利1.46亿元。 　　公告提到，报告期内，公司水泥产品销量及售价同比下降，而且公司对部分因产能置换而退出的生产线相关资产进行减值拨备。","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610163898424225.html"},{"date":"2026-10-16 19:32:00","image":"","code":"202610163898552631","title":"芯朋微：第三季度<em>亏损</em>7152万元<em> </em>同比下降181.9%","content":"其中第三季度，公司营业收入为3.41亿元，同比上升41.35%；<em>亏损</em>7152万元，同比下降181.9%；扣非<em>亏损</em>2062万元，同比下降671.0%；EPS为-0.55元。","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610163898552631.html"},{"date":"2026-10-16 16:22:41","image":"","code":"202610163898671783","title":"恒生科技指数上涨1.16%，稀土永磁板块涨幅居前｜港股收评","content":"板块方面，稀土永磁板块涨幅居前，成分股中，都都控股上涨32.74%，金力永磁上涨3.06%，<em>江西铜业</em>股份上涨1.28%。 　　K12教育板块表现强势，成分股中，成实外教育上涨16.67%，光正教育上涨10.42%，新东方-S上涨5.9%。","mediaName":"21世纪经济报道","url":"http://finance.eastmoney.com/a/202610163898671783.html"},{"date":"2026-10-18 13:10:57","image":"","code":"202610183899120644","title":"“老鼠仓”近4年最终<em>亏损</em>！一保险资管公司女研究员被罚50万","content":"2022年1月24日至2025年9月29日期间，恽某控制“黄某菊”“祝某香”两个光大证券账户，利用因职务便利获取的未公开信息，自行或指使（明示、暗示）他人从事与案涉组合趋同的证券交易，相关趋同交易<em>亏损</em>。上述账户资金主要来源及去向均为恽某及其配偶。","mediaName":"红星资本局","url":"http://insurance.eastmoney.com/a/202610183899120644.html"},{"date":"2026-10-16 18:44:00","image":"","code":"202610163898511179","title":"金宏气体：预计前三季度扣非<em>亏损</em>4118.93万~4924.81万元","content":"10月16日，金宏气体（688106）发布公告，预计2026年前三季度实现营业收入22.89亿元至24.07亿元，同比增加12.69%至18.49%。 　　预计归母净利润为1525.96万元至1824.52万元，同比减少84.27%至86.84%。预计扣非归母净利润为-4924.81","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610163898511179.html"},{"date":"2026-10-18 11:27:52","image":"https://np-newspic.dfcfw.com/download/D25712667587657755782_w210h154.jpg","code":"202610183899112429","title":"女研究员“老鼠仓”：操控两个账户<em> </em>3年8个月最终<em>亏损</em>收场<em> </em>还被罚了50万","content":"2022年1月24日至2025年9月29日期间，恽某控制“黄某菊”“祝某香”两个光大证券账户，利用因职务便利获取的未公开信息，自行或指使（明示、暗示）他人从事与案涉组合趋同的证券交易，相关趋同交易<em>亏损</em>。上述账户资金主要来源及去向均为恽某及其配偶。","mediaName":"上海证券报","url":"http://finance.eastmoney.com/a/202610183899112429.html"},{"date":"2026-10-19 00:20:06","image":"https://np-newspic.dfcfw.com/download/D24797327317821539329_w210h154.jpg","code":"202610183899192377","title":"雅思停考风波背后：巅峰时内地一天超7万人次考试<em> </em>主办方近5财年累计净<em>亏损</em>1.84亿英镑","content":"从报告统计的数据看，BC近年持续<em>亏损</em>，自2020~2021年度以来，累计净<em>亏损</em>达1.84亿英镑。最近5年内，除2021~2022年度通过处置其在印度雅思考试市场中的股份获得收益实现盈利外，其他4年均<em>亏损</em>。2021年4月至2026年1月，BC共裁减2110名全职员工。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610183899192377.html"},{"date":"2026-10-16 17:44:00","image":"","code":"202610163898483877","title":"ST通葡：前三季度营收同比降26.1%<em> 亏损</em>扩大至6117万元","content":"10月16日，ST通葡(600365)公布2026年三季报，公司营业收入为3.64亿元，同比下降26.1%；归母净利润自去年同期<em>亏损</em>4857万元变为<em>亏损</em>6117万元，<em>亏损</em>额进一步扩大；扣非归母净利润自去年同期<em>亏损</em>3961万元变为<em>亏损</em>5212万元，<em>亏损</em>额进一步扩大；经营现金流净额为-","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610163898483877.html"},{"date":"2026-10-15 11:20:00","image":"","code":"202610153896640928","title":"天合光能：下半年组件<em>业</em>务<em>亏损</em>幅度预计将有所收窄","content":"天合光能在2026年半年度业绩说明会上表示，当前光伏行业已进入U型周期的尾部阶段，2026年下半年，随着季节性行业旺季的到来和“反内卷”工作的持续推进，组件产品价格有望呈上升趋势，组件业务<em>亏损</em>幅度预计将有所收窄。公司会努力尽早实现经营业绩扭亏为盈。","mediaName":"人民财讯","url":"http://finance.eastmoney.com/a/202610153896640928.html"},{"date":"2026-10-18 20:20:12","image":"","code":"202610183899169486","title":"吉大正元两连板触发股价异动，公司澄清：AI安全、低空相关<em>业</em>务暂未实现规模化营收，上半年<em>业</em>绩处于<em>亏损</em>状态","content":"公司2026年半年度业绩处于<em>亏损</em>状态，2026年三季度报告将于2026年10月29日披露，公司不存在高送转情况，公司未向第三方提供未公开的相关业绩信息，相关经营数据请以届时披露的报告为准，敬请广大投资者谨慎决策，理性投资，注意投资风险。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610183899169486.html"},{"date":"2026-10-15 17:06:00","image":"","code":"202610153896978640","title":"中国建材：预计前三季度股东应占<em>亏损</em>约7.6亿元","content":"经初步测算，公司预计2026年前三季度（1-9月）未经审核的权益持有人应占<em>亏损</em>约为7.6亿元；而2025年前九个月权益持有人应占利润约为29.6亿元。","mediaName":"澎湃新闻","url":"http://finance.eastmoney.com/a/202610153896978640.html"},{"date":"2026-10-16 19:03:18","image":"","code":"202610163898518276","title":"申昊科技：预计2026年前三季度净<em>亏损</em>5600万元-6000万元","content":"申昊科技(300853.SZ)公告称，预计2026年前三季度归属于上市公司股东的净利润为<em>亏损</em>5600万元-6000万元。业绩变动主要系公司积极把握市场机遇，营业收入大幅提升，<em>亏损</em>幅度大幅收窄；同时加强应收款项催收，前期计提的信用减值损失予以冲回，增加当期利润。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610163898518276.html"},{"date":"2026-10-15 13:51:10","image":"","code":"202610153896773345","title":"短期金价仍面临挑战，机构：走弱或是买入机会，低费率黄金ETF华夏（518850）震荡走低","content":"5.83%，<em>江西铜业</em>、豫光金铅、登云股份等股纷纷重挫。","mediaName":"21世纪经济报道","url":"http://stock.eastmoney.com/a/202610153896773345.html"},{"date":"2026-10-15 16:44:59","image":"","code":"202610153896959770","title":"陕<em>西</em>黑猫：2026年前三季度净<em>亏损</em>6.36亿元","content":"注：公司Q3净利润<em>亏损</em>2.7亿，Q2净利润-0.53亿，据此计算，Q3净利润环比持续<em>亏损</em>。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610153896959770.html"},{"date":"2026-10-16 16:26:30","image":"","code":"202610163898410472","title":"晶科能源：预计2026年前三季度净<em>亏损</em>29.76亿元-35.76亿元","content":"晶科能源(688223.SH)公告称，预计2026年前三季度归属于母公司所有者的净利润为净<em>亏损</em>29.76亿元-35.76亿元，上年同期净<em>亏损</em>39.2亿元。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610163898410472.html"},{"date":"2026-10-14 20:53:00","image":"","code":"202610143895701686","title":"中国建材：预计前三季度<em>亏损</em>约7.6亿元","content":"上述预期<em>亏损</em>的主要原因是集团主要产品水泥、商品混凝土和骨料的销售价格下降，同时水泥、商品混凝土和石膏板的销量也有所减少。","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610143895701686.html"},{"date":"2026-10-18 14:35:12","image":"","code":"202610183899127452","title":"对话邵宇｜硬科技需要慢牛，<em>亏损</em>容忍度应交给市场博弈！警惕新质生产力概念炒作，企<em>业</em>出海不能再玩“洗产地”套路","content":"从宏观制度到市场投资心态，我们该设置怎样合理的容忍度，看待硬科技企业上市前后的长期<em>亏损</em>？ 　　邵宇：这里本身就存在现实矛盾。高科技企业前期持续<em>亏损</em>，是中小投资者很难承受的，这个阶段往往需要国有资本、大型机构资本，也包括一部分优质私人资本进场托举。 　　长鑫科技是很典型的案例。","mediaName":"时代财经","url":"http://finance.eastmoney.com/a/202610183899127452.html"},{"date":"2026-10-15 21:15:52","image":"","code":"202610153897161424","title":"关店132家仍单季<em>亏损</em>，一鸣食品“千店拓店”渐行渐远","content":"一边是华中市场扩张需要持续的重资本投入，一边是现有华东区域的营收已经开始收缩，单季度陷入<em>亏损</em>。没有足够的门店规模，就摊薄不了上游生产和冷链配送的单位成本；但盲目扩张门店，又会在单店模型没跑通的阶段，直接把公司拖进<em>亏损</em>的泥潭。","mediaName":"北京商报","url":"http://finance.eastmoney.com/a/202610153897161424.html"},{"date":"2026-10-14 07:26:04","image":"","code":"202610143894611044","title":"港股分拆上市趋热","content":"受政策利好影响，今年以来，包括<em>江西铜业</em>、海信集团、金斯瑞生物科技、信义玻璃、复星国际等多家公司推进港股分拆上市，港股分拆上市热度明显升温。（中国证券报）","mediaName":"中国证券报","url":"http://finance.eastmoney.com/a/202610143894611044.html"},{"date":"2026-10-16 18:45:07","image":"","code":"202610163898510662","title":"青岛港董家口矿石码头转让70%股份<em> </em>今年前8个月<em>亏损</em>超3000万","content":"10月14日，青岛港（601298.SH）参股30%的青岛港董家口矿石码头有限公司（简称“董家口矿石码头”）70%股权在北京产权交易所挂牌转让，转让底价为19.18亿元。 　　董家口矿石码头注册资本20亿元，于2014年3月1日正式运营。该公司位于青岛港董家口港区，坐拥北方唯一的双","mediaName":"经济参考网","url":"http://finance.eastmoney.com/a/202610163898510662.html"},{"date":"2026-10-15 18:11:26","image":"","code":"202610153897029730","title":"陕<em>西</em>黑猫：前三季度营收73.15亿元<em> </em>净利润<em>亏损</em>6.36亿元","content":"第三季度归属于上市公司股东的净利润<em>亏损</em>约2.70亿元，扣除非经常性损益的净利润<em>亏损</em>约2.71亿元；年初至报告期末归属于上市公司股东的净利润<em>亏损</em>约6.36亿元，扣除非经常性损益的净利润<em>亏损</em>约6.46亿元。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610153897029730.html"},{"date":"2026-10-16 16:30:33","image":"","code":"202610163898418852","title":"晶科能源：预计前三季度归母净利润<em>亏损</em>29.76亿元-35.76亿元","content":"晶科能源10月16日公告，预计2026年前三季度归属于母公司所有者的净利润为净<em>亏损</em>29.76亿元-35.76亿元。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610163898418852.html"},{"date":"2026-10-15 22:24:00","image":"","code":"202610153897244751","title":"董事长离婚分股，已完成过户！电魂网络仍陷<em>亏损</em>困局","content":"公司<em>亏损</em>扩大，新业务持续拓展 　　公开资料显示，电魂网络面临业绩考验。2025年，公司出现上市后的首次年度<em>亏损</em>。2026年上半年，公司<em>亏损</em>幅度同比显著扩大。","mediaName":"南方都市报","url":"http://finance.eastmoney.com/a/202610153897244751.html"},{"date":"2026-10-15 16:47:47","image":"","code":"202610153896963367","title":"陕<em>西</em>黑猫：第三季度归母净利润<em>亏损</em>2.7亿元","content":"陕西黑猫10月15日公告，2026年第三季度实现营业收入22.64亿元，同比下降13.54%；归母净利润<em>亏损</em>2.7亿元；基本每股收益-0.13元。前三季度实现营业收入73.15亿元，同比下降6.84%；归母净利润<em>亏损</em>6.36亿元；基本每股收益-0.31元。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610153896963367.html"},{"date":"2026-10-15 20:15:00","image":"","code":"202610153897129720","title":"北方华创拟以4.05亿元关联收购诺合键维全部股权<em> </em>标的上半年<em>亏损</em>942万元","content":"10月15日，北方华创（002371）发布公告，公司全资子公司北方华创微电子装备有限公司拟以现金方式收购北京集成电路装备产业投资并购二期基金（有限合伙）持有的北京诺合键维设备有限公司100%股权，交易金额为4.05亿元。 　　该交易构成关联交易，因装备二期基金为公司关联方。交易完成后","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610153897129720.html"},{"date":"2026-10-16 21:05:01","image":"","code":"202610163898631745","title":"阳光100中国清盘呈请聆讯押后判决；陆控预计第三季度净<em>亏损</em>13亿至17亿元丨港股公告精选","content":"陆控：预计2026年第三季度净<em>亏损</em>13亿元至17亿元 　　陆控公告，公司预计截至2026年9月30日止三个月将录得净<em>亏损</em>13亿元至17亿元。2026年上半年，公司录得净<em>亏损</em>约6.94亿元。第三季度净<em>亏损</em>增加主要由于信用减值损失增加及确认额外税项开支所致。","mediaName":"21世纪经济报道","url":"http://finance.eastmoney.com/a/202610163898631745.html"},{"date":"2026-10-16 20:08:34","image":"","code":"202610163898565325","title":"一则互动信息再度引爆股价，南威软件涨停背后半年<em>亏损</em>1.7亿元，称AI短剧年产超100部","content":"具体来看，报告期内公司实现营业收入2.15亿元，较上年同期的3.14亿元减少31.61%；利润总额<em>亏损</em>2.05亿元，较上年同期<em>亏损</em>0.91亿元扩大124.39%；归母净利润<em>亏损</em>1.70亿元，较上年同期<em>亏损</em>0.72亿元扩大136.16%；扣非净利润<em>亏损</em>1.71亿元，较上年同期<em>亏损</em>0.74","mediaName":"蓝鲸财经","url":"http://finance.eastmoney.com/a/202610163898565325.html"},{"date":"2026-10-15 16:45:02","image":"","code":"202610153896958012","title":"国光连锁：第三季度归母净利润<em>亏损</em>1062.19万元","content":"国光连锁10月15日公告，2026年第三季度实现营业收入7.03亿元，同比增长2.6%；归母净利润<em>亏损</em>1062.19万元；基本每股收益-0.0212元。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610153896958012.html"},{"date":"2026-10-15 19:26:00","image":"","code":"202610153897092217","title":"中铝国际：第三季度扣非<em>亏损</em>789万元<em> </em>营收同比降28.8%","content":"其中第三季度，公司营业收入为39.3亿元，同比下降28.8%；归母净利润为40万元，同比下降97.5%；扣非归母净利润<em>亏损</em>789万元，同比下降150.7%；EPS为0.0001元。","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610153897092217.html"},{"date":"2026-10-14 17:15:00","image":"","code":"202610143895544580","title":"一鸣食品：Q3<em>亏损</em>521万元<em> </em>营收同比降7.3%","content":"其中第三季度，公司营业收入为6.89亿元，同比下降7.3%；归母净利润<em>亏损</em>521万元，同比下降136.7%；扣非归母净利润<em>亏损</em>88万元，同比下降107.3%；EPS为-0.013元。","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610143895544580.html"},{"date":"2026-10-14 16:58:20","image":"","code":"202610143895518619","title":"天邦食品：2026年前三季度净<em>亏损</em>16.58亿元","content":"注：公司Q3净利润<em>亏损</em>1.15亿，Q2净利润-8.35亿，据此计算，Q3净利润环比持续<em>亏损</em>。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610143895518619.html"},{"date":"2026-10-14 21:00:57","image":"","code":"202610143895696656","title":"一鸣食品第三季度<em>亏损</em>521.21万元，同比由盈转<em>亏</em>","content":"10月14日，一鸣食品发布的2026年第三季度业绩报告显示，第三季度实现营业收入约6.89亿元，同比下降7.34%；实现归母净利润<em>亏损</em>521.21万元，上年同期净利润为1420.1万元。","mediaName":"北京商报","url":"http://finance.eastmoney.com/a/202610143895696656.html"},{"date":"2026-10-14 18:50:00","image":"","code":"202610143895607430","title":"安路科技：预计前三季度<em>亏损</em>收窄至1亿~1.2亿元","content":"同时，尽管归母净利润仍为负值，但<em>亏损</em>额同比大幅收窄，显示出公司经营状况的改善。 　　2026年中期，安路科技实现收入4.32亿元，归母净利润-7447万元。","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610143895607430.html"},{"date":"2026-10-14 17:35:37","image":"","code":"202610143895815245","title":"闽灿坤B：预计前三季度归母净<em>亏损</em>3600万元-4000万元","content":"预计前三季度归母净利润<em>亏损</em>3600万元–4000万元，上年同期盈利2331万元。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610143895815245.html"},{"date":"2026-10-14 17:09:00","image":"","code":"202610143895528892","title":"天邦食品：第三季度净利润<em>亏损</em>1.15亿元","content":"前三季度生猪销售价格大幅下跌，公司生猪养殖业务<em>亏损</em>较大。公司前三季度食品业务<em>亏损</em>1402.19万元，同比减亏5865.54万元。","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202610143895528892.html"},{"date":"2026-10-14 15:47:47","image":"","code":"202610143895455817","title":"从<em>亏损</em>十几亿到一铺难求，大庸古城要“复活”了？","content":"2021—2024年，大庸古城累计<em>亏损</em>超10.8亿元，上市公司张家界旅游也被拖入破产重整的边缘。2025年，大庸古城计提资产减值4.59亿元，整体<em>亏损</em>5.55亿元，成为了“<em>亏损</em>黑洞”。","mediaName":"时代财经APP","url":"http://finance.eastmoney.com/a/202610143895455817.html"},{"date":"2026-10-18 14:15:50","image":"https://np-newspic.dfcfw.com/download/D25025761010366531355_w210h154.jpg","code":"202610183899123210","title":"节后A股持续调整<em> </em>量化私募普遍回撤<em> </em>稳博投资有产品年内<em>亏</em>28.39%！但斌凌晨发文","content":"月度净值数据显示，该产品7月<em>亏损</em>46.24%，之后8月有所反弹，但9月<em>亏损</em>7.17%，10月以来（截至10月13日）<em>亏损</em>5.79%。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610183899123210.html"},{"date":"2026-10-15 21:58:29","image":"","code":"202610153897216787","title":"北方华创拟4.05亿元溢价收购<em>亏损</em>标的诺合键维，<em>业</em>务互补补齐混合键合核心版图","content":"2026年上半年无营收，仍处于<em>亏损</em>中。 　　对于诺合键维营业利润和净利润为负，公告指出，诺合键维核心产品混合键合设备尚处于技术迭代、产品验证和市场导入阶段，营业收入规模较小且研发投入较大所致。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610153897216787.html"},{"date":"2026-10-07 15:41:08","image":"","code":"202610073888887262","title":"<em>江西铜业</em>与控股股东重签关联交易合同，三年采购预计上限超520亿元","content":"9月30日晚间，<em>江西铜业</em>(600362)发布公告称，公司与控股股东<em>江西铜业</em>集团有限公司签署三项日常关联交易协议，有效期自2027年1月1日至2029年12月31日，涉及物料供应、产品销售及土地房屋租赁等多个领域。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610073888887262.html"},{"date":"2026-10-14 17:45:20","image":"","code":"202610143895555031","title":"连续<em>亏损</em>五年，四环生物借钱撬动3.2亿元收购资产","content":"2026年上半年实现营业收入1.11亿元，同比下降39.12%；归属于上市公司股东的净<em>亏损</em>为2583.32万元，上年同期为<em>亏损</em>1009.89万元，<em>亏损</em>额进一步扩大；归属于上市公司股东的扣除非经常性损益的净<em>亏损</em>为2817.44万元，上年同期为<em>亏损</em>1195.91万元。","mediaName":"蓝鲸财经","url":"http://finance.eastmoney.com/a/202610143895555031.html"},{"date":"2026-10-16 16:52:05","image":"","code":"202610163898431782","title":"海科新源：预计前三季度归母净利润6.3亿元-6.42亿元，上年同期<em>亏损</em>1.28亿元","content":"海科新源10月16日公告，预计前三季度实现归母净利润6.3亿元-6.42亿元，上年同期<em>亏损</em>1.28亿元。该公司称，业绩变动主要受益于新能源与消费化学品两大业务板块向好。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610163898431782.html"},{"date":"2026-10-14 19:10:36","image":"","code":"202610143895610752","title":"安路科技：预计前三季度归母净<em>亏损</em>1亿元-1.2亿元","content":"预计前三季度归母净利润<em>亏损</em>1.2亿元-1亿元，上年同期<em>亏损</em>1.91亿元。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610143895610752.html"},{"date":"2026-10-14 18:39:23","image":"","code":"202610143895601362","title":"安路科技：预计2026年前三季度净<em>亏损</em>1.00亿元-1.20亿元","content":"小财注：公司Q3净利润预计<em>亏损</em>0.26亿-<em>亏损</em>0.46亿，Q2净利润-0.34亿，据此计算，Q3净利润预计环比持续<em>亏损</em>。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610143895601362.html"},{"date":"2026-10-14 21:58:09","image":"","code":"202610143895761840","title":"<em>西</em>安饮食拟挂牌转让东大融迪100%股权，聚焦餐饮主<em>业</em>发展<em> </em>标的上半年<em>亏损</em>","content":"西安饮食（000721）10月14日晚间披露公告，公司计划挂牌转让持有的陕西东大融迪温泉疗养有限责任公司（以下简称“东大融迪”）100%股权。 　　公告显示，公司为聚焦餐饮主业发展，剥离与主业无协同效应资产，实现资源优化配置，公司拟通过产交中心以公开挂牌方式转让持有的子公司东大融迪","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610143895761840.html"},{"date":"2026-10-14 17:05:21","image":"","code":"202610143895710528","title":"闽灿坤B：预计2026年前三季度净<em>亏损</em>3600万元-4000万元<em> </em>同比转<em>亏</em>","content":"闽灿坤B(200512.SZ)公告称，预计2026年前三季度归属于上市公司股东的净利润为<em>亏损</em>3600万元-4000万元，同比转亏。业绩变动主要系国际市场需求影响导致营业收入下降，原材料价格高位推高制造成本，人民币升值增加汇兑损失，以及计提减值准备所致。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610143895710528.html"},{"date":"2026-10-13 17:45:00","image":"","code":"202610133894242459","title":"冰川网络：预计前三季度<em>亏损</em>1.25亿元至1.78亿元","content":"10月13日，冰川网络（300533）发布公告，预计2026年前三季度归母净利润约<em>亏损</em>1.25亿元至1.78亿元，同比下降124.91%至135.47%。扣除非经常性损益后的净利润预计为<em>亏损</em>1.69亿元至2.22亿元，同比下降135.2%至146.26%。","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610133894242459.html"},{"date":"2026-10-16 08:49:24","image":"","code":"202610163897316680","title":"7天4次触及涨停<em> </em>装修公司站上AI漫剧风口！一家<em>亏损</em>孙公司撑起20亿元“漫剧溢价”？","content":"但<em>亏损</em>也是真实的。上半年净亏562.17万元，意味着奇想无限每收入1元就要亏掉约0.23元。公司2026年半年度报告将其表述为“目前奇想无限尚处于业务初创期，呈现阶段性<em>亏损</em>特征”。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610163897316680.html"},{"date":"2026-10-14 17:09:43","image":"","code":"202610143895527150","title":"一鸣食品：第三季度归母净<em>亏损</em>521.21万元<em> </em>同比由盈转<em>亏</em>","content":"一鸣食品10月14日公告，2026年第三季度实现营业收入6.89亿元，同比下降7.34%；归属于上市公司股东的净利润<em>亏损</em>521.21万元，上年同期净利润为1420.1万元；基本每股收益<em>亏损</em>0.013元。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610143895527150.html"},{"date":"2026-10-14 17:02:09","image":"","code":"202610143895523746","title":"天邦食品：第三季度归母净利润<em>亏损</em>1.15亿元","content":"前三季度实现营业收入53.74亿元，同比下降20.01%；归属于上市公司股东的净利润<em>亏损</em>16.58亿元；基本每股收益<em>亏损</em>0.7462元。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610143895523746.html"},{"date":"2026-10-18 19:55:53","image":"","code":"202610183899168327","title":"半年报曾提示退市风险，*ST准油获控股股东“援手”：拟无偿赠与公司现金6000万元","content":"最新业绩方面，8月17日，*ST准油（002207）公布2026年半年报，公司营业收入为1.57亿元，同比上升28.85%；归母净利润自去年同期<em>亏损</em>1893万元变为<em>亏损</em>1869万元，<em>亏损</em>额略有减少；扣非归母净利润自去年同期<em>亏损</em>1928万元变为<em>亏损</em>1945万元，<em>亏损</em>额略有扩大；经营现金流净额为","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610183899168327.html"},{"date":"2026-10-14 11:46:54","image":"","code":"202610143895584480","title":"600万理财遭<em>亏损</em>清算，银行未提示产品风险，法院判赔","content":"21世纪经济报道记者章驰 　　在存款利率进入“1时代”的背景下，很多人想把钱挪到理财里追求更高收益，于是越来越多消费者将资金投向银行理财产品。但银行理财早就不是“稳赚不赔”的存款替代品了，债券、股票等价格波动会直接反映在理财净值上。很多消费者盲目购买理财产品，忽略了产品风险，极易引发争议纠纷","mediaName":"21世纪经济报道","url":"http://money.eastmoney.com/a/202610143895584480.html"},{"date":"2026-10-18 11:55:17","image":"https://np-newspic.dfcfw.com/download/D24734137225543608829_w210h154.jpg","code":"202610183899113396","title":"焦炭行<em>业</em>首份三季报出炉！陕<em>西</em>黑猫巨<em>亏</em>6.36亿元<em> </em>控股股东加码借款输血","content":"<em>亏损</em>的核心因素是原料价格涨幅大于主产品焦炭价格涨幅，焦炭成本倒挂。公司根据行业市场变化自主调整产品结构及产量，以降低<em>亏损</em>。 　　连续<em>亏损</em>多年 　　“今年三季度，焦企<em>亏损</em>扩大是行业性的，核心原因在于成本与售价的错位挤压。三季度炼焦煤价格涨幅明显大于焦炭。”","mediaName":"华夏时报","url":"http://finance.eastmoney.com/a/202610183899113396.html"},{"date":"2026-10-15 10:08:08","image":"","code":"202610153896576647","title":"拟高溢价买<em>亏损</em>芯片公司，仅3天告吹！东百集团跨界“踩空”，股价开盘一字跌停","content":"而标的公司自身经营并不乐观，2025年营收3976.13万元，净<em>亏损</em>1507.22万元；2026年1-8月营收3486.93万元，净<em>亏损</em>251.70万元，整体收入规模较小且尚未盈利。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610153896576647.html"},{"date":"2026-10-14 21:31:36","image":"","code":"202610143895724775","title":"远大控股前三季度净利最高预增10倍，上限近3.6亿元，此前连续三年<em>亏损</em>","content":"回顾近年业绩，根据Wind平台，公司年度归母净利润在2022年录得约1.15亿元盈利后，自2023年起连续三年陷入<em>亏损</em>。其中，2023年<em>亏损</em>约3.77亿元，2024年<em>亏损</em>约3.02亿元，2025年<em>亏损</em>约1.34亿元。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610143895724775.html"},{"date":"2026-10-14 13:40:19","image":"","code":"202610143895313826","title":"中海达拟150万元转让<em>亏损</em>子公司，预计正向影响本年<em>业</em>绩约2800万元","content":"2026年上半年，公司实现营业总收入3.5亿元，同比下降29.07%；归母净利润<em>亏损</em>4294.5万元，上年同期<em>亏损</em>2368.85万元；扣非净利润<em>亏损</em>5983.78万元，上年同期<em>亏损</em>4944.69万元。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610143895313826.html"},{"date":"2026-10-14 17:22:00","image":"","code":"202610143895561282","title":"倍轻松实控人超400万股遭冻结，公司持续<em>亏损</em>现金流承压","content":"进入2026年，经营压力尚未得到缓解，上半年，公司实现营业收入3.66亿元，同比小幅下降4.92%；归母净利润<em>亏损</em>4714.85万元，<em>亏损</em>同比扩大30.55%；经营活动产生的现金流量净额为-3976.08万元，现金流承压明显，截至二季度末资产负债率达到57.03%。","mediaName":"南方都市报","url":"http://finance.eastmoney.com/a/202610143895561282.html"},{"date":"2026-10-14 17:04:00","image":"","code":"202610143895824776","title":"闽灿坤Ｂ：预计前三季度净<em>亏损</em>3600万元—4000万元，同比预减254%—272%","content":"南财智讯10月14日电，闽灿坤Ｂ发布前三季度业绩预告，预计前三季度归属于上市公司股东的净利润为<em>亏损</em>3600万元—4000万元，同比预减254%—272%；预计前三季度归属于上市公司股东的扣除非经常性损益的净利润为<em>亏损</em>3450万元—3850万元，同比预减266%—285%，业绩变动原因为","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610143895824776.html"},{"date":"2026-10-13 17:37:26","image":"","code":"202610133894224686","title":"冰川网络：预计前三季度归母净<em>亏损</em>1.25亿元-1.78亿元","content":"冰川网络10月13日公告，预计前三季度归母净利润<em>亏损</em>1.78亿元-1.25亿元，上年同期盈利5.02亿元。预计第三季度归母净利润<em>亏损</em>1.52亿元-1.07亿元，上年同期盈利1.66亿元。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610133894224686.html"},{"date":"2026-10-12 19:03:00","image":"","code":"202610123892812089","title":"*ST利源：第三季度净<em>亏损</em>2843.72万元","content":"前三季度公司实现营业收入2.41亿元，同比增长22.47%；前三季度归属于上市公司股东的净<em>亏损</em>6177.74万元，同比增长30.14%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610123892812089.html"},{"date":"2026-10-15 18:35:45","image":"","code":"202610153897049690","title":"从“装修”到“造剧”：德才股份7天4板背后，一家<em>亏损</em>孙公司撑起20亿元“漫剧溢价”？","content":"但<em>亏损</em>也是真实的。上半年净亏562.17万元，意味着奇想无限每收入1元就要亏掉约0.23元。公司2026年半年度报告将其表述为“目前奇想无限尚处于业务初创期，呈现阶段性<em>亏损</em>特征”。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610153897049690.html"},{"date":"2026-10-13 19:52:53","image":"","code":"202610133894316271","title":"近24亿元“分手费”，神农集团实控人离婚，公司上半年<em>亏损</em>8亿元","content":"2026年上半年，公司营收24.89亿元，同比下降11.02%，归母净利润由上年同期盈利3.88亿元转为<em>亏损</em>8.09亿元，经营活动现金流量净额为负3.75亿元。","mediaName":"蓝鲸财经","url":"http://finance.eastmoney.com/a/202610133894316271.html"},{"date":"2026-10-14 20:49:04","image":"","code":"202610143895695728","title":"聚焦主<em>业</em>发展，易事特拟出售控股子公司爱申特51%股权，标的上半年<em>亏损</em>177万元","content":"财务数据显示，2025年和2026年上半年，爱申特均为<em>亏损</em>状态，净利润分别为-643.52万元、-176.89万元。截至2026年6月30日，其净资产为157.23万元。 　　易事特表示，截至本公告披露日，爱申特尚欠公司往来款132.66万元。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610143895695728.html"},{"date":"2026-10-16 18:41:55","image":"","code":"202610163898509015","title":"晶科能源第三季度明显减<em>亏 </em>高功率产品出货占比进一步提升","content":"晶科能源上半年净利润为<em>亏损</em>30.76亿元，扣非净利润为<em>亏损</em>33.61亿元；单第二季度净利润为<em>亏损</em>17.26亿元，扣非净利润为<em>亏损</em>19.47亿元。据前三季度业绩预告，公司第三季度净利润为<em>亏损</em>5亿元到盈利1亿元；第三季度扣非净利润为<em>亏损</em>10.5亿元到<em>亏损</em>4.5亿元，第三季度减亏明显。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610163898509015.html"},{"date":"2026-10-14 15:31:31","image":"","code":"202610143895448925","title":"殷图网联实控人夫妇及副总拟合计减持不超2%股份，公司上半年<em>亏损</em>收窄","content":"2026年上半年，殷图网联实现营业收入2204.24万元，同比下降16.89%；归属于上市公司股东的净利润为-68.59万元，较上年同期<em>亏损</em>237.30万元收窄71.10%；毛利率为37.13%，同比回升2.12个百分点。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610143895448925.html"},{"date":"2026-10-14 21:51:12","image":"","code":"202610143895753250","title":"天邦食品预重整遇阻：11家财务投资人退出<em> </em>前三季<em>亏损</em>16.58亿元|速读公告","content":"同日，天邦食品发布三季报显示，前三季度营业总收入53.74亿元，同比减少20.01%；归属于母公司所有者的净<em>亏损</em>16.58亿元，由盈转亏。第三季度营业总收入17.18亿元，同比减少15.18%；归母净<em>亏损</em>1.15亿元，上年同期净<em>亏损</em>9248.51万元，<em>亏损</em>同比进一步扩大。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610143895753250.html"},{"date":"2026-10-13 11:38:06","image":"","code":"202610133893959223","title":"宜人智科股价一日下跌44%，二季度<em>亏损</em>近4.5亿","content":"从经营数据看，宜人智科9月30日发布的二季报显示，2026年二季度，宜人智科促成交易金额（Total loans facilitated）63亿元，环比下降29%，同比下降69%；实现净收入8.9亿元，环比下降3%，同比下降46%；净<em>亏损</em>4.496亿元，一季度净<em>亏损</em>为4.947亿元","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610133893959223.html"},{"date":"2026-10-17 13:17:19","image":"https://np-newspic.dfcfw.com/download/D24640592065566285247_w210h154.jpg","code":"202610173899031432","title":"两广售电市场承压：广<em>西</em>企<em>业</em>联名求助<em> </em>广东发出风险提醒","content":"近日，9家央企下属售电公司联合提交《关于请求采取紧急措施防范广西电力市场系统性风险的请示》，文件披露，2026年1-8月，广西售电行业累计<em>亏损</em>超20亿元，9月单月预计<em>亏损</em>超10亿元，全年<em>亏损</em>或将突破50亿元，头部单个售电公司年<em>亏损</em>超10亿元。","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202610173899031432.html"},{"date":"2026-10-12 19:55:06","image":"","code":"202610123892863016","title":"4天3板德才股份：孙公司奇想无限仍处于<em>亏损</em>状态","content":"奇想无限成立于2025年12月5日，2026年上半年，奇想无限实现营业收入2457.09万元，净利润-562.17万元，目前尚处于业务发展阶段，营收规模较小且仍处于<em>亏损</em>状态，未对公司经营业绩产生重大影响。","mediaName":"中国证券报·中证金牛座","url":"http://finance.eastmoney.com/a/202610123892863016.html"},{"date":"2026-10-19 07:03:46","image":"","code":"202610193899245046","title":"邵阳液压：联合体中标4.62亿元储能系统设备项目；晶科能源前三季度预<em>亏</em>超29亿元；海科新源前三季度预盈6.3亿元｜新能源早参","content":"在光伏主产业链仍处于<em>亏损</em>的背景下，储能正在成为头部组件企业重要的利润对冲工具。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610193899245046.html"},{"date":"2026-10-17 07:35:34","image":"","code":"202610173898918082","title":"焦炭行<em>业</em>首份三季报出炉！陕<em>西</em>黑猫巨<em>亏</em>6.36亿元，控股股东加码借款输血","content":"<em>亏损</em>的核心因素是原料价格涨幅大于主产品焦炭价格涨幅，焦炭成本倒挂。公司根据行业市场变化自主调整产品结构及产量，以降低<em>亏损</em>。 　　连续<em>亏损</em>多年 　　“今年三季度，焦企<em>亏损</em>扩大是行业性的，核心原因在于成本与售价的错位挤压。三季度炼焦煤价格涨幅明显大于焦炭。”","mediaName":"华夏时报网","url":"http://finance.eastmoney.com/a/202610173898918082.html"},{"date":"2026-10-13 21:16:39","image":"","code":"202610133894386898","title":"冰川网络：预计前三季度归母净利润<em>亏损</em>1.25亿元至1.78亿元","content":"10月13日，冰川网络发布2026年前三季度业绩预告，预计报告期内归属于上市公司股东的净利润<em>亏损</em>1.25亿元至1.78亿元，扣除非经常性损益后的净利润<em>亏损</em>1.69亿元至2.22亿元。","mediaName":"北京商报","url":"http://finance.eastmoney.com/a/202610133894386898.html"},{"date":"2026-10-18 08:56:44","image":"https://np-newspic.dfcfw.com/download/D25421373189609131548_w210h154.jpg","code":"202610183899102019","title":"“白衣骑士”集体离场<em> </em>16亿元巨<em>亏</em>压顶<em> </em>天邦食品的“猪场抵债”能否破局？","content":"其中，第三季度单季实现营业收入17.18亿元，同比下降15.18%，归母净利润<em>亏损</em>1.15亿元，<em>亏损</em>同比扩大24.50%。","mediaName":"华夏时报","url":"http://finance.eastmoney.com/a/202610183899102019.html"},{"date":"2026-10-18 18:38:51","image":"","code":"202610183899162865","title":"快狗打车拟1元剥离中国内地<em>业</em>务，更名“GOGO科技”，上半年内地市场收入仅4400万元","content":"业绩层面，快狗打车2025年实现收入人民币6.71亿元，同比微增1.6%；年内<em>亏损</em>1.63亿元，同比收窄16.2%；经调整<em>亏损</em>净额9660.5万元。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610183899162865.html"},{"date":"2026-10-12 18:58:02","image":"","code":"202610123892812768","title":"4天3板德才股份：控股孙公司奇想无限仍处于<em>亏损</em>状态","content":"奇想无限成立于2025年12月5日，2026年上半年，奇想无限实现营业收入2457.09万元，净利润-562.17万元，目前尚处于业务发展阶段，营收规模较小且仍处于<em>亏损</em>状态，未对公司经营业绩产生重大影响。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610123892812768.html"},{"date":"2026-10-16 15:47:06","image":"","code":"202610163898383923","title":"年内“腰斩基”升至7只，<em>亏</em>最多的是百亿基金经理，修复难度大了","content":"7只主动权益基金今年以来<em>亏损</em>超50% 　　Choice数据显示，截至10月15日，今年以来<em>亏损</em>超过50%的基金已超过7只，2只基金的年内<em>亏损</em>甚至超过56%。 　　这些腰斩基金在三季度普遍出现较大幅度<em>亏损</em>。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610163898383923.html"},{"date":"2026-10-12 18:54:59","image":"","code":"202610123892801461","title":"4天3板德才股份：漫剧孙公司奇想无限仍处于<em>亏损</em>状态","content":"奇想无限成立于2025年12月5日，2026年上半年，奇想无限实现营业收入2,457.09万元，净利润-562.17万元，目前尚处于业务发展阶段，营收规模较小且仍处于<em>亏损</em>状态，未对公司经营业绩产生重大影响。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610123892801461.html"},{"date":"2026-10-18 00:52:45","image":"https://np-newspic.dfcfw.com/download/D24640592065566285247_w210h154.jpg","code":"202610173899029611","title":"多方判断电价拐点已现！<em>江</em>苏新规重塑批零传导模式有望全国铺开","content":"据《2026年广东电力市场半年报告》，上半年广东298家售电公司累计<em>亏损</em>，<em>亏损</em>面达59.6%，全行业平均度电获利仅0.0039元/千瓦时；另据有关文件透露，前8个月广西当地售电行业累计<em>亏损</em>逾20亿元，9月单月预计<em>亏损</em>超10亿元，全年<em>亏损</em>总额或突破50亿元。","mediaName":"上海证券报","url":"http://finance.eastmoney.com/a/202610173899029611.html"},{"date":"2026-10-15 14:50:55","image":"","code":"202610153896876498","title":"雅思停考风波背后：巅峰时内地一天7万人次考试，主办方近5财年累计净<em>亏损</em>1.84亿英镑，欲以藏品抵债！","content":"BC近十年的利润情况图片来源：《英国文化教育协会财务可持续性调查报告》 　　从报告统计的数据看，BC近年持续<em>亏损</em>，自2020—2021年度以来，累计净<em>亏损</em>达1.84亿英镑。最近5年内，除2021—2022年度通过处置其在印度雅思考试市场中的股份获得收益实现盈利外，其他4年均<em>亏损</em>。","mediaName":"每日经济新闻","url":"http://biz.eastmoney.com/a/202610153896876498.html"},{"date":"2026-10-16 19:45:00","image":"","code":"202610163898558626","title":"申昊科技：第三季度预计实现净利润150万—180万元，同比扭<em>亏</em>","content":"人民财讯10月16日电，申昊科技(300853)10月16日公告，前三季度预计归属于上市公司股东的净利润<em>亏损</em>5600万元—6000万元，上年同期<em>亏损</em>1.29亿元。2026年前三季度，公司积极落实“算电协同”智能运维业务，主动把握市场机遇，公司营业收入大幅提升，<em>亏损</em>幅度大幅收窄。","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202610163898558626.html"},{"date":"2026-10-13 16:00:29","image":"","code":"202610133894146039","title":"硅料龙头在杭召开“限底价”闭门会？<em> </em>协鑫：属实<em> </em>不低于4.3万元/吨就不会<em>亏损</em>","content":"10月13日上午，协鑫科技（03800.HK）有关负责人向财闻确认了上述闭门会议的召开，协鑫集团负责人则就硅料、组件的具体价格对财闻表示，“只要不低于这个价格就一定不会<em>亏损</em>，要不然大家也不会设立这个门槛。”","mediaName":"财闻","url":"http://futures.eastmoney.com/a/202610133894146039.html"},{"date":"2026-10-12 17:14:00","image":"","code":"202610123892977194","title":"贷款罚息该不该付，理财<em>亏损</em>谁担责？四部门联合发布案例","content":"房贷违约后才发现有高额违约息费条款，这笔高额罚息该不该付？ 　　银行代销的理财产品亏了本金，风险测评问卷没有本人签名，责任谁来负？ 　　券商员工私下推荐的高风险私募基金，还打着证券公司旗号卖，亏了能不能找券商赔？ 　　基金公司通过App推送的服务协议仅设置“同意并签署”“不同意并退出","mediaName":"21世纪经济报道","url":"http://money.eastmoney.com/a/202610123892977194.html"},{"date":"2026-10-18 19:27:02","image":"","code":"202610183899164657","title":"起拍价约2.44亿!<em> </em>富力、希尔顿合作酒店将拍卖，此前富力已拍卖多家五星级酒店","content":"不过盈利能力仍有待提升，富力地产上半年净<em>亏损</em>为53.07亿元，去年同期净<em>亏损</em>为40.82亿元，毛利约为6.29亿元，同比减少50%。富力地产解释称，期内的净<em>亏损</em>主要归因于房地产行业持续低迷，削弱了买家信心，并导致物业发展的毛利率下降。","mediaName":"红星资本局","url":"http://finance.eastmoney.com/a/202610183899164657.html"},{"date":"2026-10-16 23:09:46","image":"","code":"202610163898756730","title":"申昊科技算力大单密集签约<em> </em>Q3单季实现扭<em>亏</em>|速读公告","content":"今日晚间，申昊科技交出前三季度业绩预告，这家特种机器人厂商预计实现营收3.2亿元-3.5亿元，同比增加127.4%-148.7%，但公司盈利仍然承压，合计<em>亏损</em>5600万元-6000万元，同比<em>亏损</em>仅缩窄。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610163898756730.html"},{"date":"2026-10-16 17:21:50","image":"","code":"202610163898463049","title":"晶科能源：前三季度净利润预<em>亏</em>29.76亿至35.76亿元","content":"上年同期，公司归属于母公司所有者的净利润<em>亏损</em>约39.20亿元，扣除非经常性损益后的净利润<em>亏损</em>约45.43亿元，基本每股收益-0.39元。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610163898463049.html"},{"date":"2026-10-18 14:46:02","image":"","code":"202610183899130695","title":"海科新源：预计前三季度扭<em>亏</em>为盈<em> </em>净利润6.30亿元至6.42亿元","content":"上证智讯 10月16日晚间，海科新源发布2026年前三季度业绩预告称，公司预计2026年前三季度实现归属于上市公司股东的净利润6.30亿元至6.42亿元，上年同期为<em>亏损</em>约1.28亿元，比上年同期增长592%至601%；扣除非经常性损益后的净利润6.23亿元至6.35亿元，上年同期为<em>亏损</em>约","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899130695.html"},{"date":"2026-10-18 09:46:00","image":"","code":"202610183899105091","title":"陆金所控股，发布盈利预警","content":"公告显示，根据初步评估，公司预期截至2026年9月30日止三个月净<em>亏损</em>13亿元-17亿元。 　　<em>亏损</em>增加源于三大原因 　　公告显示，2026年第三季度净<em>亏损</em>增加主要是由于以下三项因素： 　　一是公司录得经营<em>亏损</em>，主要由于信用减值损失增加所致。","mediaName":"券商中国","url":"http://finance.eastmoney.com/a/202610183899105091.html"},{"date":"2026-10-16 16:20:02","image":"","code":"202610163898403838","title":"【调研快报】广<em>西</em>能源接待线上投资者调研","content":"公司就以下问题进行了回复：问题1:近期新闻报道广西售电公司<em>亏损</em>严重,请问公司售电业务是否也<em>亏损</em>,预计3、4季度<em>亏损</em>是否扩大? 董事、财务总监庞厚生答:尊敬的投资者,您好!公司售电业务上半年未出现<em>亏损</em>情况,下半年将持续做好售电市场分析和跟踪工作。谢谢您的支持和关注!","mediaName":"东方财富Choice数据","url":"http://stock.eastmoney.com/a/202610163898403838.html"},{"date":"2026-10-19 07:38:55","image":"","code":"202610193899253086","title":"期权交易“长跑”的前提是→","content":"期货方向性仓位可能因跳空和杠杆放大损失，而期权属于非线性工具，期权买方仅需要支付权利金，在价格与预期相反的情况下其<em>亏损</em>具有上限，最大<em>亏损</em>锁定为已支付的权利金。","mediaName":"期货日报","url":"http://finance.eastmoney.com/a/202610193899253086.html"},{"date":"2026-10-12 22:28:16","image":"","code":"202610123892971557","title":"4天3板德才股份回应热点概念相关报道：控股孙公司奇想无限仍处于<em>亏损</em>状态","content":"据公告披露，奇想无限成立于2025年12月5日，2026年上半年实现营业收入2457.09万元，净利润为-562.17万元，目前尚处于业务发展阶段，营收规模较小且仍处于<em>亏损</em>状态，未对公司经营业绩产生重大影响。（央广财经）","mediaName":"央广财经","url":"http://finance.eastmoney.com/a/202610123892971557.html"},{"date":"2026-10-16 17:26:05","image":"","code":"202610163898471919","title":"昔日“彩电大王”最新公告：终止上市，即将摘牌","content":"财务数据显示，康佳集团已连续多年<em>亏损</em>。2023年至2025年，公司归母净利润分别<em>亏损</em>22.58亿元、37.26亿元和125.82亿元，三年累计<em>亏损</em>约185.66亿元。进入2026年，公司<em>亏损</em>幅度有所收窄，上半年归母净利润<em>亏损</em>1.73亿元。不过，公司负净资产状况仍未扭转。","mediaName":"中新经纬","url":"http://finance.eastmoney.com/a/202610163898471919.html"},{"date":"2026-10-13 19:52:34","image":"","code":"202610133894316522","title":"德才股份5天4板！青岛知名企<em>业</em>家跨界押注AI漫剧，控股孙公司上半年<em>亏损</em>超500万","content":"德才股份2024 年业绩出现大幅<em>亏损</em>，归母净利润<em>亏损</em>2.87 亿元。面对行业变局，叶德才曾在采访中提出，要主动降低房地产业务占比，转向老旧小区建设、市政基础设施建设、历史建筑保护修缮等领域。","mediaName":"时代周报","url":"http://finance.eastmoney.com/a/202610133894316522.html"},{"date":"2026-10-16 22:05:47","image":"","code":"202610163898707925","title":"确定退市！“彩电第一股”，将于5个交易日内摘牌","content":"Wind平台显示，2022年至2025年，公司归母净利润连续四年<em>亏损</em>，累计<em>亏损</em>约202.89亿元。 　　其中，2025年<em>亏损</em>尤为惨重。公司全年实现营业收入98.35亿元，同比下降11.51%；归母净利润<em>亏损</em>125.82亿元，同比扩大237.73%。 　　巨亏之下，公司资不抵债。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610163898707925.html"},{"date":"2026-10-18 15:48:25","image":"","code":"202610183899134490","title":"2连板吉大正元：股票交易异常波动<em> </em>相关<em>业</em>务收入占比较低","content":"公司2026年半年度业绩<em>亏损</em>，三季度报告将于10月29日披露。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610183899134490.html"}]},"searchId":"b1156475-c68a-4c96-ae94-b84069dcbe04"})