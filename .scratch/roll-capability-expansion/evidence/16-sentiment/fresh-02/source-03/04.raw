rollSentimentCorpus03({"bizCode":"","bizMsg":"","code":0,"extra":{},"hitsTotal":10000,"msg":"OK","result":{"cmsArticleWebOld":[{"date":"2026-10-16 13:11:16","image":"","code":"202610163898285663","title":"<em>投产</em>周期尚未结束<em> </em>烧碱难言趋势反转","content":"同时，四季度仍有约50万吨新产能待投放，年内已<em>投产</em>177万～187万吨，2026年全年新增产能约218万吨，增速约为4%。2026—2028年计划新增产能合计约为944万吨。","mediaName":"期货日报","url":"http://futures.eastmoney.com/a/202610163898285663.html"},{"date":"2026-10-18 19:55:29","image":"","code":"202610183899172140","title":"上海“聚变第一城”加速，全球首创3公里高温超导带材<em>产</em>线将<em>投产</em>","content":"新园区<em>投产</em>后，该公司将迈入工业规模化制造新阶段。 　　“要把3公里单根长带产线质量稳定做出来，还是非常具备难度的，是对我们综合能力的一个考验。”朱佳敏介绍，2027年一季度产出产品后，就会用到下游的应用中。","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202610183899172140.html"},{"date":"2026-10-15 19:56:00","image":"","code":"202610153897121979","title":"东风汽车百亿元规模越野项目<em>投产</em>","content":"该车型将完善猛士产品矩阵，项目<em>投产</em>也为后续整车交付打下制造基础。","mediaName":"中国证券报·中证网","url":"http://finance.eastmoney.com/a/202610153897121979.html"},{"date":"2026-10-18 20:02:00","image":"","code":"202610183899170367","title":"山河智能矿岩装备新基地主体封顶<em> 投产</em>后预计实现年<em>产</em>值10亿元","content":"项目预计2027年建成投用，<em>投产</em>后矿岩装备板块将形成稳定产能，预计实现年产值10亿元。这将有力支撑山河智能推进产业、产品、市场三重结构调整，板块成长空间广阔。","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610183899170367.html"},{"date":"2026-10-16 11:41:26","image":"","code":"202610163898215941","title":"“十五五”时期首个中小型抽水蓄能项目<em>投产</em>","content":"今天（16日），我国“十五五”时期首个<em>投产</em>的中小型抽水蓄能项目——中广核湖北团风魏家冲抽水蓄能电站首台机组投入商运。 　　该项目位于湖北省黄冈市团风县，总装机容量29.8万千瓦，安装有两台单机容量14.9万千瓦的可逆式水泵水轮发电机组。","mediaName":"央视新闻","url":"http://finance.eastmoney.com/a/202610163898215941.html"},{"date":"2026-10-16 11:26:56","image":"","code":"202610163898210432","title":"“十五五”期间首个中小型抽水蓄能项目<em>投产</em>","content":"我国“十五五”期间首个<em>投产</em>的中小型抽水蓄能项目——中广核湖北团风魏家冲抽水蓄能电站首台机组投入商运。该项目位于湖北省黄冈市团风县，总装机容量29.8万千瓦，安装有两台单机容量14.9万千瓦的可逆式水泵水轮发电机组。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610163898210432.html"},{"date":"2026-10-17 00:20:13","image":"","code":"202610173898773781","title":"五年15条新线建成<em>投产 </em>国铁广州局加快推进路网建设","content":"记者16日从国铁广州局了解到，国铁广州局自2021年以来，紧扣交通强国战略，立足粤湘琼发展实际，把铁路建设作为稳投资、畅循环、促协同、惠民生的抓手，五年间推进24个项目开工、15条新线<em>投产</em>，深江、武梅等一批新线正加快建设。","mediaName":"中国新闻网","url":"http://finance.eastmoney.com/a/202610173898773781.html"},{"date":"2026-10-14 17:34:51","image":"","code":"202610143895554476","title":"现代汽车印度新工厂<em>投产</em>","content":"现代汽车10月14日公告称，印度浦那工厂正式<em>投产</em>，初始年产能为17万辆，计划到2030年提升至32万辆。随着新工厂落成，现代汽车目前在印度共运营三家生产厂，总年产能接近100万辆。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610143895554476.html"},{"date":"2026-10-16 21:25:29","image":"","code":"202610163898662421","title":"赣锋锂<em>业</em>重金砸向海外，大幅增持美元，非洲钾盐矿项目<em>投产</em>在即","content":"这个项目<em>投产</em>在即，所以今年对香港鲁源的担保额度就偏大一点。” 　　第三季度净利滑坡 　　由于锂盐产品涨价，赣锋锂业业绩大幅修复。前三季度，公司实现营业收入361.59亿元，同比增长147.24%，实现净利润50.12亿元，同比增长19,540.50%。","mediaName":"华夏时报网","url":"http://finance.eastmoney.com/a/202610163898662421.html"},{"date":"2026-10-16 08:20:36","image":"","code":"202610163897595821","title":"亚洲首条波音777-200LR客改货生<em>产</em>线在青岛<em>投产</em>","content":"据青岛日报，10月15日，美国猛犸货机公司在亚洲落地的首架待客改货飞机，抵达青岛胶东国际机场（简称胶东机场），标志着亚洲首条波音777-200LR，客改货改装生产线<em>投产</em>运营。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610163897595821.html"},{"date":"2026-10-16 14:47:52","image":"","code":"202610163898343257","title":"总<em>投</em>资超20亿元！中沙古雷乙烯项目关键配套工程建成<em>投产</em>","content":"待中沙古雷乙烯项目全面<em>投产</em>，该公司还将跃升为福建省最大热源点。(完)","mediaName":"中国新闻网","url":"http://finance.eastmoney.com/a/202610163898343257.html"},{"date":"2026-10-15 21:03:15","image":"","code":"202610153897155397","title":"恒生电子<em>投</em>资交易系统O45在安信基金全<em>业</em>务<em>投产</em>","content":"上证报中国证券网讯（记者王子霖）记者10月15日从恒生电子获悉，安信基金近日成功完成恒生电子投资交易系统O45的全业务<em>投产</em>，成为中国基金行业首家实现投资交易系统全栈信创全业务上线的公募机构。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610153897155397.html"},{"date":"2026-10-16 12:58:19","image":"","code":"202610163898250921","title":"全国抽蓄资源开发不足<em> </em>4%，“十五五”首个中小型项目<em>投产</em>","content":"后续将有序推进2号机组按期<em>投产</em>，确保项目全容量<em>投产</em>目标如期实现。","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202610163898250921.html"},{"date":"2026-10-16 15:58:01","image":"","code":"202610163898387142","title":"丰田将在华首试自有“一体化压铸”<em> </em>雷克萨斯上海工厂2027年<em>投产</em>","content":"丰田汽车计划在中国一座投资20亿美元的雷克萨斯工厂使用自有巨型压铸设备生产电动汽车。这是丰田扭转在华销量下滑、提升竞争力的最新举措之一。当被问及丰田是否从本地供应商采购巨型压铸机时，丰田首席技术官中岛裕树表示，公司正在“内部”开发该技术。这座位于上海的工厂正在建设中，预计2027年开始生产汽车","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610163898387142.html"},{"date":"2026-10-14 18:21:46","image":"","code":"202610143895751463","title":"广州一企<em>业</em>实现吉瓦时级全固态电池<em>产</em>线<em>投产</em>","content":"据<em>投产</em>企业广州巨湾技研有限公司董事长裴锋介绍，本次<em>投产</em>的电池单体，经过第三方机构国联汽车动力电池研究院国家动力电池创新中心检测试验中心检测，符合新国标关于全固态电池认定标准。","mediaName":"新华财经","url":"http://finance.eastmoney.com/a/202610143895751463.html"},{"date":"2026-10-14 12:19:16","image":"https://np-newspic.dfcfw.com/download/D25493853230254232861_w210h154.jpg","code":"202610143895259729","title":"核电概念逆势走强！今年已进入装机<em>投产</em>高峰(附股)","content":"核电方面，东吴证券指出，2026年起核电已进入装机<em>投产</em>高峰，《关于发展新质生产力的意见》提出有序发展先进核裂变能；展望明年电价修复＋装机<em>投产</em>，核电亦有望成为\"利与红利\"品种。","mediaName":"东方财富研究中心","url":"http://finance.eastmoney.com/a/202610143895259729.html"},{"date":"2026-10-14 23:46:45","image":"","code":"202610143895844448","title":"后摩智能信晓旭：首颗3D<em> </em>CIM芯片A20已<em>投产</em>","content":"在研及规划方面，首颗基于3D CIM架构的芯片 A20已<em>投产</em>，特点是具有高带宽、低延时，最多支持16芯全互联；M6X系列芯片正在研发中，为M50演进迭代版，综合能力可达M50的3—6倍；A30也正在规划，定位高算力、低功耗。 （科创板日报记者李佳怡）","mediaName":"科创板日报","url":"http://finance.eastmoney.com/a/202610143895844448.html"},{"date":"2026-10-14 19:06:00","image":"","code":"202610143895610173","title":"阿尔特：年<em>产</em>60万台电磁离合器模块<em>产</em>线<em>投产</em>","content":"人民财讯10月14日电，10月14日，阿尔特(300825)官微消息，近日，芜湖阿尔特动力科技有限公司正式开业，芜湖阿尔特由阿尔特与芜湖华安战新股权投资基金合伙企业（有限合伙）联合设立，专注于纯电动及混动动力总成系统研发与生产，核心聚焦电磁离合器模块的规模化制造。在产品与生产端，芜湖阿尔特产线在恒温无尘车间内采用自动化装配","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202610143895610173.html"},{"date":"2026-10-14 09:22:00","image":"","code":"202610143895009884","title":"北京利尔：正全力推进硅碳负极材料量<em>产产</em>线<em>投产</em>","content":"北京利尔(002392)10月14日在互动平台表示，公司正在全力推进硅碳负极材料量产产线<em>投产</em>工作，宜昌基地计划于年底前<em>投产</em>。当前硅碳负极材料下游应用渗透率提升明显，公司将努力把握市场机遇。","mediaName":"人民财讯","url":"http://finance.eastmoney.com/a/202610143895009884.html"},{"date":"2026-10-14 10:19:00","image":"","code":"202610143895195790","title":"行<em>业</em>首条吉瓦时级固态电池技改升级<em>产</em>线在广州<em>投产</em>","content":"巨湾技研创始人、首席技术官黄向东表示，过去，固态电池量产长期面临建厂资产重、<em>投产</em>周期长、制造成本高等三重约束。","mediaName":"21世纪经济报道","url":"http://finance.eastmoney.com/a/202610143895195790.html"},{"date":"2026-10-16 16:22:41","image":"","code":"202610163898671783","title":"恒生科技指数上涨1.16%，稀土永磁板块涨幅居前｜港股收评","content":"板块方面，稀土永磁板块涨幅居前，成分股中，都都控股上涨32.74%，金力永磁上涨3.06%，<em>江西铜业</em>股份上涨1.28%。 　　K12教育板块表现强势，成分股中，成实外教育上涨16.67%，光正教育上涨10.42%，新东方-S上涨5.9%。","mediaName":"21世纪经济报道","url":"http://finance.eastmoney.com/a/202610163898671783.html"},{"date":"2026-10-15 10:52:08","image":"","code":"202610153896616481","title":"聚灿光电：600万片银镜倒装芯片技改项目预计年底全面<em>投产</em>","content":"公司表示，公司“年产600万片银镜倒装芯片技改项目”采用分阶段<em>投产</em>、产能逐步爬坡的实施方式，预计2026年底实现全面<em>投产</em>。该项目产品主要用于电视背光、车规大灯、植物照明等领域。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610153896616481.html"},{"date":"2026-10-14 18:31:56","image":"https://np-newspic.dfcfw.com/download/D25434509826676053673_w210h154.jpg","code":"202610143895585065","title":"行<em>业</em>首条<em> </em>吉瓦时级全固态电池<em>产</em>线<em>投产 产业</em>化元年渐近","content":"行业首条吉瓦时级固态电池产线<em>投产</em> 　　日前，巨湾技研发布消息，广州巨湾技研有限公司10月13日在其广州南沙总部基地举行\"全固态电池量产升级竣工<em>投产</em>仪式\"。","mediaName":"数据宝","url":"http://finance.eastmoney.com/a/202610143895585065.html"},{"date":"2026-10-15 08:43:00","image":"","code":"202610153896163654","title":"聚灿光电：年<em>产</em>600万片银镜倒装芯片技改项目预计2026年底实现全面<em>投产</em>","content":"南财智讯10月15日电，聚灿光电在互动平台表示，公司“年产600万片银镜倒装芯片技改项目”采用分阶段<em>投产</em>、产能逐步爬坡的实施方式，预计2026年底实现全面<em>投产</em>，项目产品主要用于电视背光、车规大灯、植物照明等领域。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610153896163654.html"},{"date":"2026-10-13 22:29:00","image":"","code":"202610133895315374","title":"行<em>业</em>首条！吉瓦时级全固态电池<em>产</em>线广州<em>投产</em>","content":"固态电池量产长期面临重资产建厂、<em>投产</em>周期长、制造成本高三重约束。10月13日，广州巨湾技研在广州南沙总部基地举行仪式，宣布吉瓦时级全固态电池产线<em>投产</em>。","mediaName":"南方都市报","url":"http://finance.eastmoney.com/a/202610133895315374.html"},{"date":"2026-10-13 21:25:32","image":"","code":"202610133894421274","title":"巨湾技研吉瓦时级全固态电池<em>产</em>线正式<em>投产</em>","content":"据巨湾技研消息，10月13日，广州巨湾技研有限公司在其广州南沙总部基地举行“全固态电池量产升级竣工<em>投产</em>仪式”。据巨湾技研介绍，这是行业首条通过现有产线技改升级、用于生产符合固态电池国家标准分类（GB/T 48093.1-2026）产品的吉瓦时级固态电池产线。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610133894421274.html"},{"date":"2026-10-15 15:10:00","image":"https://np-newspic.dfcfw.com/download/D25287485173460475703_w210h154.jpg","code":"202610153896883426","title":"【风口研报】行<em>业</em>首条GWh固态<em>产</em>线<em>投产</em>!“十五五”政策持续加码<em>  产业</em>化关键节点有望到来","content":"10月13日，广州巨湾技研有限公司在其广州南沙总部基地举行“全固态电池量产升级竣工<em>投产</em>仪式”。据悉，这是行业首条通过现有产线技改升级、用于生产符合固态电池国家标准分类（GB/T 48093.1-2026）产品的吉瓦时级固态电池产线，标志着电池行业在固态电池规模化量产能力上的突破。","mediaName":"东方财富研究中心","url":"http://stock.eastmoney.com/a/202610153896883426.html"},{"date":"2026-10-14 12:41:25","image":"","code":"202610143895388848","title":"巨湾技研从极快充电池延伸至固态电池，吉瓦时级<em>产</em>线<em>投产</em>","content":"10月13日，广州巨湾技研在广州南沙总部基地举行全固态电池量产升级竣工<em>投产</em>仪式。据巨湾技研介绍，这是行业首条通过现有产线技改升级、用于生产符合固态电池国家标准分类（GB/T 48093.1-2026）产品的吉瓦时级固态电池产线。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610143895388848.html"},{"date":"2026-10-14 17:25:00","image":"","code":"202610143895546195","title":"华纬科技：公司德国基地已开始运营；墨<em>西</em>哥基地计划2028年实现<em>投产</em>","content":"南财智讯10月14日电，华纬科技在投资者关系活动中表示，公司德国基地已开始运营；墨西哥基地计划2028年实现<em>投产</em>；摩洛哥基地计划2027年年底实现<em>投产</em>。未来海外收入占比提升与否取决于未来订单和<em>投产</em>进度。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610143895546195.html"},{"date":"2026-10-13 18:32:53","image":"","code":"202610133894262481","title":"零跑携欧洲最全<em>产</em>品线登陆巴黎车展，<em>西</em>班牙工厂宣布<em>投产</em>","content":"10月12日，零跑汽车亮相巴黎国际车展，展出品牌迄今阵容最全的欧洲产品线，同时公司宣布B10车型在西班牙萨拉戈萨工厂正式<em>投产</em>，标志着其欧洲本地化制造战略迎来关键节点。","mediaName":"国际金融报","url":"http://finance.eastmoney.com/a/202610133894262481.html"},{"date":"2026-10-13 15:03:00","image":"","code":"202610133894113116","title":"精进电动：欧洲乘用车三合一项目预计明年下半年<em>投产</em>","content":"精进电动在10月13日召开的2026年半年度业绩说明会上表示，公司为北美新兴新能源车企定制开发的乘用车三合一系统项目，整体进度符合预期，2026年第四季度实现<em>投产</em>。欧洲乘用车三合一项目目前产品开发顺利，产线正在按计划进行建设，预计明年下半年<em>投产</em>。","mediaName":"人民财讯","url":"http://finance.eastmoney.com/a/202610133894113116.html"},{"date":"2026-10-15 13:51:10","image":"","code":"202610153896773345","title":"短期金价仍面临挑战，机构：走弱或是买入机会，低费率黄金ETF华夏（518850）震荡走低","content":"5.83%，<em>江西铜业</em>、豫光金铅、登云股份等股纷纷重挫。","mediaName":"21世纪经济报道","url":"http://stock.eastmoney.com/a/202610153896773345.html"},{"date":"2026-10-13 09:14:03","image":"","code":"202610133894472116","title":"高端环氧树脂装置<em>投产</em>，南方基金都逸敏关注化工新材料","content":"近日，国内某石化企业位于湖南岳阳的一套17万吨/年环氧树脂装置打通全流程，产出合格产品，实现一次开车成功。该装置于2024年6月开工建设，产品结构为15万吨/年液体环氧树脂与2万吨/年特种环氧树脂，其中高端特种牌号涵盖氢化双酚A环氧树脂等，面向电子覆铜板、高端复合材料与风电碳纤维复合材料环节","mediaName":"界面新闻","url":"http://fund.eastmoney.com/a/202610133894472116.html"},{"date":"2026-10-14 18:17:00","image":"","code":"202610143895596311","title":"PCB龙头，<em>业</em>绩大增！行<em>业</em>首条，吉瓦时级全固态电池<em>产</em>线<em>投产</em>，<em>产业</em>化元年渐近","content":"行业首条吉瓦时级固态电池产线<em>投产</em> 　　日前，巨湾技研发布消息，广州巨湾技研有限公司10月13日在其广州南沙总部基地举行\"全固态电池量产升级竣工<em>投产</em>仪式\"。","mediaName":"数据宝","url":"http://finance.eastmoney.com/a/202610143895596311.html"},{"date":"2026-10-14 19:44:54","image":"","code":"202610143895623013","title":"劲仔食品鱼制品<em>产</em>线已顺利<em>投产</em>，创新型豆制品相关<em>产</em>线已布局完成","content":"10月14日，劲仔食品在投资者互动平台表示，公司北海生产基地主要生产鱼制品，目前鱼制品产线已顺利<em>投产</em>，后续将根据市场需求逐步释放产能；平江周鲜鲜基地主要生产创新型豆制品，相关产线已布局完成，正快速响应市场需求。","mediaName":"北京商报","url":"http://finance.eastmoney.com/a/202610143895623013.html"},{"date":"2026-10-14 07:26:04","image":"","code":"202610143894611044","title":"港股分拆上市趋热","content":"受政策利好影响，今年以来，包括<em>江西铜业</em>、海信集团、金斯瑞生物科技、信义玻璃、复星国际等多家公司推进港股分拆上市，港股分拆上市热度明显升温。（中国证券报）","mediaName":"中国证券报","url":"http://finance.eastmoney.com/a/202610143894611044.html"},{"date":"2026-10-13 21:43:51","image":"","code":"202610133894417278","title":"储能电池需求快速增长，电机铁芯新<em>产</em>能<em>投产</em>，震裕科技前三季净利最高预增近7成","content":"亿元，比上年同期增长55.82%～68.38% 　　预告解释称，公司本期归属于上市公司股东的净利润和扣除非经常性损益后的净利润较上年同期增长的主要原因为：报告期内，公司经营计划有序开展，下游锂电池特别是储能电池市场需求持续快速增长带动主营业务销售收入持续增长，电机铁芯新建产能已逐步<em>投产</em>","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610133894417278.html"},{"date":"2026-10-10 23:29:06","image":"","code":"202610103892003363","title":"烟威1000千伏特高压工程竣工<em>投产</em>","content":"上证报中国证券网讯（记者林玉莲）据国网山东电力公司消息，10月10日，烟威1000千伏特高压交流输变电工程正式竣工<em>投产</em>。 　　该工程是全国“十五五”时期首个投运的特高压交流输变电新建工程、全国首个服务核电送出的特高压工程。工程线路全长1197公里。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610103892003363.html"},{"date":"2026-09-03 13:14:45","image":"","code":"202609033863915596","title":"<em>江西铜业</em>武山<em>铜</em>矿三期扩建项目正式<em>投产</em>","content":"9月1日，<em>江西铜业</em>武山铜矿三期扩建项目正式<em>投产</em>。据介绍，武山铜矿三期扩建工程设计日处理矿石能力达1万吨，设计服务年限24年。项目达产后，武山铜矿将成为江西省规模最大的井下铜矿山。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202609033863915596.html"},{"date":"2026-10-07 15:41:08","image":"","code":"202610073888887262","title":"<em>江西铜业</em>与控股股东重签关联交易合同，三年采购预计上限超520亿元","content":"9月30日晚间，<em>江西铜业</em>(600362)发布公告称，公司与控股股东<em>江西铜业</em>集团有限公司签署三项日常关联交易协议，有效期自2027年1月1日至2029年12月31日，涉及物料供应、产品销售及土地房屋租赁等多个领域。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610073888887262.html"},{"date":"2026-10-12 21:06:41","image":"","code":"202610123892899211","title":"微软计划2027年起将Azure<em> </em>Maia部署规模扩至多吉瓦级<em> </em>Maia<em> </em>300明年<em>投产</em>","content":"微软宣布，将从2027年起把Azure Maia系列AI芯片系统的部署规模扩大至多吉瓦级，并将其打造为微软产品和服务的主要推理系统。微软表示，Maia 200已投入生产环境，服务于Microsoft Copilot等工作负载；Maia 300计划于2027年开始部署，面向长上下文推理","mediaName":"科创板日报","url":"http://finance.eastmoney.com/a/202610123892899211.html"},{"date":"2026-10-12 21:03:06","image":"","code":"202610123892902356","title":"微软计划2027年起将Azure<em> </em>Maia部署规模扩至多吉瓦级<em> </em>Maia<em> </em>300明年<em>投产</em>","content":"微软宣布，将从2027年起把AzureMaia系列AI芯片系统的部署规模扩大至多吉瓦级，并将其打造为微软产品和服务的主要推理系统。微软表示，Maia200已投入生产环境，服务于MicrosoftCopilot等工作负载；Maia300计划于2027年开始部署，面向长上下文推理、低延迟对话及多步骤智能体任务","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610123892902356.html"},{"date":"2026-10-12 15:11:28","image":"","code":"202610123892641729","title":"港股异动<em> </em>|<em> </em>力量发展盘中涨超6%<em> </em>塞拉利昂金红石项目<em>投产</em>","content":"据悉，项目第一阶段共包含3条生产线，年底全部<em>投产</em>后，合计年处理原矿约600万吨，年产能约22万吨重矿砂，预计2026年年内产量约2.6万吨。 　　同时公布的第二阶段规划显示，在第一阶段稳定运营且资源量确认充足的前提下，力量发展将于12个月内新增2条生产线，达到5条生产线总数。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610123892641729.html"},{"date":"2026-10-13 10:58:43","image":"","code":"202610133893935548","title":"欧洲贸易添变量，三家造车新势力巴黎车展争市场！小鹏新车开卖、零跑当地<em>投产</em>、理想明年入场","content":"随着零跑工厂<em>投产</em>、小鹏扩大当地生产车型，中国造车新势力的入欧之路正进入深入制造和供应链环节。本地制造能够增加供货方式的选择，但能否缓解出口端压力，仍取决于当地制造成本、供应链效率，以及新增产能能否与订单增长相匹配等因素。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610133893935548.html"},{"date":"2026-10-11 14:19:00","image":"","code":"202610113892046095","title":"从签约到<em>投产</em>仅120天，猛士X700首台量<em>产</em>车襄阳下线","content":"猛士汽车襄阳工厂总装车间内，一台涂装完毕的猛士X700从灯光逐一点亮的下线通道缓缓驶出——这是东风新能源智能越野车项目首台下线的量产车，也标志着该项目正式<em>投产</em>。 　　据悉，新车将于10月底上市。","mediaName":"南方都市报","url":"http://finance.eastmoney.com/a/202610113892046095.html"},{"date":"2026-10-10 12:26:50","image":"","code":"202610103891882610","title":"这个欧洲电芯厂<em>投产</em>，再次见证中国“质”造","content":"亿纬锂能于2024年启动匈牙利电池工厂项目，规划年产能28GWh，总投资约99.71亿元，预计于2027年建成<em>投产</em>。该工厂为欧洲市场生产大圆柱电池，建成后预计创造超过1000个就业岗位。","mediaName":"上海证券报","url":"http://finance.eastmoney.com/a/202610103891882610.html"},{"date":"2026-10-19 06:59:30","image":"","code":"202610193899243148","title":"龙头再涨价<em> </em>覆<em>铜</em>板上市公司迎<em>业</em>绩释放期","content":"此后，建滔积层板在中期业绩报告中表示，清远8个特种电子玻璃纤维纱窑炉中2个将于下半年<em>投产</em>，全部<em>投产</em>后窑炉总数将增至13个；清远年产2.1万吨铜箔项目将于2027年第三季度<em>投产</em>；江西萍乡月产110万张覆铜板工厂第一期将于2027年年中<em>投产</em>。","mediaName":"中国证券报","url":"http://finance.eastmoney.com/a/202610193899243148.html"},{"date":"2026-10-10 17:30:21","image":"","code":"202610103891938980","title":"烟威1000千伏特高压交流输变电工程竣工<em>投产</em>","content":"新华财经济南10月10日电（记者贾云鹏）记者从国网山东省电力公司获悉，烟威1000千伏特高压交流输变电工程10日正式竣工<em>投产</em>，这是“十五五”时期全国首个投运的特高压交流输变电新建工程，也是服务山东烟威地区清洁能源外送的关键通道。","mediaName":"新华财经","url":"http://finance.eastmoney.com/a/202610103891938980.html"},{"date":"2026-10-11 11:14:31","image":"","code":"202610113892032585","title":"永杉锂<em>业</em>上半年研发<em>投</em>入大增近2倍，长沙基地三期项目预计年底前<em>投产</em>","content":"公司表示，长沙基地三期年产2.2万吨锂盐项目目前按计划推进中，预计将在年底前实现试<em>投产</em>。 　　来源：读创财经","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610113892032585.html"},{"date":"2026-10-08 15:57:51","image":"","code":"202610083889636112","title":"湖北宜化：无水氟化氢一期项目<em>投产</em>","content":"湖北宜化(000422.SZ)公告称，公司控股子公司宜化氟化工建设的2×3万吨/年无水氟化氢项目一期已建成一套年产3万吨无水氟化氢装置，经审核后安全顺利<em>投产</em>。该项目将磷化工副产品氟硅酸转化为高附加值无水氟化氢，优化磷氟产品结构，提升公司竞争力。二期将根据市场需求择机实施。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610083889636112.html"},{"date":"2026-10-18 11:28:53","image":"","code":"202610183899112792","title":"上海超导3公里单根长带<em>产</em>线<em> </em>计划于2027年<em>产</em>出<em>产</em>品","content":"此外，三期基地将<em>投产</em>全球首创的3公里单根长带产线，计划于2027年一季度产出产品。(第一财经记者金叶子)","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202610183899112792.html"},{"date":"2026-10-12 10:47:45","image":"","code":"202610123892495626","title":"中盐化工<em>业</em>绩会：氯碱公司尚无独立融资或分拆规划，新天然碱矿项目拟两年内建成<em>投产</em>","content":"在业绩说明会上，有投资者提问：天然碱项目的建设进度和<em>投产</em>预期是怎样的？项目公司引入战投后，后续融资安排如何规划？氯碱子公司盈利稳健，是否有独立融资或分拆的考虑？ 　　该公司回答：公司年产500万吨天然碱矿资源综合开发项目正以“两年<em>投产</em>、三年达产”为目标推进中。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610123892495626.html"},{"date":"2026-10-10 15:39:01","image":"","code":"202610103891917614","title":"“绿电高速公路”要来了！烟威1000千伏特高压工程竣工<em>投产</em>","content":"记者从国家电网了解到，今天，山东胶东半岛清洁能源送出的关键通道，烟威1000千伏特高压工程正式竣工<em>投产</em>，这也是我国“十五五”时期投运的首个特高压交流输变电工程。 　　烟威特高压工程线路全长1197公里，途经烟台、青岛、日照、潍坊、临沂5市。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610103891917614.html"},{"date":"2026-10-10 20:16:22","image":"","code":"202610103891967660","title":"东风新能源智能越野车项目<em>投产</em>，猛士X700首台量<em>产</em>车10月底上市","content":"项目<em>投产</em>同样带动地方汽车产业链发展。猛士X700整车省内零部件采购占比达到61%，可带动襄阳供应链年产值超45亿元，吸引24家新能源配套企业落户本地，推动湖北汽车产业向新能源、智能化方向升级。","mediaName":"广州日报新花城","url":"http://finance.eastmoney.com/a/202610103891967660.html"},{"date":"2026-10-18 21:53:18","image":"","code":"202610183899184746","title":"加码高端材料赛道<em> </em>首钢股份增持首钢智新股权<em> </em>高性能取向电磁材料项目加速建设","content":"项目预计2028年建成<em>投产</em>，将助力国内输变电行业节能降损技术迭代升级，进一步服务国家能效提升产业发展大局。同时，项目<em>投产</em>也将巩固首钢在全球电工钢领域的技术引领地位，增强公司经营韧性与长期投资价值。","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202610183899184746.html"},{"date":"2026-10-16 15:31:11","image":"","code":"202610163898373555","title":"中广核团风魏家冲抽水蓄能电站首台机组<em>投</em>运","content":"后续，将有序推进2号机组按期<em>投产</em>，确保项目全容量<em>投产</em>目标如期实现，助力湖北打造长江中游大型清洁能源基地、全国重要电力调蓄中心，为国家绿色电力高质量发展贡献力量。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610163898373555.html"},{"date":"2026-10-16 18:35:55","image":"","code":"202610163898506717","title":"中广核团风魏家冲抽水蓄能电站首台机组<em>投</em>入商运","content":"本次<em>投产</em>的是1号机组，2号机组正处于调试阶段，计划年内实现<em>投产</em>。 　　“团风魏家冲抽水蓄能电站于2023年8月1日实现主体工程正式开工。","mediaName":"新华财经","url":"http://finance.eastmoney.com/a/202610163898506717.html"},{"date":"2026-10-18 14:47:24","image":"","code":"202610183899201418","title":"超导带材将迈向大规模工<em>业</em>化量<em>产</em>，上海超导三期基地项目封顶","content":"上海超导总部基地 　　新基地<em>投产</em>后，上海超导将迈入规模化工业制造新阶段。值得关注的是，三期基地将<em>投产</em>全球首创的3公里单根长带产线，计划2027年一季度产出产品。","mediaName":"上观新闻","url":"http://finance.eastmoney.com/a/202610183899201418.html"},{"date":"2026-10-12 16:40:16","image":"","code":"202610123892717332","title":"蓝筹价值观察：从沪市有色行<em>业</em>看资本市场韧性根基","content":"资源为基：“真金白银”夯实资产安全垫 　　矿产资源具有不可再生性，优质矿山从勘探发现到开发<em>投产</em>往往需要经历较长周期。随着全球矿业开发难度上升、资源获取成本提高，已经形成规模化产能的优质资源资产，其稀缺性和重置价值进一步凸显。","mediaName":"央广财经","url":"http://finance.eastmoney.com/a/202610123892717332.html"},{"date":"2026-10-17 15:01:20","image":"","code":"202610173899070724","title":"吉林前三季度新能源发电量占比近四成<em> </em>绿电变燃料出海","content":"在洮南市，上海电气集团已建成绿色甲醇工厂；松原市、大安市等地的绿色氢氨醇项目已<em>投产</em>并实现产品出口。近日，松原市生产的1000吨绿氨成功为比利时船舶提供燃料，相关加注作业在浙江舟山完成。(完)","mediaName":"中国新闻网","url":"http://finance.eastmoney.com/a/202610173899070724.html"},{"date":"2026-10-09 20:04:47","image":"","code":"202610093891423933","title":"格芯推出面向物理AI的FDX<em> </em>Fusion<em> </em>FD-SOI平台<em> </em>计划2028年在德国德累斯顿<em>投产</em>","content":"格芯（GlobalFoundries）推出面向物理AI的FDX Fusion FD-SOI平台，计划于2028年在德国德累斯顿启动该平台的生产。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610093891423933.html"},{"date":"2026-10-18 22:00:47","image":"","code":"202610183899188264","title":"中银理财董事长黄党贵：银行理财机构应主动求变<em> </em>把AI技术红利切实转化为生<em>产</em>力","content":"目前，中银理财已搭建30余个大模型应用、<em>投产</em>32个自动化流程，数智赋能的价值正在加速释放。 　　黄党贵认为，银行理财公司应在守好安全底线的前提下积极拥抱AI时代。","mediaName":"上海证券报·中国证券网","url":"http://bank.eastmoney.com/a/202610183899188264.html"},{"date":"2026-10-08 16:16:12","image":"","code":"202610083889649583","title":"湖北宜化：2×3万吨/年无水氟化氢一期项目<em>投产</em>","content":"截至公告披露日，该项目一期已建成一套年产3万吨无水氟化氢装置，经相关主管部门审核后，已安全顺利<em>投产</em>。","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202610083889649583.html"},{"date":"2026-10-12 20:54:16","image":"","code":"202610123892933961","title":"沪市主板有色龙头夯实“硬家底”，盈利与现金流韧性显现","content":"<em>江西铜业</em>则体现出传统资源龙头较强的经营弹性。","mediaName":"大河财立方","url":"http://finance.eastmoney.com/a/202610123892933961.html"},{"date":"2026-10-12 19:39:20","image":"","code":"202610123892854641","title":"从周期资源迈向战略资源<em> </em>沪市有色行<em>业</em>长期价值凸显","content":"<em>江西铜业</em>(600362.SH)、紫金矿业、洛阳钼业等沪市主板龙头拥有从资源端到冶炼加工端的深厚积累，在全球铜资源战略价值提升背景下，其优质矿产资源和成熟产能具有较高进入壁垒。 　　铝产业的应用边界同样不断拓宽。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610123892854641.html"},{"date":"2026-10-18 16:28:48","image":"","code":"202610183899146059","title":"申昊科技：全资子公司签订约8.81亿元算力设备采购合同","content":"公告提示，受供应链波动、行业供需格局快速变化及海外技术出口管制等多重因素影响，本次算力设备采购事项存在设备分批交付、供货价格调整、实际交付数量少于约定且供方无需承担违约责任等风险，进而可能导致公司相关业务<em>投产</em>进度晚于预期。 　　本文由AI生成，不构成投资建议。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899146059.html"},{"date":"2026-10-17 13:08:13","image":"","code":"202610173899030964","title":"资源布局持续深化<em> </em>金徽股份前三季度净利润增超八成","content":"金徽股份表示，江洛矿区核心工程谢家沟150万吨/年新建浮选厂已于2026年8月24日顺利完成带料试车，试车效果良好、<em>投产</em>条件成熟。作为江洛矿区300万吨/年选矿工程的重要组成部分，<em>投产</em>后将显著提升公司矿石处理能力与资源综合利用率。","mediaName":"经济参考网","url":"http://finance.eastmoney.com/a/202610173899030964.html"},{"date":"2026-10-18 14:52:00","image":"https://np-newspic.dfcfw.com/download/D25718666203922140769_w210h154.jpg","code":"202610183899131692","title":"下半年<em> </em>这些A股公司拿下算力大单","content":"布局不止于已<em>投产</em>项目。奥瑞德近期拟定增募资不超过8.68亿元，拟投入的项目之一就是西部国产服务器集群建设项目，在乌兰察布租赁机房、购置国产服务器及配套设备，依托当地规模化算力优势与毗邻京津冀的区位条件，提供基于国产硬件平台的大模型训练与推理服务。","mediaName":"上海证券报","url":"http://finance.eastmoney.com/a/202610183899131692.html"},{"date":"2026-10-18 20:54:09","image":"","code":"202610183899173179","title":"氟化工：配额锁死供给、价格站上历史高位<em> </em>这轮“特许经营”周期还能走多久？","content":"29.99万吨配额占全国约37.6%居首；龙头凭借\"萤石—氢氟酸—制冷剂\"一体化配套，成本比同行低10%–15%，在价格上行周期中毛利弹性最大；此外，第二曲线（高端国产替代），高端含氟新材料（半导体级PFA、电子级氢氟酸、氟化液）长期被海外垄断，巨化1万吨高纯PFA装置已于2026年5月<em>投产</em>","mediaName":"东方财富AI妙想","url":"http://finance.eastmoney.com/a/202610183899173179.html"},{"date":"2026-10-09 09:11:44","image":"","code":"202610093890520735","title":"电子级过氧化氢项目<em>投产</em>，南方基金都逸敏关注化工新材料领域","content":"近日，湖北当阳一处化工园区的电子级过氧化氢项目实现一次开车成功、顺利<em>投产</em>。","mediaName":"界面新闻","url":"http://fund.eastmoney.com/a/202610093890520735.html"},{"date":"2026-10-12 22:32:15","image":"","code":"202610123892975134","title":"资源禀赋构筑供给壁垒<em> </em>新兴<em>产业</em>打开长期需求<em> </em>沪市有色龙头“家底”有多厚？","content":"<em>江西铜业</em>（SH600362，股价41.29元，市值1430亿元）则体现出传统资源龙头较强的经营弹性。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610123892975134.html"},{"date":"2026-10-16 13:32:20","image":"","code":"202610163898272822","title":"中科海钠与武汉市<em>江</em>夏区签约建设10GWh钠离子电池生<em>产</em>线项目<em> </em>计划明年初启动建设","content":"中科海钠总经理李树军介绍，项目计划明年初启动建设，年内实现<em>投产</em>。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610163898272822.html"},{"date":"2026-10-16 08:44:00","image":"","code":"202610163897606110","title":"双象股份：年<em>产</em>35万吨特种材料项目已取得环评批复","content":"项目位于重庆市长寿经济技术开发区（国家级），公司在该园区已先后建成<em>投产</em>重庆超纤和重庆光学两大项目，具备成熟的项目建设和运营经验。项目建成后将进一步丰富公司高性能材料产品矩阵，成为公司新的增长极。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610163897606110.html"},{"date":"2026-10-12 17:25:20","image":"","code":"202610123892761011","title":"资源硬、造血强<em> </em>沪市有色龙头夯实资本市场发展韧性根基","content":"<em>江西铜业</em>则体现出传统资源龙头较强的经营弹性。2026年上半年，公司实现营业收入3071.55亿元，同比增长19.53%；归母净利润86.32亿元，同比增长106.77%；经营活动产生的现金流量净额58.14亿元，同比增长102.49%。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610123892761011.html"},{"date":"2026-10-16 13:29:00","image":"","code":"202610163898756987","title":"中科海钠与武汉市<em>江</em>夏区签约建设10GWh钠离子电池生<em>产</em>线项目","content":"中科海钠总经理李树军介绍，项目计划明年初启动建设，年内实现<em>投产</em>。","mediaName":"人民财讯","url":"http://finance.eastmoney.com/a/202610163898756987.html"},{"date":"2026-10-16 13:21:13","image":"","code":"202610163898262965","title":"中科海钠武汉<em>江</em>夏区10GWh钠离子电池生<em>产</em>线落地签约","content":"中科海钠总经理李树军介绍，项目计划明年初启动建设，年内实现<em>投产</em>。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610163898262965.html"},{"date":"2026-10-16 21:15:00","image":"","code":"202610163898650185","title":"金徽股份前三季度净利润同比增长86.86%<em> </em>资源勘查获重大突破","content":"两处金矿黄金储量规模可观，属于优质核心增量资产，预计今年底可逐步<em>投产</em>释放产能。","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610163898650185.html"},{"date":"2026-10-15 08:27:53","image":"https://np-newspic.dfcfw.com/download/D25349823777026358936_w210h154.jpg","code":"202610153896138096","title":"中信证券：电价周期拐点来临<em> </em>核电重拾弹性","content":"沿海市场电价重回上行周期有望带动核电公司业绩迎来修复拐点，新机组<em>投产</em>高峰下核电资产的成长价值将持续兑现，行业的盈利与估值底部已较为清晰。","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202610153896138096.html"},{"date":"2026-10-08 12:15:00","image":"","code":"202610083889431965","title":"叮咚买菜：旗下有豆志将合作种植5万亩大豆<em> </em>宁波自营工厂已<em>投产</em>","content":"9月底，叮咚买菜在宁波投建的豆制品工厂正式<em>投产</em>。该工厂占地8000平方米，规划6条产线，日产能达12万盒，这也是有豆志自创立以来在供应链上游最大规模的布局。","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202610083889431965.html"},{"date":"2026-10-08 20:12:00","image":"","code":"202610083889931030","title":"今年前9月广<em>西</em>电网<em>投产</em>72项主网、6200余项配网工程","content":"已<em>投产</em>项目持续释放效能的同时，广西多个在建重点电网工程施工现场热火朝天。 　　近日，在500千伏龙潭输变电工程现场，百余名建设者开展GIS设备安装、继电保护调试，以及导地线展放、挂线、紧线等作业。","mediaName":"中国新闻网","url":"http://finance.eastmoney.com/a/202610083889931030.html"},{"date":"2026-10-16 19:20:16","image":"","code":"202610163898532296","title":"受益于全球AI算力基建扩容，腾景科技第三季度净利同比预增超六成","content":"工厂进展方面，目前合肥工厂钒酸钇晶体项目已完成一期和二期扩产，产线满负荷生产；泰国工厂已完成建设并持续推进<em>投产</em>工作；郑州工厂按计划推进项目建设，部分产线已逐步投入使用，进入量产起步阶段。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610163898532296.html"},{"date":"2026-10-16 18:09:00","image":"","code":"202610163898499732","title":"金徽股份：前三季度扣非净利润增超95%<em> </em>资源勘查获重大突破","content":"作为江洛矿区300万吨/年选矿工程的重要组成部分，<em>投产</em>后有望显著提升矿石处理能力与资源综合利用率。后续公司还将根据整体产能规划，择机推进明昊150万吨/年浮选厂的扩建及技术升级改造。","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202610163898499732.html"},{"date":"2026-10-15 19:03:00","image":"","code":"202610153897075446","title":"联合光电：车载镜头<em>业</em>务已进入规模化放量阶段，正全力推进<em>产</em>能扩建与量<em>产</em>交付","content":"目前车载镜头业务已进入规模化放量阶段，公司正全力推进产能扩建与量产交付，今年上半年泰国工厂的车载产品正式<em>投产</em>，海外项目增长较快。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610153897075446.html"},{"date":"2026-10-15 09:03:11","image":"","code":"202610153896275749","title":"中信证券：核电公司<em>业</em>绩将进入新一轮释放周期","content":"中信证券研报认为，核电即将走出2024—2026年的电价下行周期，核电在建机组<em>投产</em>周期启动，量价齐升助力核电公司业绩进入新一轮释放周期。当前市场尚未完全计入电价上涨对核电公司的业绩催化，板块估值仍具备较强安全边际。","mediaName":"中国证券报·中证金牛座","url":"http://stock.eastmoney.com/a/202610153896275749.html"},{"date":"2026-10-18 22:39:27","image":"","code":"202610183899203356","title":"活力中国调研行丨潮起自贸港，海南启“芯”程","content":"随着海南航芯的竣工<em>投产</em>，海南电子信息制造业空白开始被填补，企业规模化生产两年，年产值已突破亿元——2025年芯片产值1.12亿元，2026年前5个月达0.55亿元。","mediaName":"大河财立方","url":"http://finance.eastmoney.com/a/202610183899203356.html"},{"date":"2026-10-19 07:03:51","image":"","code":"202610193899243335","title":"10月以来五家北交所公司获机构调研<em> </em>订单交付与<em>业</em>务拓展受关注","content":"该客户布局锂电相关产能，有望带来碳化硅匣钵、坩埚等产品的潜在需求，但受项目<em>投产</em>进度、产品导入验证、采购份额等影响，尚无法量化预估对未来业绩的影响。 　　运输端的布局同样围绕客户需求展开。","mediaName":"中国证券报","url":"http://finance.eastmoney.com/a/202610193899243335.html"},{"date":"2026-10-16 15:44:51","image":"","code":"202610163898379817","title":"特斯拉“飞”起来了！","content":"据报道，新车计划于2028年<em>投产</em>。 　　特斯拉美国官网预订页面显示，Performance版本预订款合计为5万美元；配备加速推进器的Thrust版本预订款合计为25万美元。单座Rocket版本配备官方所称的“全飞行系统”，仅面向受邀用户。","mediaName":"央视财经","url":"http://finance.eastmoney.com/a/202610163898379817.html"},{"date":"2026-10-16 13:06:30","image":"","code":"202610163898770147","title":"特斯拉新版Roadster跑车亮相","content":"据报道，新车计划于2028年<em>投产</em>。特斯拉美国官网预订页面显示，Performance版本预订款合计为5万美元；配备加速推进器的Thrust版本预订款合计为25万美元。单座Rocket版本配备官方所称的“全飞行系统”，仅面向受邀用户。","mediaName":"央视财经","url":"http://finance.eastmoney.com/a/202610163898770147.html"},{"date":"2026-10-16 13:03:22","image":"","code":"202610163898257454","title":"特斯拉跑车单座Rocket版本配备“全飞行系统”，仅面向受邀用户","content":"据报道，新车计划于2028年<em>投产</em>。特斯拉美国官网预订页面显示，Performance版本预订款合计为5万美元；配备加速推进器的Thrust版本预订款合计为25万美元。单座Rocket版本配备官方所称的“全飞行系统”，仅面向受邀用户。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610163898257454.html"},{"date":"2026-10-16 12:57:10","image":"","code":"202610163898234181","title":"特斯拉跑车时速可达370公里","content":"据报道，新车计划于2028年<em>投产</em>。特斯拉美国官网预订页面显示，Performance版本预订款合计为5万美元；配备加速推进器的Thrust版本预订款合计为25万美元。单座Rocket版本配备官方所称的“全飞行系统”，仅面向受邀用户。","mediaName":"央视财经","url":"http://finance.eastmoney.com/a/202610163898234181.html"},{"date":"2026-10-16 16:30:40","image":"","code":"202610163898413544","title":"我国首个百万吨级低浓度CCUS全链条示范工程开工","content":"记者了解到，此前中国石化已经在胜利油田<em>投产</em>了我国首个百万吨级CCUS项目——“齐鲁石化—胜利油田百万吨级CCUS项目”。该项目主要捕集煤制氢装置排放的高浓度尾气，二氧化碳含量在90%左右，于2021年7月开工建设。","mediaName":"21世纪经济报道","url":"http://finance.eastmoney.com/a/202610163898413544.html"},{"date":"2026-10-15 21:46:00","image":"","code":"202610153897211833","title":"光智科技：关于子公司项目预中标公示的提示性公告","content":"根据中国招标投标公共服务平台2026年10月15日发布的项目中标候选人公示，安徽光智为该项目第一中标候选人，投标报价为人民币111,449.12万元，该项目将于2026年12月30日前交付并开始<em>投产</em>。若后续签订正式合同并顺利实施，将对公司的经营业绩产生积极影响。","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610153897211833.html"},{"date":"2026-10-16 09:59:55","image":"","code":"202610163898028533","title":"华晨宝马第六代动力电池在沈阳下线<em> </em>项目<em>投</em>资达100亿元","content":"第六代动力电池正式量产，标志着宝马新世代车型已完成从核心技术研发到本土生产体系的全面准备，为产品的陆续<em>投产</em>与上市奠定坚实基础。 　　多年来，宝马深耕中国、持续投入创新。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610163898028533.html"},{"date":"2026-10-15 16:47:00","image":"","code":"202610153896968785","title":"广汽因湃电池第30万套电池包下线","content":"2011年，广汽集团开始电池系统及BMS的研发工作；2015年，广汽首款自主设计的PHEV电池包搭载于GS4 PHEV <em>投产</em>；2017年，广汽埃安首款自主开发EV电池包<em>投产</em>，同年启动动力电池电芯的自主研发和电芯试验线建设；2021年开始陆续发布弹匣电池系统安全技术、海绵硅负极片电池","mediaName":"南方都市报","url":"http://finance.eastmoney.com/a/202610153896968785.html"},{"date":"2026-10-17 18:21:57","image":"https://np-newspic.dfcfw.com/download/D24854661704939871673_w210h154.jpg","code":"202610173899054283","title":"下周2只新股开启申购！超千亿解禁潮将至<em> </em>6股解禁比例均超50%（附股）","content":"公司羟胺水溶液500t/a中试装置于2024年12月建成<em>投产</em>，至今主要处于送样与客户验厂以及小批量供应下游客户使用，2025年营收占比为1.42%。","mediaName":"数据宝","url":"http://finance.eastmoney.com/a/202610173899054283.html"},{"date":"2026-10-15 18:48:00","image":"","code":"202610153897051280","title":"深赛格：子公司拟8000万元<em>投</em>建罗山实验基地，强化半导体检测能力","content":"项目建设周期为15个月，计划于2027年12月正式<em>投产</em>。该项目的实施将有助于提升深赛格在半导体领域的检测能力，增强市场竞争力。 　　2026年中期，深赛格实现收入7.04亿元，归母净利润5229万元。","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610153897051280.html"},{"date":"2026-10-15 18:20:00","image":"","code":"202610153897033624","title":"行云科技：公司计划2026年10月底前将第二总部落地迁入萧山经开区","content":"算力产业链方面，落地AI服务器整机智造基地，项目预计2027年<em>投产</em>。供应链与资金保障维度，同时段供应链合作额度由20亿元提升至30亿元，单年度累计合作额度由30亿元提升至150亿元。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610153897033624.html"},{"date":"2026-10-16 07:29:33","image":"","code":"202610163897335345","title":"赣锋锂<em>业</em>前三季度净利润同比大增195倍","content":"邦巴利锂矿项目正在建设中，规划采选规模200万吨/年，露天开采，预计2027年<em>投产</em>并开始产能爬坡。 　　锂电池方面，赣锋锂业继续推进储能电池的产能扩张和产品迭代。","mediaName":"证券时报","url":"http://finance.eastmoney.com/a/202610163897335345.html"},{"date":"2026-10-15 20:47:20","image":"","code":"202610153897135566","title":"瑞芯微：前三季度净利润预增68%到73%","content":"新一代协处理器将在年内发布，下一代重磅芯片RK3668 马上<em>投产</em>，RK3688随后出品，公司端侧 AI 的主控+协处理器的双轨制芯片矩阵成型，迎接端侧AI，尤其是端侧AI大模型产品放量爆发，提高公司在端侧AI的全球竞争力。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610153897135566.html"},{"date":"2026-10-17 17:00:35","image":"","code":"202610173899049053","title":"林洋能源中期分红落地<em> </em>储能<em>业</em>务“多点开花”","content":"蚌埠五河基地<em>投产</em>完善储能智造布局 　　在制造端，林洋能源同步补强储能装备自制产能。2026年4月成立的蚌埠林超储能科技有限公司，聚焦锂离子储能系统研发、制造与销售，面向电网侧、工商业等场景提供储能PACK及储能柜整体解决方案。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610173899049053.html"}]},"searchId":"6e737ebc-563c-4010-87d6-1d31ac31117e"})