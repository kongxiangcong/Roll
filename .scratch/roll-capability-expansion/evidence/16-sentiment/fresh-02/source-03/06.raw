rollSentimentCorpus03({"bizCode":"","bizMsg":"","code":0,"extra":{},"hitsTotal":5088,"msg":"OK","result":{"cmsArticleWebOld":[{"date":"2026-10-15 19:52:00","image":"","code":"202610153897110543","title":"美迪<em>西</em>：关于2026年第一次临时股东会通知的<em>更正</em>公告","content":"证券日报网讯10月15日，美迪西发布公告称，公司将2026年第一次临时股东会的召开时间<em>更正</em>为2026年10月30日，除了上述<em>更正</em>事项外，公司于2026年10月15日公告的原股东会通知中的其他事项不变。","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610153897110543.html"},{"date":"2026-10-13 21:00:00","image":"","code":"202610133894375139","title":"湖北广电：关于公司董事辞职公告的<em>更正</em>公告","content":"经公司审慎核查，原公告中关于刘志聪先生辞职报告生效时间表述需予以<em>更正</em>，现将<em>更正</em>情况公告如下：根据《中华人民共和国公司法》及《公司章程》的有关规定，刘志聪先生的辞职不会导致公司董事会成员低于法定人数，但会导致审计委员会成员不足三人，其辞职报告自公司董事会增补新任审计委员会委员时生效。","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610133894375139.html"},{"date":"2026-10-16 16:22:41","image":"","code":"202610163898671783","title":"恒生科技指数上涨1.16%，稀土永磁板块涨幅居前｜港股收评","content":"板块方面，稀土永磁板块涨幅居前，成分股中，都都控股上涨32.74%，金力永磁上涨3.06%，<em>江西铜业</em>股份上涨1.28%。 　　K12教育板块表现强势，成分股中，成实外教育上涨16.67%，光正教育上涨10.42%，新东方-S上涨5.9%。","mediaName":"21世纪经济报道","url":"http://finance.eastmoney.com/a/202610163898671783.html"},{"date":"2026-10-15 13:51:10","image":"","code":"202610153896773345","title":"短期金价仍面临挑战，机构：走弱或是买入机会，低费率黄金ETF华夏（518850）震荡走低","content":"5.83%，<em>江西铜业</em>、豫光金铅、登云股份等股纷纷重挫。","mediaName":"21世纪经济报道","url":"http://stock.eastmoney.com/a/202610153896773345.html"},{"date":"2026-10-14 17:21:00","image":"","code":"202610143895552197","title":"投资粤芯浮盈超50亿却闹“乌龙”，智光电气发<em>更正</em>公告致歉","content":"智光电气在<em>更正</em>公告中表示，对上述<em>更正</em>给广大投资者带来的不便深表歉意。 　　根据<em>更正</em>公告，智光电气持有誉芯众诚30%的合伙份额，持有吉富新芯33.33%的合伙份额；其中誉芯众诚共计持有粤芯半导体约3.99亿股，吉富新芯共计持有5000万股。","mediaName":"南方都市报","url":"http://finance.eastmoney.com/a/202610143895552197.html"},{"date":"2026-10-13 20:29:49","image":"","code":"202610133894342788","title":"智光电气：<em>更正</em>参股公司粤芯半导体持股数据","content":"因工作人员疏忽，此前公告中吉富新芯持股数据有误，现<em>更正</em>为：誉芯众诚持有粤芯半导体399,333,333股，吉富新芯持有50,000,000股，两股东所持股份自上市起36个月内不得转让。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610133894342788.html"},{"date":"2026-10-18 20:46:00","image":"","code":"202610183899175510","title":"冰山冷热：股票交易异常波动公告","content":"公司目前没有任何根据深圳证券交易所《股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉公司有根据深圳证券交易所《股票上市规则》等有关规定应予以披露而未披露的、对公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610183899175510.html"},{"date":"2026-10-18 15:56:06","image":"","code":"202610183899139131","title":"冰山冷热：股票交易异常波动<em> </em>无应披露未披露重大事项","content":"经公司核实，前期披露的信息不存在需要<em>更正</em>、补充之处；近期公共传媒未报道可能或已经对公司股票交易价格产生较大影响的未公开重大信息；近期公司经营情况及内外部经营环境未发生重大变化；公司及控股股东不存在关于公司的应披露而未披露的重大事项；股票异常波动期间，控股股东未买卖公司股票。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610183899139131.html"},{"date":"2026-10-14 07:26:04","image":"","code":"202610143894611044","title":"港股分拆上市趋热","content":"受政策利好影响，今年以来，包括<em>江西铜业</em>、海信集团、金斯瑞生物科技、信义玻璃、复星国际等多家公司推进港股分拆上市，港股分拆上市热度明显升温。（中国证券报）","mediaName":"中国证券报","url":"http://finance.eastmoney.com/a/202610143894611044.html"},{"date":"2026-10-18 20:46:00","image":"","code":"202610183899175295","title":"吉大<em>正</em>元：关于公司股票交易异常波动的公告","content":"公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的、对公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610183899175295.html"},{"date":"2026-10-13 18:27:35","image":"","code":"202610133894258096","title":"工作人员“闹乌龙”致信披出错！粤芯半导体上市当日，智光电气紧急<em>更正</em>公告：修<em>正</em>吉富新芯参股数量数据，从537.63万股<em>更正</em>至5000万股","content":"公告表示，公司对上述<em>更正</em>给广大投资者带来的不便深表歉意。 　　二级市场上，10月13日，粤芯半导体在深交所创业板挂牌上市，证券代码301660，发行价12.01元/股。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610133894258096.html"},{"date":"2026-10-13 20:59:48","image":"","code":"202610133894384585","title":"智光电气发布<em>更正</em>公告<em> </em>修<em>正</em>参股公司粤芯半导体持股数据","content":"因工作人员疏忽，此前公告中吉富新芯持股数据有误，现<em>更正</em>为：誉芯众诚持有粤芯半导体399,333,333股，吉富新芯持有50,000,000股，两股东所持股份自上市起36个月内不得转让。","mediaName":"央广财经","url":"http://finance.eastmoney.com/a/202610133894384585.html"},{"date":"2026-10-07 15:41:08","image":"","code":"202610073888887262","title":"<em>江西铜业</em>与控股股东重签关联交易合同，三年采购预计上限超520亿元","content":"9月30日晚间，<em>江西铜业</em>(600362)发布公告称，公司与控股股东<em>江西铜业</em>集团有限公司签署三项日常关联交易协议，有效期自2027年1月1日至2029年12月31日，涉及物料供应、产品销售及土地房屋租赁等多个领域。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610073888887262.html"},{"date":"2026-10-18 17:27:13","image":"","code":"202610183899154685","title":"两家A股公司，明天停牌，后天摘帽！","content":"今年4月21日，ST绝味召开会议，审议通过了《关于前期会计差错<em>更正</em>及追溯调整的议案》，对2017年至2021年年度报告及2022年至2025年半年度报告的相关数据进行会计差错<em>更正</em>及追溯调整。 　　截至目前，公司收到《行政处罚决定书》已满12个月。","mediaName":"证券时报","url":"http://finance.eastmoney.com/a/202610183899154685.html"},{"date":"2026-10-15 19:34:42","image":"","code":"202610153897097164","title":"帅特龙拟IPO<em> </em>曾大幅调整多家主要外协供应商采购金额","content":"在前期会计差错<em>更正</em>公告中，帅特龙对2023年、2024年前五名外协供应商采购、前五名供应商采购、前五名客户销售等披露数据进行<em>更正</em>，其中前五名外协供应商采购数据<em>更正</em>幅度较大。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610153897097164.html"},{"date":"2026-10-16 18:10:00","image":"","code":"202610163898495340","title":"赛格导航及董事长张家同等被警示：2024年净利从123万调减为-1238万","content":"经查，2026年4月，公司对前期财务报告进行会计差错<em>更正</em>：2024年度营业收入由约2.08亿元调减为约1.99亿元；净利润由约123万元调减为约-1238万元，公司前期披露财务信息不准确。","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610163898495340.html"},{"date":"2026-10-18 17:03:40","image":"","code":"202610183899153369","title":"ST绝味将于10月20日“摘帽”，实施中期分红在即，调低回购股份价格上限","content":"根据相关规定，公司对2017年至2021年年度报告及2022年至2025年半年度报告的相关数据进行会计差错<em>更正</em>及追溯调整，天职国际会计师事务所（特殊普通合伙）出具了《关于绝味食品股份有限公司前期会计差错<em>更正</em>的专项说明的审核报告》。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610183899153369.html"},{"date":"2026-10-16 20:21:00","image":"","code":"202610163898757945","title":"耐普矿机：关于子公司涉及诉讼的公告","content":"若法院支持原告关于撤销产权证书、<em>更正</em>土地登记或颁发临时禁令的请求，可能导致子公司相关土地资产无法使用、开发、转让或处置，并存在计提减值风险。公司生产经营正常。","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610163898757945.html"},{"date":"2026-10-18 21:33:05","image":"https://np-newspic.dfcfw.com/download/D25188326216408781057_w210h154.jpg","code":"202610183899179592","title":"603517、603838<em> </em>将“摘帽”！明日停牌","content":"，对2017年至2021年年度报告及2022年至2025年半年度报告的相关数据进行<em>更正</em>调整；其三，公司已就投资者诉讼事项合理计提预计负债100万元。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610183899179592.html"},{"date":"2026-10-18 19:30:23","image":"","code":"202610183899165388","title":"两只A股，明日停牌一天！有一只年内涨超70%","content":"，对2017年至2021年年度报告及2022年至2025年半年度报告的相关数据进行<em>更正</em>调整；其三，公司已就投资者诉讼事项合理计提预计负债100万元。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610183899165388.html"},{"date":"2026-10-16 20:36:00","image":"","code":"202610163898622042","title":"向日葵：关于股票交易异常波动的公告","content":"公司目前没有任何根据《深圳证券交易所创业板股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉公司有根据《深圳证券交易所创业板股票上市规则》等有关规定应予以披露而未披露的、对公司股票交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610163898622042.html"},{"date":"2026-10-16 18:08:42","image":"https://np-newspic.dfcfw.com/download/D25053552985116765091_w210h154.jpg","code":"202610163898487050","title":"上交所：本周对新华传媒等严重异常波动股票进行重点监控","content":"上市公司监管 　　2026年10月8日至2026年10月16日，上交所公司监管部门共发送监管工作函26份；通过事中事后监管，要求上市公司披露补充、<em>更正</em>类公告5份。","mediaName":"上交所发布","url":"http://finance.eastmoney.com/a/202610163898487050.html"},{"date":"2026-10-16 18:01:00","image":"","code":"202610163898490550","title":"东方嘉盛：连续2个交易日收盘价跌幅偏离值累超23.61%","content":"经核实，公司前期披露的信息不存在需要<em>更正</em>、补充之处；未发现近期公共传媒报道了可能对公司股票交易价格产生较大影响的未公开重大信息。此外，公司董事会确认目前没有任何应予以披露而未披露的事项。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610163898490550.html"},{"date":"2026-10-16 20:21:00","image":"","code":"202610163898593654","title":"农心科技：关于股票交易异常波动的公告","content":"本公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的、对本公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610163898593654.html"},{"date":"2026-10-16 20:10:00","image":"","code":"202610163898578243","title":"东方嘉盛：股票交易异常波动公告","content":"公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉公司有根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的、对公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610163898578243.html"},{"date":"2026-10-18 17:50:00","image":"","code":"202610183899156583","title":"屡教不改？华光新材董秘二度遭监管警示<em> </em>|<em> </em>董秘沙龙","content":"2023年7月，因华光新材2022年业绩快报披露不准确、<em>更正</em>不及时，胡岭作为董秘曾被浙江证监局出具警示函。 　　资料显示，胡岭于2010年11月入职华光新材，担任行政总监；自2011年3月起，出任公司副总、董秘。 　　截至目前，胡岭在华光新材任职约16年，担任董秘职务已十余年。","mediaName":"时代财经","url":"http://finance.eastmoney.com/a/202610183899156583.html"},{"date":"2026-10-16 19:03:39","image":"","code":"202610163898669110","title":"国家统计局：统计严重失信企<em>业</em>将被公示1至3年","content":"完善权利救济制度，新增统计机构在收到企业信息公示错误<em>更正</em>申请之日起7个工作日内进行核实的规定。新增行政复议、行政诉讼期间统计严重失信企业信息不暂停公示的规定，并对程序终结后的信息修正程序作出规定。","mediaName":"北京商报","url":"http://finance.eastmoney.com/a/202610163898669110.html"},{"date":"2026-10-10 16:29:30","image":"","code":"202610103891929993","title":"专家：培训、学时证明、行<em>业</em>证书等不能抵扣个税，错填需<em>更正</em>","content":"对经提示提醒仍拒不<em>更正</em>、虚假申报享受税收优惠的，税务机关可追缴税款、加收滞纳金。 　　专家提醒，个税专项附加扣除是国家惠民减负的重要举措，红利享受建立在依法如实申报的基础上，纳税人要主动守好合规底线，对存在的疏漏及时予以<em>更正</em>补正，最大限度防范涉税风险。","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202610103891929993.html"},{"date":"2026-10-15 19:34:42","image":"","code":"202610153897096153","title":"昊翔股份冲刺北交所IPO背后：招股书信披质量存瑕疵<em> </em>报告期内毛利率持续下滑","content":"两次披露差错<em>更正</em> 　　2026年3月31日和9月23日，昊翔股份两次披露前期会计差错<em>更正</em>公告。其中，3月31日这次<em>更正</em>，是因为公司未确认2024年度和2025年一季度享受增值税进项税额加计抵减430.59万元和86.15万元，相应少确认其他收益，多确认税金及附加。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610153897096153.html"},{"date":"2026-10-16 18:24:00","image":"","code":"202610163898500685","title":"向日葵：连续2个交易日收盘价涨幅偏离值累超30%","content":"经公司自查并向控股股东、实际控制人核实，公司前期披露的信息不存在需要<em>更正</em>、补充之处；未发现近期公共传媒报道可能或已经对公司股票交易价格产生较大影响的未公开重大信息；近期公司经营情况及内外部经营环境未发生重大变化；公司、控股股东和实际控制人不存在应披露而未披露的重大事项或处于筹划阶段的重大事项","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610163898500685.html"},{"date":"2026-10-18 14:17:52","image":"","code":"202610183899123685","title":"山金国际子公司部分<em>业</em>务不满足高新优惠条件，补缴税款及滞纳金2.87亿元，计入当期损益","content":"公告显示，根据《企业会计准则第28号——会计政策、会计估计变更和差错<em>更正</em>》相关规定，上述补缴企业所得税事项不属于前期会计差错，不涉及对前期财务报表的追溯调整，补缴款项将计入2026年当期损益。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610183899123685.html"},{"date":"2026-10-18 20:20:12","image":"","code":"202610183899169486","title":"吉大<em>正</em>元两连板触发股价异动，公司澄清：AI安全、低空相关<em>业</em>务暂未实现规模化营收，上半年<em>业</em>绩处于亏损状态","content":"针对公司股票交易的异常波动，经公司自查并与公司管理层、实际控制人及其一致行动人沟通，现将情况说明如下，公司前期披露的信息不存在需要<em>更正</em>、补充之处。公司未发现近期公共媒体报道了可能或已经对公司股票交易价格产生较大影响的未公开的重大信息。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610183899169486.html"},{"date":"2026-10-15 20:51:00","image":"","code":"202610153897153542","title":"雪人集团：股票交易异常波动公告","content":"本公司目前没有任何根据深交所《股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据深交所《股票上市规则》等有关规定应予以披露而未披露的、对本公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610153897153542.html"},{"date":"2026-10-17 23:47:59","image":"","code":"202610173899087460","title":"连续4年财务造假！这家A股公司<em> </em>被罚→","content":"对此，佳缘科技回应称，已对《行政处罚决定书》所涉事项相应年度财务会计报告进行追溯<em>更正</em>，将持续关注上述事项的进展情况，并严格按照相关法律法规和监管要求及时履行信息披露义务。","mediaName":"央视财经","url":"http://finance.eastmoney.com/a/202610173899087460.html"},{"date":"2026-10-15 21:22:00","image":"","code":"202610153897170786","title":"金禄电子：股票交易异常波动公告","content":"深圳证券交易所创业板股票上市规则》等有关规定应予以披露而未披露的事项或者与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据《深圳证券交易所创业板股票上市规则》等有关规定应予以披露而未披露的、对本公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610153897170786.html"},{"date":"2026-10-13 22:20:07","image":"","code":"202610133894451287","title":"粤芯半导体上市首日跻身千亿俱乐部！智光电气间接持股5.46%，披露持股数据现乌龙","content":"此前，智光电气在10月12日晚间披露的上市公告中，将吉富新芯的持股数据误写为537.63万股，这与<em>更正</em>后的5000万股相差甚远。智光电气在公告中表示，对上述<em>更正</em>给广大投资者带来的不便深表歉意。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610133894451287.html"},{"date":"2026-10-15 20:49:00","image":"","code":"202610153897140732","title":"皇台酒<em>业</em>：关于股票交易异常波动的公告","content":"公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项，或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉公司有根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的、对公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610153897140732.html"},{"date":"2026-10-15 18:55:00","image":"","code":"202610153897200650","title":"大金重工：股票交易异常波动公告","content":"本公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的、对本公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610153897200650.html"},{"date":"2026-10-15 18:54:00","image":"","code":"202610153897052762","title":"金禄电子：连续2个交易日收盘价涨幅偏离值累超30%","content":"经核实，公司前期披露信息不存在需要<em>更正</em>、补充之处，目前经营情况及内外部经营环境未发生重大变化，不存在应披露而未披露的重大事项，控股股东、实际控制人及董事、高级管理人员在异常波动期间不存在买卖公司股票的行为。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610153897052762.html"},{"date":"2026-10-17 17:32:29","image":"","code":"202610173899050629","title":"从立案到落地仅3个月！ST佳缘被罚600万，公司已对5份财报进行追溯调整","content":"根据ST佳缘发布的前期会计差错<em>更正</em>及追溯调整的公告，公司已对上述前期会计差错进行了<em>更正</em>，并对上市前2019年度、2020年度、2021年度及上市后2022年度、2024年度合并及母公司财务报表进行了追溯调整。","mediaName":"时代周报","url":"http://finance.eastmoney.com/a/202610173899050629.html"},{"date":"2026-10-14 21:53:34","image":"","code":"202610143895753150","title":"涉嫌虚增营收3.2亿元<em> </em>林州重机及三责任人将被罚款逾千万元","content":"2026年4月29日，公司披露《关于前期会计差错<em>更正</em>及追溯调整的公告》，对相关财务数据进行了<em>更正</em>。","mediaName":"中国经营报","url":"http://finance.eastmoney.com/a/202610143895753150.html"},{"date":"2026-10-15 19:04:00","image":"","code":"202610153897075850","title":"大金重工：公司A股股票交易异常波动","content":"针对公司股票交易异常波动，公司向控股股东、实际控制人对相关事项进行了核实：公司前期所披露的信息不存在需要<em>更正</em>、补充之处；公司未发现近期公共传媒报道了可能或已经对公司股票交易价格产生较大影响的未公开重大信息；公司目前生产经营活动一切正常，内外部经营环境未发生重大变化；公司、控股股东及实际控制人不存在关于公司的应披露而未披露的重大事项","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610153897075850.html"},{"date":"2026-10-14 11:12:19","image":"","code":"202610143895239215","title":"信宇人及实控人被证监会立案调查<em> </em>此前已遭上交所监管问询、纪律处分","content":"信宇人2025年年度审计机构则表示，其未能获取充分的审计证据证明信宇人的差错<em>更正</em>的准确性，对公司关于募集资金及担保借款回款的差错<em>更正</em>的完整性和准确性予以保留。","mediaName":"中国经营报","url":"http://finance.eastmoney.com/a/202610143895239215.html"},{"date":"2026-10-15 17:38:00","image":"","code":"202610153897003978","title":"大金重工：连续3个交易日收盘价跌幅偏离值累超20%","content":"经核实，公司前期披露信息不存在需要<em>更正</em>或补充之处；未发现近期公共传媒报道可能对公司股票交易价格产生较大影响的未公开重大信息；公司目前生产经营活动一切正常，内外部经营环境未发生重大变化；公司及控股股东、实际控制人不存在应披露而未披露的重大事项；异常波动期间，控股股东及实际控制人不存在买卖公司股票的情形","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610153897003978.html"},{"date":"2026-10-15 17:31:15","image":"","code":"202610153897202454","title":"一笔9820万元政信类信托产品逾期","content":"公告中，这家贵州省地方国有开发投资平台在<em>更正</em>了公司债券2026年半年度报告的同时，新披露一笔信托融资逾期，该笔逾期成为又一起公开的政信信托风险案例。","mediaName":"21世纪经济报道","url":"http://stock.eastmoney.com/a/202610153897202454.html"},{"date":"2026-10-15 18:48:00","image":"","code":"202610153897049929","title":"雪人集团：连续3个交易日收盘价涨幅偏离值累超20%","content":"经核实，公司前期披露的信息不存在需要<em>更正</em>、补充之处；未发现近期公共传媒报道了可能或已经对公司股票交易价格产生较大影响的未公开重大信息；近期生产经营情况正常，内外部经营环境未发生重大变化；公司及控股股东、实际控制人林汝捷不存在应披露而未披露的重大事项，且控股股东和实际控制人在异常波动期间未买卖公司股票","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610153897049929.html"},{"date":"2026-10-18 23:31:23","image":"","code":"202610183899210344","title":"喜提4连板！冰山冷热最新回应<em> </em>上半年利润下滑近40%","content":"公告显示，公司前期披露的信息不存在需要<em>更正</em>、补充之处；近期公共传媒未报道可能或已经对公司股票交易价格产生较大影响的未公开重大信息；近期公司经营情况及内外部经营环境未发生重大变化；公司及公司控股股东不存在关于公司的应披露而未披露的重大事项及处于筹划阶段的重大事项；股票异常波动期间，控股股东未买卖公司股票","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610183899210344.html"},{"date":"2026-10-13 23:10:28","image":"","code":"202610133894487530","title":"信宇人及实控人被证监会立案<em> </em>公司2月曾因此事被交易所纪律处分","content":"公告指出，本次差错<em>更正</em>不会导致公司已披露的相关年度报表出现盈亏性质的改变。 　　今年实控人曾遭上交所纪律处分 　　在会计差错<em>更正</em>公告披露之前，信宇人及相关责任人就已因上述违规事项受到上交所纪律处分。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610133894487530.html"},{"date":"2026-10-14 17:49:00","image":"","code":"202610143895557060","title":"楚环科技：连续3个交易日收盘价跌幅偏离值累超20%","content":"针对此次异常波动，公司经自查并向控股股东、实际控制人核实，近期公司经营情况正常，内外部经营环境未发生重大变化；公司不存在应披露而未披露的重大事项或处于筹划阶段的重大事项；不存在对股票交易价格产生影响的媒体报道或市场传闻，不涉及热点概念事项；前期披露信息不存在需要<em>更正</em>、补充之处；控股股东","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610143895557060.html"},{"date":"2026-10-14 17:24:00","image":"","code":"202610143895546063","title":"冰山冷热：近期公司经营情况及内外部经营环境未发生重大变化","content":"针对股价异动，公司经核实表示，前期披露的信息不存在需要<em>更正</em>、补充之处；近期公共传媒未报道可能或已经对公司股票交易价格产生较大影响的未公开重大信息；近期公司经营情况及内外部经营环境未发生重大变化；公司及控股股东不存在应披露而未披露的重大事项及处于筹划阶段的重大事项；股票异常波动期间，","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610143895546063.html"},{"date":"2026-10-14 20:28:00","image":"","code":"202610143895673311","title":"冰山冷热：股票交易异常波动公告","content":"公司目前没有任何根据深圳证券交易所《股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉公司有根据深圳证券交易所《股票上市规则》等有关规定应予以披露而未披露的、对公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610143895673311.html"},{"date":"2026-10-14 20:24:00","image":"","code":"202610143895667237","title":"金奥博：股票交易异常波动公告","content":"公司董事会确认，除前述事项外，公司目前没有任何根据《深圳证券交易所股票上市规则》规定应予以披露而未披露的事项；董事会也未获悉公司有根据《深圳证券交易所股票上市规则》的规定应予以披露而未披露的、对公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>、补充之处","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610143895667237.html"},{"date":"2026-10-14 19:55:00","image":"","code":"202610143895643030","title":"超声电子：股票交易异常波动公告","content":"公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露以及对本公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610143895643030.html"},{"date":"2026-10-15 10:23:00","image":"","code":"202610153896592497","title":"林州重机五年内再犯财务虚假记载：2025半年报虚增营收逾3亿元，监管拟对公司及三名高管警告并罚款","content":"2026年4月29日，公司披露《关于前期会计差错<em>更正</em>及追溯调整的公告》，对相关财务数据进行了<em>更正</em>。 　　作为时任公司董事长、审计委员会成员的韩录云、时任公司董事、总经理郭钏以及时任公司财务总监郭超为林州重机2025年半年度报告涉嫌虚假记载事项的相关主管人员。","mediaName":"澎湃新闻","url":"http://finance.eastmoney.com/a/202610153896592497.html"},{"date":"2026-10-15 18:32:00","image":"","code":"202610153897039022","title":"宝鼎科技：连续3个交易日收盘价涨幅偏离值累超20%","content":"经公司核查，前期披露信息不存在需要<em>更正</em>、补充之处，未发现近期公共传媒报道可能对公司股票交易价格产生较大影响的未公开重大信息。公司生产经营活动正常，主营业务及内外部经营环境未发生重大变化。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610153897039022.html"},{"date":"2026-10-14 21:17:00","image":"","code":"202610143895729368","title":"盛视科技：股票交易异常波动公告","content":"公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉公司有根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的、对公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610143895729368.html"},{"date":"2026-10-14 20:32:00","image":"","code":"202610143895706489","title":"富春股份：关于股票交易异常波动的公告","content":"本公司目前没有任何根据深圳证券交易所《创业板股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据深圳证券交易所《创业板股票上市规则》等有关规定应予以披露而未披露的、对本公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610143895706489.html"},{"date":"2026-10-14 20:32:00","image":"","code":"202610143895706813","title":"满坤科技：股票交易异常波动公告","content":"深圳证券交易所创业板股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉公司有根据《深圳证券交易所创业板股票上市规则》等有关规定应予以披露而未披露的、对公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610143895706813.html"},{"date":"2026-10-14 20:29:00","image":"","code":"202610143895685661","title":"楚环科技：股票交易异常波动公告","content":"本公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的、对本公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610143895685661.html"},{"date":"2026-10-14 20:28:00","image":"","code":"202610143895678950","title":"阳光乳<em>业</em>：股票交易异常波动公告","content":"本公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的、对本公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610143895678950.html"},{"date":"2026-10-14 20:28:00","image":"","code":"202610143895682518","title":"莱美药<em>业</em>：关于股票交易异常波动的公告","content":"深圳证券交易所创业板股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉公司有根据《深圳证券交易所创业板股票上市规则》等有关规定应予以披露而未披露的、对公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610143895682518.html"},{"date":"2026-10-14 19:59:00","image":"","code":"202610143895647358","title":"百洋股份：股票交易异常波动暨风险提示公告","content":"本公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的、对本公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610143895647358.html"},{"date":"2026-10-16 21:44:00","image":"","code":"202610163898722172","title":"我国进一步完善统计严重失信企<em>业</em>信息公示制度","content":"新增统计机构在收到企业信息公示错误<em>更正</em>申请之日起7个工作日内进行核实的规定。新增行政复议、行政诉讼期间统计严重失信企业信息不暂停公示的规定，并对程序终结后的信息修正程序作出规定。 　　国家统计局有关负责人介绍，此次修订着重把握了惩戒与保护并重这一原则。","mediaName":"中国证券报·中证网","url":"http://finance.eastmoney.com/a/202610163898722172.html"},{"date":"2026-10-12 20:24:01","image":"","code":"202610123892872985","title":"帅特龙IPO：对多家主要外协供应商采购金额大幅调整<em> </em>其中一家关联外协公司疑似以股权代持形式存在","content":"而针对安徽帅特龙，2023年原材料采购金额<em>更正</em>前为783.64万元，<em>更正</em>后为692.73万元，下调幅度11.60%；<em>更正</em>原因为2023年、2024年多统计了关联交易金额。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610123892872985.html"},{"date":"2026-10-16 21:10:00","image":"","code":"202610163898677444","title":"加强统计领域信用体系建设，国家统计局公布修订后的《统计严重失信企<em>业</em>信用管理办法》","content":"新增统计机构在收到企业信息公示错误<em>更正</em>申请之日起7个工作日内进行核实的规定。新增行政复议、行政诉讼期间统计严重失信企业信息不暂停公示的规定，并对程序终结后的信息修正程序作出规定。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610163898677444.html"},{"date":"2026-10-13 23:01:02","image":"","code":"202610133894483433","title":"3600元定额扣除<em> </em>为何只认“取证当年”","content":"在此过程中，纳税人需要对申报信息的真实性、准确性和完整性承担主体责任，一旦发现错报应及时<em>更正</em>、重新申报。对经提示提醒仍拒不<em>更正</em>、虚假申报享受税收优惠的，税务机关可追缴税款、加收滞纳金。","mediaName":"中国经营报","url":"http://finance.eastmoney.com/a/202610133894483433.html"},{"date":"2026-10-14 18:26:00","image":"","code":"202610143895591891","title":"富春股份：连续3个交易日收盘价涨幅偏离值累超30%","content":"经公司自查及向控股股东、实际控制人核实，公司前期披露的信息不存在需要<em>更正</em>、补充之处；未发现近期公共传媒报道了可能或已经对公司股票交易价格产生较大影响的未公开重大信息；目前的经营情况及内外部经营环境未发生重大变化；公司及控股股东、实际控制人不存在应披露而未披露的重大事项或处于筹划阶段的重大事项","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610143895591891.html"},{"date":"2026-10-17 10:47:34","image":"","code":"202610173899019289","title":"广农糖<em>业</em>财务造假<em> </em>公司及五责任人合计被罚930万元","content":"2026年4月29日，广农糖业披露《关于前期会计差错<em>更正</em>及追溯调整的公告》，对前述事项进行了追溯调整。","mediaName":"中国经营报","url":"http://finance.eastmoney.com/a/202610173899019289.html"},{"date":"2026-10-19 00:04:54","image":"","code":"202610183899162458","title":"2家A股公司10月19日停牌一天","content":"公司于4月21日召开董事会，审议通过了前期会计差错<em>更正</em>及追溯调整议案，对2017年至2021年年度报告及2022年至2025年半年度报告的相关数据进行了修正，并由天职国际会计师事务所出具专项审核报告，相关公告已于2026年4月23日披露。","mediaName":"中国证券报","url":"http://finance.eastmoney.com/a/202610183899162458.html"},{"date":"2026-10-16 17:55:45","image":"","code":"202610163898484640","title":"国家统计局公布修订后的《统计严重失信企<em>业</em>信用管理办法》","content":"新增统计机构在收到企业信息公示错误<em>更正</em>申请之日起7个工作日内进行核实的规定。新增行政复议、行政诉讼期间统计严重失信企业信息不暂停公示的规定，并对程序终结后的信息修正程序作出规定。","mediaName":"央视新闻","url":"http://finance.eastmoney.com/a/202610163898484640.html"},{"date":"2026-10-16 17:52:41","image":"","code":"202610163898609382","title":"国家统计局公布修订后的《统计严重失信企<em>业</em>信用管理办法》","content":"新增统计机构在收到企业信息公示错误<em>更正</em>申请之日起7个工作日内进行核实的规定。新增行政复议、行政诉讼期间统计严重失信企业信息不暂停公示的规定，并对程序终结后的信息修正程序作出规定。","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202610163898609382.html"},{"date":"2026-10-18 22:27:00","image":"","code":"202610183899198894","title":"统计失信企<em>业</em>管理迎调整<em> </em>专家：夯实诚信市场导向","content":"修订后的《办法》新增统计机构在收到企业信息公示错误<em>更正</em>申请之日起7个工作日内进行核实的规定，并新增行政复议、行政诉讼期间的信息公示与修正程序作出规范。","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202610183899198894.html"},{"date":"2026-10-14 22:06:46","image":"","code":"202610143895763395","title":"昊翔股份冲刺北交所IPO：“应收、应付双高”特征显著，招股书信披质量存在瑕疵","content":"两次披露前期会计差错<em>更正</em>公告 　　2026年3月31日和9月23日，昊翔股份两次披露前期会计差错<em>更正</em>公告。其中3月31日这次是因为公司未确认2024年度和2025年一季度享受增值税进项税额加计抵减430.59万元和86.15万元，相应少确认其他收益，多确认税金及附加。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610143895763395.html"},{"date":"2026-10-14 20:45:05","image":"","code":"202610143895687456","title":"002535，合计拟被罚1040万元，2025半年报涉嫌虚增营收3.23亿元","content":"2026年4月29日，公司披露《关于前期会计差错<em>更正</em>及追溯调整的公告》，对相关财务数据进行了<em>更正</em>。 　　上述违法事实有公司公告、询问笔录、购销合同、业务记账凭证等证据证明。河南证监局认为，林州重机的上述行为涉嫌违反《证券法》相关规定。","mediaName":"经济参考网","url":"http://finance.eastmoney.com/a/202610143895687456.html"},{"date":"2026-10-14 18:28:00","image":"","code":"202610143895591525","title":"晶雪节能：连续2个交易日收盘价涨幅偏离值累超30%","content":"针对股票交易异常波动，公司经核实说明如下：公司未发现前期披露的信息存在需要<em>更正</em>、补充之处；未发现近期公共传媒报道了可能或已经对公司股票交易价格产生较大影响的未公开重大信息；公司目前生产经营情况及内外部经营环境未发生重大变化；公司、控股股东和实际控制人不存在关于公司的应披露而未披露的重大事项","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610143895591525.html"},{"date":"2026-10-18 20:20:05","image":"","code":"202610183899169135","title":"AI安全、低空经济热点概念拉动，吉大<em>正</em>元“2连板”，最新回应来了","content":"公告显示，经公司自查并与管理层、实际控制人及其一致行动人沟通核实，公司前期披露信息不存在需要<em>更正</em>、补充之处，未发现近期公共媒体报道可能或已经对公司股票交易价格产生较大影响的未公开重大信息，公司近期经营情况正常，内外部经营环境未发生重大变化，实际控制人及其一致行动人在异常波动期间不存在买卖公司股票的情形","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610183899169135.html"},{"date":"2026-10-14 17:42:00","image":"","code":"202610143895556198","title":"阳光乳<em>业</em>：连续2个交易日收盘价涨幅偏离值累超20%","content":"经公司自查并向控股股东及实际控制人核实，公司近期经营情况正常，内外部经营环境未发生重大变化；前期披露信息不存在需要<em>更正</em>、补充之处；未发现近期公共传媒报道可能对公司股票交易价格产生较大影响的未公开重大信息；公司、控股股东和实际控制人不存在应披露而未披露的重大事项；控股股东、实际控制人在股票异常波动期间不存在买卖公司股票的情形","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610143895556198.html"},{"date":"2026-10-16 19:25:00","image":"","code":"202610163898657153","title":"国家统计局：统计严重失信企<em>业</em>信息公示期调整为最短1年、最长3年","content":"新增统计机构在收到企业信息公示错误<em>更正</em>申请之日起7个工作日内进行核实的规定。新增行政复议、行政诉讼期间统计严重失信企业信息不暂停公示的规定，并对程序终结后的信息修正程序作出规定。 　　现行《管理办法》自2022年5月施行。近年来，社会信用体系建设迎来一系列新部署。","mediaName":"澎湃新闻","url":"http://finance.eastmoney.com/a/202610163898657153.html"},{"date":"2026-10-14 16:34:06","image":"","code":"202610143895500823","title":"股价异常波动，超声电子：不存在应披露而未披露的重大事项","content":"经核实，公司不存在应披露而未披露的重大事项，前期披露信息不存在需要<em>更正</em>、补充之处；未发现近期公共媒体报道的可能对公司股票交易价格产生较大影响的未公开重大信息；公司经营情况正常，内外部经营环境未发生重大变化；控股股东、实际控制人不存在应披露而未披露的重大事项，且在异常波动期间未买卖公司股票","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610143895500823.html"},{"date":"2026-10-18 22:24:00","image":"","code":"202610183899196258","title":"严重失信企<em>业</em>，最长公示3年！统计失信企<em>业</em>管理迎调整，专家最新解读！","content":"修订后的《办法》新增统计机构在收到企业信息公示错误<em>更正</em>申请之日起7个工作日内进行核实的规定，并新增行政复议、行政诉讼期间的信息公示与修正程序作出规范。","mediaName":"证券时报","url":"http://finance.eastmoney.com/a/202610183899196258.html"},{"date":"2026-10-13 07:00:57","image":"","code":"202610133893092783","title":"“月子中心第一股”爱帝宫退市；中源协和募投项目延期2年<em> </em>|<em> </em>医药早参","content":"“0.24%”误录为“0.21%”，特此<em>更正</em>。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610133893092783.html"},{"date":"2026-10-14 16:56:00","image":"","code":"202610143895520417","title":"百洋股份：连续2个交易日收盘价涨幅偏离值累超20%","content":"公司前期披露信息不存在需要<em>更正</em>、补充之处，近期经营情况正常，内外部经营环境未发生重大变化。公司股票短期波动较大，近期连续4个交易日涨停，存在市场情绪过热、非理性炒作风险。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610143895520417.html"},{"date":"2026-10-13 20:44:00","image":"","code":"202610133894374614","title":"农心科技：关于股票交易异常波动的公告","content":"本公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的、对本公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610133894374614.html"},{"date":"2026-10-17 23:25:21","image":"","code":"202610173899086536","title":"因招股书及年报虚假记载<em> </em>ST佳缘及4名责任人合计被罚1450万元","content":"公司已对相关年度财务会计报告进行追溯<em>更正</em>。","mediaName":"经济参考网","url":"http://finance.eastmoney.com/a/202610173899086536.html"},{"date":"2026-10-12 17:25:20","image":"","code":"202610123892761011","title":"资源硬、造血强<em> </em>沪市有色龙头夯实资本市场发展韧性根基","content":"<em>江西铜业</em>则体现出传统资源龙头较强的经营弹性。2026年上半年，公司实现营业收入3071.55亿元，同比增长19.53%；归母净利润86.32亿元，同比增长106.77%；经营活动产生的现金流量净额58.14亿元，同比增长102.49%。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610123892761011.html"},{"date":"2026-10-13 21:01:00","image":"","code":"202610133894381692","title":"郑中设计：关于股票交易异常波动的公告","content":"本公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的、对本公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610133894381692.html"},{"date":"2026-10-13 17:29:00","image":"","code":"202610133894228548","title":"郑中设计：连续3个交易日收盘价涨幅偏离值累超20%","content":"经公司自查并向控股股东、实际控制人核实，公司前期披露的信息不存在需要<em>更正</em>、补充之处；未发现近期公共媒体报道可能或已经对公司股票交易价格产生较大影响的未公开重大信息；公司近期经营情况正常，内外部经营环境未发生重大变化；公司、控股股东、实际控制人不存在应披露而未披露的重大事项，也不存在处于筹划阶段的重大事项","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610133894228548.html"},{"date":"2026-10-15 20:42:28","image":"","code":"202610153897134664","title":"A股公司密集发布立案或处罚公告：*ST清越被罚1.72亿，俞发祥再遭立案","content":"去年4月底，*ST纳川对2023年年报、2024年三季报进行<em>更正</em>。根据<em>更正</em>后的数据，公司2023年营收达3.96亿元，同比减少21.86%，归母净利润亏损5.13亿元，同比下降21.67%。 　　*ST纳川被立案之际，公司还存在“保壳”压力。","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202610153897134664.html"},{"date":"2026-10-13 07:54:00","image":"","code":"202610133893275954","title":"丁香医生、智行旅行等被通报！涉未列出收集使用个人信息目的","content":"《易公交》（版本4.0.2，PP助手）、《卫莱电》（微信小程序）2款移动应用，未提供有效的<em>更正</em>、删除个人信息及注销用户账号功能；为<em>更正</em>、删除个人信息或注销用户账号设置不必要或不合理条件。","mediaName":"南方都市报","url":"http://biz.eastmoney.com/a/202610133893275954.html"},{"date":"2026-10-14 19:48:28","image":"","code":"202610143895627072","title":"605136盘中上演“天地板”！此前3连板，公司提示：实控人仍有300万股被冻结","content":"公司前期披露的信息不存在需要<em>更正</em>、补充之处。敬请广大投资者理性投资，注意投资风险。 　　来源：公司公告、市场行情、财闻","mediaName":"华夏时报","url":"http://finance.eastmoney.com/a/202610143895627072.html"},{"date":"2026-10-15 18:19:46","image":"","code":"202610153897036894","title":"协创数据：不存在“实质控制”麦塔倍斯情形","content":"公司须启动专项核查并逐条回应；确有瑕疵的主动<em>更正</em>、追责到人等。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610153897036894.html"},{"date":"2026-10-15 18:08:03","image":"","code":"202610153897023592","title":"协创数据：不存在“实质控制”麦塔倍斯情形","content":"公司须启动专项核查并逐条回应；确有瑕疵的主动<em>更正</em>、追责到人等。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610153897023592.html"},{"date":"2026-10-13 18:24:00","image":"","code":"202610133894254446","title":"*ST仕净：连续3个交易日收盘价涨幅偏离值累超30%","content":"公司提示相关风险，目前公司预重整程序正在推进，能否被法院受理重整存在不确定性；公司仍处于中国证监会立案调查阶段，2025年年度财务报告被出具无法表示意见的审计报告，内部控制被出具否定意见的审计报告，前期会计差错<em>更正</em>相关核查工作尚未完成；重新公开招募预重整投资人存在未能招募到合格投资人等不确定性","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610133894254446.html"},{"date":"2026-10-18 19:30:22","image":"","code":"202610183899165486","title":"证监会出手！ST佳缘及4名责任人共被罚1450万元","content":"公司已对相关年度财务会计报告进行追溯<em>更正</em>。 　　业绩承压 　　ST佳缘全称佳缘科技股份有限公司，创立于1994年，2022年1月17日在深交所创业板上市，发行募集资金总额约10.8亿元。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610183899165486.html"},{"date":"2026-10-18 18:58:00","image":"","code":"202610183899162754","title":"603517，即将“摘帽”","content":"其二，公司于2026年4月对2017年至2021年年度报告及2022年至2025年半年度报告相关数据进行了会计差错<em>更正</em>及追溯重述，天职国际会计师事务所出具了专项审核报告。其三，针对投资者诉讼事项，公司基于谨慎性原则计提预计负债100万元。","mediaName":"中国基金报","url":"http://finance.eastmoney.com/a/202610183899162754.html"},{"date":"2026-10-13 18:53:00","image":"","code":"202610133894273872","title":"农心科技：连续2个交易日收盘价涨幅偏离值累超20%","content":"公司前期披露的信息不存在需要补充、<em>更正</em>之处，未发现近期公共传媒报道了可能对公司股票交易价格产生较大影响的未公开重大信息。此外，公司控股股东、实际控制人及董事、高级管理人员在异常波动期间不存在买卖公司股票的情况。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610133894273872.html"},{"date":"2026-10-12 19:16:00","image":"","code":"202610123892819712","title":"欢瑞世纪：连续2个交易日收盘价涨幅偏离值累超20%","content":"经核查，公司前期披露信息不存在需要<em>更正</em>或补充之处，无应披露而未披露的重大事项，目前经营情况及内外部环境正常。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610123892819712.html"},{"date":"2026-10-12 21:37:00","image":"","code":"202610123892948690","title":"欢瑞世纪：股票交易异常波动的公告","content":"，本公司目前没有任何根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据《深圳证券交易所股票上市规则》等有关规定应予以披露而未披露的、对公司股票价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610123892948690.html"},{"date":"2026-10-12 16:40:16","image":"","code":"202610123892717332","title":"蓝筹价值观察：从沪市有色行<em>业</em>看资本市场韧性根基","content":"<em>江西铜业</em>实现营业收入3071.55亿元，同比增长19.53%；归母净利润86.32亿元，同比增长106.77%；经营活动产生的现金流量净额58.14亿元，同比增长102.49%。","mediaName":"央广财经","url":"http://finance.eastmoney.com/a/202610123892717332.html"},{"date":"2026-10-12 21:48:00","image":"","code":"202610123893030278","title":"远程股份：关于股票交易异常波动的公告","content":"本公司目前没有任何根据《深圳证券交易所股票上市规则》规定应予以披露而未披露的事项或与该事项有关的筹划、商谈、意向、协议等；董事会也未获悉本公司有根据《深圳证券交易所股票上市规则》的规定应予以披露而未披露的、对本公司股票及其衍生品种交易价格产生较大影响的信息；公司前期披露的信息不存在需要<em>更正</em>","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610123893030278.html"}]},"searchId":"0f9d3792-6990-4544-b649-bf48da095455"})