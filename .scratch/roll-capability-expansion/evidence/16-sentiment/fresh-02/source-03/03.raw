rollSentimentCorpus03({"bizCode":"","bizMsg":"","code":0,"extra":{},"hitsTotal":10000,"msg":"OK","result":{"cmsArticleWebOld":[{"date":"2026-10-18 20:23:36","image":"","code":"202610183899170127","title":"恒力石化：预计前三季度<em>净利润</em>同比<em>增长</em>104%","content":"新京报贝壳财经讯 10月18日，恒力石化公告称，预计2026年前三季度归属于上市公司股东的<em>净利润</em>为102.56亿元，同比<em>增长</em>104.20%。","mediaName":"新京报","url":"http://finance.eastmoney.com/a/202610183899170127.html"},{"date":"2026-10-18 15:43:17","image":"","code":"202610183899138542","title":"东兴证券：前三季度<em>净利润</em>同比<em>增长</em>0.75%","content":"东兴证券(601198.SH)公告称，第三季度营业收入为9.79亿元，同比下降28.06%；归属于上市公司股东的<em>净利润</em>为5.86亿元，同比下降24.85%。前三季度实现营业收入34.85亿元，同比下降3.47%；归属于上市公司股东的<em>净利润</em>为16.11亿元，同比<em>增长</em>0.75%。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610183899138542.html"},{"date":"2026-10-18 17:18:06","image":"","code":"202610183899154258","title":"恒力石化：预计前三季度<em>净利润</em>同比<em>增长</em>104.20%","content":"恒力石化(600346.SH)公告称，预计2026年前三季度归属于上市公司股东的<em>净利润</em>为102.56亿元，同比<em>增长</em>104.20%。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610183899154258.html"},{"date":"2026-10-18 14:45:44","image":"","code":"202610183899128363","title":"华密新材：前三季度<em>净利润</em>约3681.79万元<em> </em>同比<em>增长</em>47.36%","content":"其中，第三季度单季（2026年7-9月），公司实现营业收入约1.24亿元，同比<em>增长</em>14.61%；归属于上市公司股东的<em>净利润</em>约1678.00万元，同比<em>增长</em>104.22%；扣除非经常性损益后的<em>净利润</em>约1653.41万元，同比<em>增长</em>102.58%。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899128363.html"},{"date":"2026-10-18 20:12:12","image":"","code":"202610183899168585","title":"恒力石化：预计前三季度<em>净利润</em>102.56亿元<em> </em>同比<em>增长</em>104.20%","content":"上证智讯 10月18日晚间，恒力石化发布2026年前三季度业绩预增公告称，公司预计2026年前三季度实现归属于上市公司股东的<em>净利润</em>约102.56亿元，与上年同期相比增加约52.33亿元，同比增加104.20%左右；扣除非经常性损益后的<em>净利润</em>约79.06亿元，与上年同期相比增加约37.20","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899168585.html"},{"date":"2026-10-18 16:45:38","image":"","code":"202610183899148623","title":"东兴证券：前三季度<em>净利润</em>约16.11亿元<em> </em>同比<em>增长</em>0.75%","content":"上证智讯 10月18日晚间，东兴证券发布2026年第三季度报告称，公司前三季度实现营业收入约34.85亿元，同比下降3.47%；归属于上市公司股东的<em>净利润</em>约16.11亿元，同比<em>增长</em>0.75%；归属于上市公司股东的扣除非经常性损益的<em>净利润</em>约16.15亿元，同比<em>增长</em>0.80%；基本每股收益","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899148623.html"},{"date":"2026-10-18 16:28:49","image":"","code":"202610183899145859","title":"卫星化学：前三季度<em>净利润</em>约90.59亿元<em> </em>同比<em>增长</em>141.24%","content":"上证智讯 10月16日晚间，卫星化学发布2026年第三季度报告称，公司年初至报告期末实现营业收入约464.14亿元，同比<em>增长</em>33.49%；归属于上市公司股东的<em>净利润</em>约90.59亿元，同比<em>增长</em>141.24%；归属于上市公司股东的扣除非经常性损益的<em>净利润</em>约90.22亿元，同比<em>增长</em>112.89%","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899145859.html"},{"date":"2026-10-18 16:28:48","image":"","code":"202610183899144665","title":"威尔高：前三季度<em>净利润</em>约1.82亿元<em> </em>同比<em>增长</em>161.43%","content":"第三季度公司实现营业收入约8.77亿元，同比<em>增长</em>115.24%；归属于上市公司股东的<em>净利润</em>约1.38亿元，同比<em>增长</em>461.86%，环比<em>增长</em>268.51%。 　　公司表示，营业收入及<em>净利润</em><em>增长</em>较快主要系AI服务器电源产品的订单与营收<em>增长</em>、泰国市场开拓成效显著以及销售单价上调所致。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899144665.html"},{"date":"2026-10-18 14:45:44","image":"","code":"202610183899128115","title":"萤石网络：前三季度<em>净利润</em>约6.16亿元<em> </em>同比<em>增长</em>45.85%","content":"上证智讯 10月16日晚间，萤石网络发布2026年第三季度报告称，公司前三季度实现营业收入约46.51亿元，同比<em>增长</em>8.34%；归属于上市公司股东的<em>净利润</em>约6.16亿元，同比<em>增长</em>45.85%；扣除非经常性损益后的<em>净利润</em>约6.05亿元，同比<em>增长</em>54.73%；基本每股收益0.78元。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899128115.html"},{"date":"2026-10-18 17:21:13","image":"","code":"202610183899154111","title":"恒力石化：预计前三季度归母<em>净利润</em>同比<em>增长</em>104.2%","content":"恒力石化10月18日公告，预计前三季度归母<em>净利润</em>102.56亿元左右，同比<em>增长</em>104.2%左右。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610183899154111.html"},{"date":"2026-10-18 14:45:55","image":"","code":"202610183899130994","title":"峰岹科技：预计前三季度<em>净利润</em>约2.84亿元<em> </em>同比<em>增长</em>69.69%","content":"；实现归属于上市公司股东的扣除非经常性损益的<em>净利润</em>约2.69亿元，同比<em>增长</em>76.69%。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899130994.html"},{"date":"2026-10-18 14:45:44","image":"","code":"202610183899128696","title":"生益电子：预计前三季度<em>净利润增长</em>68%到75%","content":"公司表示，受益于AI算力领域的高景气，公司锚定中高端赛道持续深耕，有序推进产能释放、深化技术升级、强化质量管控，高附加值产品占比稳步提升，2026年前三季度营业收入和<em>净利润</em>较上年同期实现<em>增长</em>。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899128696.html"},{"date":"2026-10-18 14:45:44","image":"","code":"202610183899127975","title":"永太科技：前三季度<em>净利润</em>约4.30亿元<em> </em>同比<em>增长</em>1221.81%","content":"上证智讯 10月16日晚间，永太科技发布2026年第三季度报告称，公司年初至报告期末实现营业收入约60.74亿元，同比<em>增长</em>50.79%；归属于上市公司股东的<em>净利润</em>约4.30亿元，同比<em>增长</em>1221.81%；扣除非经常性损益后的<em>净利润</em>约4.25亿元，同比<em>增长</em>6572.64%；经营活动产生的现金流量净额约","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610183899127975.html"},{"date":"2026-10-18 10:48:13","image":"https://np-newspic.dfcfw.com/download/D24854661704939871673_w210h154.jpg","code":"202610183899110080","title":"光模块高景气<em> </em>光迅科技三季度<em>净利润增长</em>超预期<em> </em>继续押注扩产","content":"该公司10月15日披露，预计今年前三季度归母<em>净利润</em>介于11.89亿至13.1亿元，较上年同期的7.19亿元<em>增长</em>65.37%至82.26%；扣除非经常性损益后的<em>净利润</em>预计是11.76亿至12.96亿元，同比<em>增长</em>73.38%至91.09%。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610183899110080.html"},{"date":"2026-10-19 06:52:00","image":"","code":"202610193899242979","title":"上证早知道｜002326<em> </em>前三季度<em>净利润</em>同比<em>增长</em>1222%；重要会议今日召开","content":"○四会富仕2026年第三季度报告显示，公司第三季度<em>净利润</em>为1.76亿元，同比<em>增长</em>217.22%；前三季度<em>净利润</em>为2.64亿元，同比<em>增长</em>101.67%。 　　○生益科技预计2026年前三季度归母<em>净利润</em>为64.6亿元至68.7亿元，同比<em>增长</em>164%至181%。","mediaName":"上海证券报","url":"http://finance.eastmoney.com/a/202610193899242979.html"},{"date":"2026-10-16 17:12:29","image":"","code":"202610163898451053","title":"金徽股份：前三季度营收<em>增长</em>42.67%<em> 净利润增长</em>86.86%","content":"上证智讯 10月16日晚间，金徽股份发布2026年第三季度报告称，公司前三季度实现营业收入约16.83亿元，同比<em>增长</em>42.67%；归属于上市公司股东的<em>净利润</em>约6.47亿元，同比<em>增长</em>86.86%；扣除非经常性损益的<em>净利润</em>约6.37亿元，同比<em>增长</em>95.08%；经营活动产生的现金流量净额约","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610163898451053.html"},{"date":"2026-10-16 16:58:27","image":"","code":"202610163898439742","title":"永太科技：前三季度<em>净利润</em>同比<em>增长</em>1222%<em> </em>锂电类销售大幅<em>增长</em>","content":"10月16日，永太科技(002326.SZ)公告称，第三季度营业收入为23.28亿元，同比<em>增长</em>64.07%；<em>净利润</em>为1.56亿元，同比<em>增长</em>696.08%。前三季度营业收入为60.74亿元，同比<em>增长</em>50.79%；<em>净利润</em>为4.30亿元，同比<em>增长</em>1221.81%。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610163898439742.html"},{"date":"2026-10-16 16:54:53","image":"","code":"202610163898430487","title":"海康威视：前三季度营收<em>增长</em>12.60%<em> 净利润增长</em>38.55%","content":"第三季度，公司实现营业收入约272.22亿元，同比<em>增长</em>13.71%；归属于上市公司股东的<em>净利润</em>约50.16亿元，同比<em>增长</em>36.97%；扣非<em>净利润</em>约49.84亿元，同比<em>增长</em>43.13%；基本每股收益0.547元，同比<em>增长</em>37.09%。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610163898430487.html"},{"date":"2026-10-16 16:48:57","image":"","code":"202610163898422522","title":"永太科技：前三季度<em>净利润</em>同比<em>增长</em>1222%<em> </em>锂电类销售大幅<em>增长</em>","content":"永太科技(002326.SZ)公告称，第三季度营业收入为23.28亿元，同比<em>增长</em>64.07%；<em>净利润</em>为1.56亿元，同比<em>增长</em>696.08%。前三季度营业收入为60.74亿元，同比<em>增长</em>50.79%；<em>净利润</em>为4.30亿元，同比<em>增长</em>1221.81%。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610163898422522.html"},{"date":"2026-10-16 17:48:00","image":"","code":"202610163898482630","title":"华密新材：第三季度<em>净利润</em>同比<em>增长</em>104.22%","content":"前三季度公司实现营业收入3.60亿元，同比<em>增长</em>15.73%；前三季度归属于上市公司股东的<em>净利润</em>3681.79万元，同比<em>增长</em>47.36%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610163898482630.html"},{"date":"2026-10-16 23:59:52","image":"","code":"202610163898771723","title":"永太科技：前三季度<em>净利润</em>同比<em>增长</em>1222%","content":"前三季度，公司实现营业收入60.74亿元，同比<em>增长</em>50.79%；归母<em>净利润</em>为4.30亿元，同比<em>增长</em>1221.81%。 　　值得注意的是，永太科技此前已连续三年出现年度亏损。2023年至2025年，公司归母<em>净利润</em>分别为-6.20亿元、-4.78亿元和-4610.06万元。","mediaName":"中国基金报","url":"http://finance.eastmoney.com/a/202610163898771723.html"},{"date":"2026-10-16 19:27:34","image":"","code":"202610163898538551","title":"卫星化学：前三季度<em>净利润</em>同比<em>增长</em>141.24%","content":"第三季度营业收入157.00亿元，同比<em>增长</em>38.81%；归属于上市公司股东的<em>净利润</em>28.32亿元，同比<em>增长</em>180.03%。小财注：公司Q3<em>净利润</em>28.32亿，Q2<em>净利润</em>41.1亿，据此计算，Q3<em>净利润</em>环比下降31%。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610163898538551.html"},{"date":"2026-10-16 21:23:34","image":"","code":"202610163898638673","title":"藏格矿<em>业</em>：前三季度<em>净利润</em>同比<em>增长</em>122.09%","content":"公司2026年前三季度实现营业收入33.2亿元，同比<em>增长</em>38.23%；实现归属于上市公司股东的<em>净利润</em>61.09亿元，同比<em>增长</em>122.09%；基本每股收益3.901元。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610163898638673.html"},{"date":"2026-10-18 20:46:00","image":"","code":"202610183899175196","title":"恒力石化：预计2026年前三季度归属于上市公司股东的<em>净利润</em>同比<em>增长</em>104.20%左右","content":"证券日报网讯10月18日，恒力石化发布2026年前三季度业绩预增公告称，公司预计2026年前三季度实现归属于上市公司股东的<em>净利润</em>1,025,575万元左右，同比<em>增长</em>104.20%左右。","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202610183899175196.html"},{"date":"2026-10-16 19:19:48","image":"","code":"202610163898533992","title":"四会富仕：前三季度<em>净利润</em>同比<em>增长</em>101.67%","content":"10月16日，四会富仕(300852.SZ)公告称，第三季度营收为8.57亿元，同比<em>增长</em>59.78%；<em>净利润</em>为1.76亿元，同比<em>增长</em>217.22%。前三季度营收为20.90亿元，同比<em>增长</em>49.68%；<em>净利润</em>为2.64亿元，同比<em>增长</em>101.67%。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610163898533992.html"},{"date":"2026-10-16 19:19:00","image":"","code":"202610163898531740","title":"卫星化学：第三季度<em>净利润</em>同比<em>增长</em>180.03%","content":"前三季度公司实现营业收入464.14亿元，同比<em>增长</em>33.49%；前三季度归属于上市公司股东的<em>净利润</em>90.59亿元，同比<em>增长</em>141.24%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/20