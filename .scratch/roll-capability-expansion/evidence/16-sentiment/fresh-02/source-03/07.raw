rollSentimentCorpus03({"bizCode":"","bizMsg":"","code":0,"extra":{},"hitsTotal":4679,"msg":"OK","result":{"cmsArticleWebOld":[{"date":"2026-10-16 15:40:37","image":"https://np-newspic.dfcfw.com/download/D25670524371759261124_w210h154.jpg","code":"202610163898376561","title":"中证协拟健全不实信息快速<em>澄清</em>机制","content":"新规拟健全不实信息快速<em>澄清</em>机制，拟提出常态化推进行业舆情正面宣传引导，系统讲好资本市场高质量发展故事。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610163898376561.html"},{"date":"2026-10-15 11:56:38","image":"","code":"202610153896654494","title":"<em>澄清</em>后热度不减！002343，5连板","content":"10月15日开盘，AI漫剧概念再度活跃，慈文传媒（002343）快速封死涨停板，走出5连板。截至午间休市，股价报8.91元，换手率持续维持高位，公司股价5个交易日累计上涨约61%，总市值达42.2亿元。板块内欢瑞世纪5天3板，掌阅科技、出版传媒、冰川网络涨幅靠前。 　　10月14日晚","mediaName":"上海证券报","url":"http://finance.eastmoney.com/a/202610153896654494.html"},{"date":"2026-10-15 14:21:22","image":"","code":"202610153896822361","title":"<em>澄清</em>后热度不减！人气牛股002343，5连板","content":"10月15日，传媒板块快速拉升，慈文传媒实现5连板，电魂网络、读者传媒涨停。 　　10月14日晚间，慈文传媒发布公告称，公司近期出品的微短剧《开标之战》投资规模较小，截至目前其所产生的归属于公司的收入约50万元，预计未来在公司整体营业收入中占比较小，不会对公司经营业绩产生较大影响。","mediaName":"华夏时报","url":"http://finance.eastmoney.com/a/202610153896822361.html"},{"date":"2026-10-13 22:30:25","image":"","code":"202610133894466533","title":"天利科技，深夜<em>澄清</em>","content":"10月13日晚间，天利科技公告称，近日，公司关注到有媒体发布了关于公司“天利科技Token工厂项目，中交基础设施养护集团中标，投标报价8.47亿元”的报道。鉴于该等不实信息容易误导投资者，公司已通过网络平台举报通道进行投诉处理。 　　公告称，经核查，截至目前，公司并未发布相关招标信息","mediaName":"中国证券报·中证金牛座","url":"http://finance.eastmoney.com/a/202610133894466533.html"},{"date":"2026-10-18 20:20:12","image":"","code":"202610183899169486","title":"吉大正元两连板触发股价异动，公司<em>澄清</em>：AI安全、低空相关<em>业</em>务暂未实现规模化营收，上半年<em>业</em>绩处于亏损状态","content":"深圳商报·读创客户端记者穆砚 　　10月18日晚间，长春吉大正元信息技术股份有限公司（以下简称“吉大正元”或“公司”）发布关于公司股票交易异常波动的公告。公告称，公司股票在10月15日、10月16日连续两个交易日涨停，两日收盘价格涨幅偏离值累计超过20%，触发股票交易异常波动情形。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610183899169486.html"},{"date":"2026-10-18 16:13:00","image":"","code":"202610183899142666","title":"吉大正元2日涨幅偏离超20%<em> </em>公司<em>澄清</em>AI安全、抗量子及低空经济<em>业</em>务收入占比较低","content":"10月18日，吉大正元（003029）发布公告，公司股票在10月15日和16日连续2个交易日，收盘价格涨幅偏离值累计超过20%。 　　2026年10月11日至12日，公司承办第23届中国信息和通信安全学术会议（CCICS2026）暨产业创新大会，围绕人工智能安全、量子计算与通信安全","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610183899142666.html"},{"date":"2026-10-13 21:26:59","image":"","code":"202610133894391089","title":"天利科技：<em>澄清</em>未发布Token工厂项目招标信息","content":"天利科技(300399.SZ)公告称，公司关注到媒体关于“天利科技Token工厂项目，中交基础设施养护集团中标，投标报价8.47亿元”的报道。经核查，公司未发布相关招标信息，不存在应披露未披露重大信息。公司提醒投资者以指定信息披露平台公告为准，并保留追究不实言论传播责任的权利。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610133894391089.html"},{"date":"2026-10-14 16:59:00","image":"","code":"202610143895524142","title":"致浩达控股：<em>澄清</em>附属公司<em>清</em>盘呈请相关公告","content":"南财智讯10月14日电，致浩达控股（01707.HK）发布内幕消息公告，公司<em>澄清</em>此前关于全资附属公司清盘呈请裁决时间延长的公告。公司表示，此前公告所述的草拟命令仅涉及将清盘呈请的裁决时间进一步延长至2027年1月5日，并不涉及清盘呈请的实质裁决。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610143895524142.html"},{"date":"2026-10-16 16:22:41","image":"","code":"202610163898671783","title":"恒生科技指数上涨1.16%，稀土永磁板块涨幅居前｜港股收评","content":"板块方面，稀土永磁板块涨幅居前，成分股中，都都控股上涨32.74%，金力永磁上涨3.06%，<em>江西铜业</em>股份上涨1.28%。 　　K12教育板块表现强势，成分股中，成实外教育上涨16.67%，光正教育上涨10.42%，新东方-S上涨5.9%。","mediaName":"21世纪经济报道","url":"http://finance.eastmoney.com/a/202610163898671783.html"},{"date":"2026-10-14 09:10:00","image":"","code":"202610143895006836","title":"天利科技<em>澄清</em>Token工厂项目招标传闻：未招标、无未披露信息、保留追责权利","content":"10月13日，天利科技（300399）发布公告，针对近期市场上关于“天利科技Token工厂项目，中交基础设施养护集团中标，投标报价8.47亿元”的传闻进行<em>澄清</em>。","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202610143895006836.html"},{"date":"2026-10-12 14:05:29","image":"","code":"202610123892580577","title":"华塑控股收购公告现修订痕迹引关注<em> </em>公司<em>澄清</em>致歉","content":"10月11日，公司发布<em>澄清</em>及致歉公告，承认系工作人员上传失误及复核环节疏漏所致，并强调修订内容不涉及敏感信息，不存在刻意隐瞒或误导市场判断的行为。 　　据了解，事件起因于近日华塑控股披露的《关于收购股权暨签署股权转让协议的进展公告》。","mediaName":"经济参考网","url":"http://finance.eastmoney.com/a/202610123892580577.html"},{"date":"2026-10-11 22:07:00","image":"","code":"202610113892120910","title":"公告带着“修订痕迹”发布，000509<em>澄清</em>并致歉","content":"同时，华塑控股在<em>澄清</em>公告中逐一解释了内容修订的原委。 　　关于对标的公司担保范围的表述，已删除内容为“标的公司担保协议所涉全部货款15443275.00元”。","mediaName":"上海证券报","url":"http://finance.eastmoney.com/a/202610113892120910.html"},{"date":"2026-10-15 13:51:10","image":"","code":"202610153896773345","title":"短期金价仍面临挑战，机构：走弱或是买入机会，低费率黄金ETF华夏（518850）震荡走低","content":"5.83%，<em>江西铜业</em>、豫光金铅、登云股份等股纷纷重挫。","mediaName":"21世纪经济报道","url":"http://stock.eastmoney.com/a/202610153896773345.html"},{"date":"2026-10-13 16:32:00","image":"","code":"202610133894189517","title":"新华文轩11个交易日8次涨停<em> </em>异动<em>澄清</em>后股价盘中振幅17%","content":"9月中旬以来，新华文轩(601811)逆势走出一波单边上涨行情，在11个交易日收获8次涨停，股价逼近10年来的峰值。 　　本轮行情启动之初，市场资金围绕出版板块并购整合预期、国资内容平台价值重估、教育数字化等逻辑炒作升温，叠加同板块个股走强带来的联动效应，资金持续涌入，推动相关个股股价接连封板","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202610133894189517.html"},{"date":"2026-10-14 07:26:04","image":"","code":"202610143894611044","title":"港股分拆上市趋热","content":"受政策利好影响，今年以来，包括<em>江西铜业</em>、海信集团、金斯瑞生物科技、信义玻璃、复星国际等多家公司推进港股分拆上市，港股分拆上市热度明显升温。（中国证券报）","mediaName":"中国证券报","url":"http://finance.eastmoney.com/a/202610143894611044.html"},{"date":"2026-10-07 15:41:08","image":"","code":"202610073888887262","title":"<em>江西铜业</em>与控股股东重签关联交易合同，三年采购预计上限超520亿元","content":"9月30日晚间，<em>江西铜业</em>(600362)发布公告称，公司与控股股东<em>江西铜业</em>集团有限公司签署三项日常关联交易协议，有效期自2027年1月1日至2029年12月31日，涉及物料供应、产品销售及土地房屋租赁等多个领域。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610073888887262.html"},{"date":"2026-10-09 21:31:40","image":"","code":"202610093891491996","title":"百亿牛股，紧急<em>澄清</em>后再度涨停，收获五连板","content":"与此同时，九阳股份<em>澄清</em>，截至10月8日，公司与华为不存在市场传闻所称的战略合作关系。公司与华为的关联主要系双方均持有深思考股权，其中华为旗下投资主体持有其部分股权。除前述情况外，公司未发现应披露而未披露的与华为相关重大合作事项。","mediaName":"中国证券报","url":"http://finance.eastmoney.com/a/202610093891491996.html"},{"date":"2026-10-09 17:13:00","image":"","code":"202610093891318891","title":"稻香控股：<em>澄清</em>购股权失效事宜","content":"董事会<em>澄清</em>，于截至2025年12月31日止财政年度内及截至2026年6月30日止六个月内，因本集团若干雇员终止雇佣关系后，上述所有分别为43万份及12万份购股权已根据购股权计划之条款自动失效，且不可再行使。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610093891318891.html"},{"date":"2026-10-11 07:15:00","image":"","code":"202610113892042087","title":"海量财经丨三柏硕：连续两个交易日涨停，紧急<em>澄清</em>公司不涉及体育赛事相关热点概念","content":"海报新闻记者毕筱涵青岛报道 　　国庆假期刚过，A股市场迎来一只体育板块异动股。 　　青岛三柏硕健康科技股份有限公司（以下简称“三柏硕”）股票在10月8日、9日连续两个交易日涨停，收盘价格涨幅偏离值累计超过20%，触发深交所股票交易异常波动标准。 　　10月9日晚，三柏硕发布异动公告","mediaName":"海报新闻","url":"http://finance.eastmoney.com/a/202610113892042087.html"},{"date":"2026-10-12 20:45:33","image":"","code":"202610123892881133","title":"覆<em>铜</em>板行<em>业</em>高景气加持，超声电子今年前三季度净利润预增超九成！9月股价异动曾两发公告<em>澄清</em>英伟达供货传闻","content":"此前9月公司股价连续大涨两度触发股票交易异常波动，多次<em>澄清</em>算力、英伟达供货相关市场传闻，10月12日公司股价出现回调，而2026年上半年公司营收增长但利润小幅下滑。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610123892881133.html"},{"date":"2026-10-09 17:01:00","image":"","code":"202610093891307967","title":"九阳股份五连板，公司发文<em>澄清</em>与华为不存在战略合作","content":"因股票交易出现异常波动，公司于10月9日披露《股票交易异常波动公告》，就市场关切的“华为/鸿蒙”“机器人/AI”等热点概念逐一<em>澄清</em>，明确截至公告披露日，公司与华为不存在市场传闻所称的战略合作关系。","mediaName":"21世纪经济报道","url":"http://finance.eastmoney.com/a/202610093891307967.html"},{"date":"2026-10-10 19:08:36","image":"","code":"202610103891956936","title":"二连板三柏硕<em>澄清</em>：主<em>业</em>未直接涉及体育赛事<em>业</em>务<em> </em>AI子公司尚处早期阶段","content":"在10月8日、9日连续两个交易日涨停后，三柏硕（001300）日前披露股票交易异常波动公告。盘面上，公司最新收盘价报14.86元/股。 　　三柏硕表示，公司前期披露的信息不存在需要更正、补充之处；公司目前经营情况正常，内外部经营环境未发生重大变化；公司未发现近期公共媒体报道了可能或已经对公司股票交易价格产生较大影响的未公开重大信息","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610103891956936.html"},{"date":"2026-10-09 20:14:43","image":"","code":"202610093891434027","title":"五个交易日连续涨停，九阳股份<em>澄清</em>与华为无相关战略合作","content":"九阳股份公告中明确<em>澄清</em>，公司目前与华为不存在市场传闻中的战略合作关系，前期涉及的科技领域相关投资，目前尚未形成实质性业务协同，也未对当前经营业绩产生重大影响，相关传闻并不属实。","mediaName":"南方都市报","url":"http://finance.eastmoney.com/a/202610093891434027.html"},{"date":"2026-10-09 18:08:48","image":"","code":"202610093891369352","title":"涨停、炸板、又涨停！<em>澄清</em>和华为关系后，002242斩获“五连板”","content":"与此同时，九阳股份<em>澄清</em>，截至2026年10月8日，公司与华为不存在市场传闻所称的战略合作关系。 　　企查查数据显示，九阳股份和华为均持有深思考股权。其中，华为通过旗下投资主体持有深思考部分股权。","mediaName":"大众证券报","url":"http://finance.eastmoney.com/a/202610093891369352.html"},{"date":"2026-10-16 11:02:00","image":"","code":"202610163898156292","title":"A股再出翻倍牛股！601811直线涨停又炸板，此前14天10板","content":"需要注意的是，新华文轩在近日发布的股票交易异常波动公告中明确表示，公司未发现需要<em>澄清</em>或回应的、可能对股价产生重大影响的媒体报道和市场传闻，也不涉及热点概念，经自查并向控股股东函证，不存在应披露而未披露的重大事项，同时提醒投资者注意二级市场交易风险。 　　来源：市场行情、公司公告","mediaName":"华夏时报","url":"http://finance.eastmoney.com/a/202610163898156292.html"},{"date":"2026-10-12 08:34:26","image":"","code":"202610123892179197","title":"收购股权进展公告现修订痕迹引关注！华塑控股<em>澄清</em>致歉：系工作人员操作及复核疏漏导致，无隐瞒行为、不影响收购交易","content":"深圳商报·读创客户端记者穆砚 　　10月11日晚间，华塑控股股份有限公司（以下简称“华塑控股”或“公司”）发布<em>澄清</em>及致歉公告。公告称，针对此前收购股权进展公告披露时留存修订痕迹、引发市场质疑一事作出回应。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610123892179197.html"},{"date":"2026-10-09 18:31:00","image":"","code":"202610093891375141","title":"资本界金控：<em>澄清</em>仅作为潜在战略投资者<em> </em>不参与华商驭马实际运营","content":"南财智讯10月9日电，资本界金控（00204.HK）发布自愿公告，公司就此前与华商驭马（杭州）机器人科技股份有限公司签订战略合作意向书作出补充公告。根据该非约束性意向书，公司仅作为潜在的战略投资者和资本市场资源协调者，不会参与华商驭马机器人相关实体业务的实际运营。目前相关讨论仍在进行中","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610093891375141.html"},{"date":"2026-10-08 16:43:05","image":"","code":"202610083889670636","title":"粤万年青发声<em>澄清</em>！董事长已报案并获受理","content":"10月7日，粤万年青（301111）发布《关于网络不实信息侵害公司及相关人员名誉的声明》称，近日，部分网络平台流传“9月28日东航MU6741航班客舱冲突事件涉事旅客为广东万年青制药股份有限公司董事长欧先涛先生”的内容，并引发关注热议。经公司核实，该内容与事实严重不符，欧先涛及公司其他员工从未乘坐该航班","mediaName":"北京商报","url":"http://finance.eastmoney.com/a/202610083889670636.html"},{"date":"2026-10-15 14:21:05","image":"","code":"202610153896817018","title":"大公报：从未发布相关内容","content":"对此，本报严正<em>澄清</em>：《大公报》从未发布过上述社交账号所述内容。针对相关账号恶意伪造《大公报》来源、散布假消息的违法行为，本报已完成证据固定，并已向涉事账号发出律师函，保留依法追究其法律责任的权利。","mediaName":"界面新闻","url":"http://piyao.eastmoney.com/a/202610153896817018.html"},{"date":"2026-10-10 00:28:05","image":"https://np-newspic.dfcfw.com/download/D24624100140882528124_w210h154.jpg","code":"202610093891587820","title":"“两连板”三柏硕急<em>澄清</em>：主<em>业</em>未直接涉及体育赛事<em>业</em>务<em> </em>AI子公司尚处早期","content":"在10月8日、9日连续两个交易日涨停后，三柏硕（SZ001300，股价14.86元，市值36亿元）于10月9日晚间发布股票交易异常波动公告。公司明确表示“未直接涉及体育赛事业务，亦不涉及本次体育赛事相关热点概念”。 　　公司未直接涉及体育赛事业务 　　据三柏硕10月9日披露的公告，","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610093891587820.html"},{"date":"2026-10-07 18:01:20","image":"","code":"202610073888910480","title":"就“东航空姐下跪”事件，301111<em>澄清</em>","content":"10月7日，广东万年青制药股份有限公司（证券简称：粤万年青，301111）发布《关于网络不实信息侵害公司及相关人员名誉的声明》称，近日，部分网络平台流传“9月28日东航MU6741航班客舱冲突事件涉事旅客为广东万年青制药股份有限公司董事长欧先涛先生”的内容，并引发关注热议。经公司核实","mediaName":"上海证券报","url":"http://finance.eastmoney.com/a/202610073888910480.html"},{"date":"2026-10-10 19:27:15","image":"","code":"202610103891960982","title":"两日涨停触发异动！丰元股份<em>澄清</em>固态电池<em>业</em>务影响：暂无实质<em>业</em>务及收益，相关布局未赋能主<em>业业</em>绩","content":"本轮股价上涨主要受固态电池概念热度带动，公司<em>澄清</em>自身主营为锂电正极材料与草酸业务，无电池生产业务及相关收入，固态电池相关布局体量较小、对业绩无实质影响。目前公司经营正常，无未披露重大事项，同时推进定增事项存在不确定性。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610103891960982.html"},{"date":"2026-10-08 22:44:00","image":"","code":"202610083890000086","title":"海量财经丨<em>澄清</em>声明发布后，宏景科技股价继续调整","content":"10月7日午间，宏景科技（301396）通过官方公众号发布严正声明称，公司关注到海外个别媒体涉及公司经营活动的相关不实报道。公司所有算力设备均通过合规商业渠道采购，公司始终严格遵守市场规则与法律法规开展业务，已建立成熟、稳定的多元化供应链体系，目前整体生产经营情况一切正常，各项业务均稳步有序推进","mediaName":"海报新闻","url":"http://finance.eastmoney.com/a/202610083890000086.html"},{"date":"2026-10-08 21:07:15","image":"","code":"202610083889888450","title":"粤万年青<em>澄清</em>董事长涉东航航班冲突不实传闻<em> </em>已报案处理","content":"10月8日，粤万年青（301111.SZ）发布公告称，公司关注到网络平台出现“9月28日东航MU6741航班客舱冲突事件涉事旅客为公司董事长欧先涛”的不实言论。经核实，公司针对上述传闻说明如下：网络流传涉及公司董事长、总裁欧先涛的相关内容均不属实，欧先涛从未乘坐该航班，上述信息系无任何事实依据的恶意捏造","mediaName":"央广财经","url":"http://finance.eastmoney.com/a/202610083889888450.html"},{"date":"2026-10-15 16:15:00","image":"","code":"202610153896933329","title":"新华文轩：连续2个交易日收盘价涨幅偏离值累超20%","content":"公司未发现需要<em>澄清</em>或回应的媒体报道或市场传闻，不涉及热点概念事项。此外，未发现公司董事、高级管理人员、控股股东在本次股票交易异常波动期间买卖公司股票的情况。公司董事会确认，没有任何应披露而未披露的事项。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610153896933329.html"},{"date":"2026-10-14 11:45:02","image":"","code":"202610143895257893","title":"天利科技辟谣：并未发布“天利科技Token工厂项目”相关招标信息，已投诉","content":"10月13日，天利科技（300399）发布<em>澄清</em>公告，针对近期市场上关于“天利科技Token工厂项目，中交基础设施养护集团中标，投标报价8.47亿元”的传闻进行<em>澄清</em>。鉴于该等不实信息容易误导投资者，公司已通过网络平台举报通道进行投诉处理。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610143895257893.html"},{"date":"2026-10-12 18:01:00","image":"","code":"202610123892775564","title":"环球友饮智能：股票继续暂停买卖","content":"南财智讯10月12日电，环球友饮智能（08496.HK）公告，公司发布<em>澄清</em>公告，对前期自愿性公告中的文书错误进行<em>澄清</em>，引述的创业板上市规则应为第17.26A条而非第17.10条。此外，公司股份已于2026年3月20日上午9时起暂停买卖，并将继续暂停买卖，直至进一步通知。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610123892775564.html"},{"date":"2026-10-08 16:45:09","image":"","code":"202610083889689076","title":"粤万年青<em>澄清</em>：董事长涉东航空姐下跪事件传闻不实","content":"【大河财立方消息】近日，东航MU6741航班客舱冲突事件引发热议，有传言称涉事旅客为广东万年青制药股份有限公司董事长欧先涛，对此，10月8日，粤万年青发布<em>澄清</em>公告，相关信息未经核实即传播扩散，引发投资者关注，已对公司及董事长本人声誉造成重大负面影响。","mediaName":"大河财立方","url":"http://finance.eastmoney.com/a/202610083889689076.html"},{"date":"2026-10-08 16:41:24","image":"","code":"202610083889672247","title":"粤万年青：<em>澄清</em>董事长欧先涛未涉东航航班冲突传闻<em> </em>已报案处理","content":"粤万年青(301111.SZ)公告称，公司关注到网络平台出现“9月28日东航MU6741航班客舱冲突事件涉事旅客为公司董事长欧先涛”的不实言论。经核实，公司针对上述传闻说明如下：网络流传涉及公司董事长、总裁欧先涛的相关内容均不属实，欧先涛从未乘坐该航班，上述信息系无任何事实依据的恶意捏造","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610083889672247.html"},{"date":"2026-10-13 21:40:28","image":"","code":"202610133894416076","title":"天利科技：公司并未发布“天利科技Token工厂项目”相关招标信息","content":"天利科技发布关于市场传闻的<em>澄清</em>公告，近日，公司关注到有媒体发布了关于公司“天利科技Token工厂项目，中交基础设施养护集团中标，投标报价8.47亿元”的报道。鉴于该等不实信息容易误导投资者，公司已通过网络平台举报通道进行投诉处理。经核查，截至目前，公司并未发布相关招标信息。","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202610133894416076.html"},{"date":"2026-10-08 20:11:54","image":"","code":"202610083889834111","title":"603928“两连板”后急发<em>澄清</em>：半导体光刻胶用酚醛树脂还在送样，尚无收入","content":"公告还指出，公司未发现需要<em>澄清</em>或回应的媒体报道或市场传闻，未发现其他可能对公司股价产生较大影响的重大事件。经核查，公司董事、高级管理人员、控股股东及其一致行动人在本次股价异常波动期间不存在买卖公司股票的情况。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610083889834111.html"},{"date":"2026-10-07 20:36:15","image":"","code":"202610073888935519","title":"粤万年青<em>澄清</em>东航客舱冲突事件相关谣言：已报案并获受理","content":"10月7日，广东万年青制药股份有限公司（简称“粤万年青”，301111.SZ）发布<em>澄清</em>声明，公司董事长与近日东航客舱冲突事件无关，已向公安机关报案并获受理。 　　9月28日东航MU6741航班客舱冲突事件持续引发关注。","mediaName":"经济参考网","url":"http://finance.eastmoney.com/a/202610073888935519.html"},{"date":"2026-10-14 21:01:00","image":"","code":"202610143895696871","title":"斩获二连板！航发科技提示风险","content":"公司未出现其他可能对公司股价产生较大影响的重大事件；未发现需要<em>澄清</em>或回应的媒体报道或市场传闻。","mediaName":"北京商报","url":"http://finance.eastmoney.com/a/202610143895696871.html"},{"date":"2026-10-09 08:46:58","image":"","code":"202610093890333961","title":"连收4个涨停、市值破百亿！九阳股份紧急<em>澄清</em>：与华为无战略合作，市盈率远超同行","content":"面对近期股价狂飙，九阳股份在10月8日晚间再度发布《股票交易异常波动公告》，对市场关注的六方面事项作出<em>澄清</em>，并提示公司市盈率水平显著高于同行业可比上市公司平均水平，敬请广大投资者注意投资风险。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610093890333961.html"},{"date":"2026-10-08 17:23:14","image":"","code":"202610083889715437","title":"粤万年青<em>澄清</em>：网传董事长涉东航航班冲突为不实信息，已报案处理","content":"粤万年青(301111)10月8日发布关于网络传闻的<em>澄清</em>公告，公司关注到部分网络平台出现“9月28日东航MU6741航班客舱冲突事件涉事旅客为广东万年青制药股份有限公司董事长欧先涛”等不实言论。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610083889715437.html"},{"date":"2026-10-08 16:44:00","image":"","code":"202610083889678922","title":"粤万年青：<em>澄清</em>网络传闻，公司董事长欧先涛未涉东航航班客舱冲突事件","content":"南财智讯10月8日电，粤万年青公告，近日，公司关注到部分网络平台出现“9月28日东航MU6741航班客舱冲突事件涉事旅客为公司董事长欧先涛先生”等不实言论。经核实，网络流传涉及公司董事长、总裁欧先涛先生的相关内容均不属实，欧先涛先生从未乘坐该航班，上述信息系无任何事实依据的恶意捏造","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610083889678922.html"},{"date":"2026-10-15 16:18:04","image":"","code":"202610153896935151","title":"网传“李嘉诚去世”，长实集团：绝无此事；工作人员：李嘉诚暂不打算公开露面","content":"对此，本报严正<em>澄清</em>：《大公报》从未发布过上述社交账号所述内容。 　　针对相关账号恶意伪造《大公报》来源、散布假消息的违法行为，本报已完成证据固定，并已向涉事账号发出律师函，保留依法追究其法律责任的权利。","mediaName":"上观新闻","url":"http://finance.eastmoney.com/a/202610153896935151.html"},{"date":"2026-10-15 15:19:00","image":"https://np-newspic.dfcfw.com/download/D24624100140882528124_w210h154.jpg","code":"202610153896876097","title":"长实集团就“李嘉诚去世”传闻发声：其暂不打算公开露面回应","content":"对此，《大公报》严正<em>澄清</em>：从未发布过上述社交账号所述内容。针对相关账号恶意伪造《大公报》来源、散布假消息的违法行为，《大公报》已完成证据固定，并已向涉事账号发出律师函，保留依法追究其法律责任的权利。","mediaName":"南方都市报","url":"http://finance.eastmoney.com/a/202610153896876097.html"},{"date":"2026-10-18 19:10:00","image":"","code":"202610183899211090","title":"重磅！周末突发大事件","content":"中证协拟健全不实信息快速<em>澄清</em>机制 　　记者获悉，中证协已起草形成《关于进一步深化证券行业文化建设工作的意见》，正向券商征意中。新规拟健全不实信息快速<em>澄清</em>机制，拟提出常态化推进行业舆情正面宣传引导，系统讲好资本市场高质量发展故事。","mediaName":"东方财富Choice数据","url":"http://finance.eastmoney.com/a/202610183899211090.html"},{"date":"2026-10-14 18:52:00","image":"","code":"202610143895606678","title":"航发科技：连续2个交易日收盘价涨幅偏离值累超20%","content":"经公司自查并向控股股东、实际控制人核实，公司日常经营情况正常，市场环境、行业政策不存在重大调整；截至公告披露日，公司及控股股东、实际控制人不存在应披露而未披露的重大信息，未筹划重大资产重组、股份发行、收购等重大事项；公司未出现其他可能对股价产生较大影响的重大事件，未发现需要<em>澄清</em>或回应的媒体报道或市场传闻","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610143895606678.html"},{"date":"2026-10-12 17:25:20","image":"","code":"202610123892761011","title":"资源硬、造血强<em> </em>沪市有色龙头夯实资本市场发展韧性根基","content":"<em>江西铜业</em>则体现出传统资源龙头较强的经营弹性。2026年上半年，公司实现营业收入3071.55亿元，同比增长19.53%；归母净利润86.32亿元，同比增长106.77%；经营活动产生的现金流量净额58.14亿元，同比增长102.49%。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610123892761011.html"},{"date":"2026-10-18 08:37:00","image":"","code":"202610183899103634","title":"人民日报评演唱会票被炒至25万：整治天价黄牛票，光实名制还不够","content":"虽然售票平台随后<em>澄清</em>，该天价票是黄牛在无票源情况下恶意炒作，但随着演艺市场火热，黄牛加价代抢热门演唱会门票、高价售卖所谓的“内场票”等现象屡见不鲜。有些黄牛票票价高出原票价数倍，动辄上万元。 　　为整治演艺市场黄牛倒票等不法行为，国家已出台相关措施。","mediaName":"蓝鲸新闻","url":"http://finance.eastmoney.com/a/202610183899103634.html"},{"date":"2026-10-18 08:09:49","image":"https://np-newspic.dfcfw.com/download/D25254132287913907087_w210h154.jpg","code":"202610183899098411","title":"人民日报评演唱会票被炒至25万：整治天价黄牛票<em> </em>光实名制还不够","content":"虽然售票平台随后<em>澄清</em>，该天价票是黄牛在无票源情况下恶意炒作，但随着演艺市场火热，黄牛加价代抢热门演唱会门票、高价售卖所谓的“内场票”等现象屡见不鲜。有些黄牛票票价高出原票价数倍，动辄上万元。 　　为整治演艺市场黄牛倒票等不法行为，国家已出台相关措施。","mediaName":"新京报","url":"http://finance.eastmoney.com/a/202610183899098411.html"},{"date":"2026-10-12 07:01:48","image":"","code":"202610123892153810","title":"伊朗称美国已接受伊方就重开霍尔木兹海峡所提部分条件","content":"他强调，美方必须<em>澄清</em>一些模糊之处，伊朗需要观察美方能否消除伊方疑虑，以便展开后续工作。（央视新闻）","mediaName":"央视新闻","url":"http://finance.eastmoney.com/a/202610123892153810.html"},{"date":"2026-10-13 08:33:05","image":"","code":"202610133893371737","title":"“汇源”商标侵权及不正当竞争纠纷案一审判决：侵权企<em>业</em>赔偿9700余万元","content":"汇源”字号：判令北京汇源集团开封有限公司、北京汇源生物科技有限公司立即停止在企业名称中使用“汇源”字号，从企业主体身份层面彻底消除市场混淆根源，否定侵权企业使用“汇源”字号的合法性； 　　2.立即停止侵权行为：全面停止生产、销售涉案侵权产品，阻止侵权商品继续流向市场； 　　3.公开<em>澄清</em>消除影响","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610133893371737.html"},{"date":"2026-10-17 09:35:58","image":"","code":"202610173899023486","title":"人民锐评：纸尿裤风波落地，照见维护公众安全感的启示","content":"以权威调查回应热点质疑，以科学验证<em>澄清</em>谬误，以实际行动解决急难愁盼，快速响应、协同处置、环环相扣，这样一种“回应型治理”既是政府履职尽责的应有之义，也是激发社会自净机制的关键一步。 　　由此再看日前工业和信息化部等三部门针对有关车辆刹车踏板支架断裂问题的联合调查启动。","mediaName":"人民日报","url":"http://finance.eastmoney.com/a/202610173899023486.html"},{"date":"2026-10-12 13:02:24","image":"","code":"202610123892532482","title":"逆变器板块午后再度拉升<em> </em>首航新能涨超10%","content":"消息面上，中欧贸易投资磋商机制第二次例会日前召开，欧方<em>澄清</em>，欧盟对逆变器项目的融资指导文件不针对特定国家，双方将就该问题进一步磋商。","mediaName":"东方财富Choice数据","url":"http://finance.eastmoney.com/a/202610123892532482.html"},{"date":"2026-10-12 14:10:00","image":"","code":"202610123892597889","title":"直线拉升！301658，午后涨停！","content":"消息面上，中欧贸易投资磋商机制第二次例会日前召开，欧方<em>澄清</em>，欧盟对逆变器项目的融资指导文件不针对特定国家，双方将就该问题进一步磋商。","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202610123892597889.html"},{"date":"2026-10-12 16:40:16","image":"","code":"202610123892717332","title":"蓝筹价值观察：从沪市有色行<em>业</em>看资本市场韧性根基","content":"<em>江西铜业</em>实现营业收入3071.55亿元，同比增长19.53%；归母净利润86.32亿元，同比增长106.77%；经营活动产生的现金流量净额58.14亿元，同比增长102.49%。","mediaName":"央广财经","url":"http://finance.eastmoney.com/a/202610123892717332.html"},{"date":"2026-10-16 14:55:26","image":"","code":"202610163898361863","title":"胡锡进解读三部门联合调查刹车踏板支架断裂问题：只有这两种可能","content":"最后他直言，三部门牵头开展的这次联合调查，首先要做的就是针对懂车帝的测评是否客观真实做出一锤定音的权威结论，把整个事件的基本事实彻底<em>澄清</em>。","mediaName":"快科技","url":"http://finance.eastmoney.com/a/202610163898361863.html"},{"date":"2026-10-12 15:27:49","image":"","code":"202610123892657713","title":"今日投资舆情热点","content":"3）逆变器：中欧贸易投资磋商机制第二次例会日前召开，欧方<em>澄清</em>，欧盟对逆变器项目的融资指导文件不针对特定国家，双方将就该问题进一步磋商。 4）半导体设备：ASML将统一上调在韩国供应的设备替换零部件价格，涵盖EUV及DUV光刻机的全部零部件。","mediaName":"财联社","url":"http://stock.eastmoney.com/a/202610123892657713.html"},{"date":"2026-10-15 15:17:14","image":"","code":"202610153896887364","title":"圆通总裁潘水苗，有新职！","content":"此前，潘天鸿曾在视频中聊过自己的家庭背景，并<em>澄清</em>相关传闻。潘天鸿还曾回应“我的圆通快递丢了，能找你投诉吗？”的玩梗话题，并邀请自己的父亲视频出镜。 　　潘水苗在视频中称：“我是圆通速递的总裁，其实不是圆通的老板，我是一个职业经理人，大家找Tim也没用。”","mediaName":"中国基金报","url":"http://finance.eastmoney.com/a/202610153896887364.html"},{"date":"2026-10-15 21:47:00","image":"","code":"202610153897194569","title":"10连板牛股，核查完成，明起复牌","content":"公告显示，经核查，公司目前生产经营正常，内外部经营环境未发生重大变化，主营业务未发生变化；未发现对公司股票交易价格产生重大影响的需要<em>澄清</em>或回应的媒体报道或市场传闻，亦未涉及市场热点概念。","mediaName":"中国证券报","url":"http://finance.eastmoney.com/a/202610153897194569.html"},{"date":"2026-10-11 17:00:47","image":"","code":"202610113892073194","title":"收购股权进展公告出现修订痕迹，华塑控股致歉称不存在刻意隐瞒或误导市场行为","content":"北京商报讯10月11日，华塑控股（000509）发布<em>澄清</em>及致歉公告显示，近日公司披露的《关于收购股权暨签署股权转让协议的进展公告》带有修订痕迹，系工作人员上传公告时未将公告文件从“修订”下的“最终状态”调整为“接受对文档所做的所有修订”，复核人员未将版本修订状态纳入复核范围所致。","mediaName":"北京商报","url":"http://finance.eastmoney.com/a/202610113892073194.html"},{"date":"2026-10-12 17:37:00","image":"","code":"202610123892765249","title":"新华文轩：连续2个交易日收盘价涨幅偏离值累超20%","content":"经公司自查并向控股股东核实，公司经营情况正常，市场环境或行业政策未发生重大调整；控股股东及实际控制人不存在应披露而未披露的重大事项；公司未发现需要<em>澄清</em>的媒体报道或市场传闻，不涉及热点概念；董事、高级管理人员及控股股东在异常波动期间未买卖公司股票。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202610123892765249.html"},{"date":"2026-10-12 01:20:34","image":"","code":"202610123892135567","title":"伊朗高官称美国回应不够充分","content":"据伊朗媒体当地时间10月11日晚报道，伊朗最高国家安全委员会秘书雷扎伊表示，美国针对伊朗提出的重开霍尔木兹海峡的条件所作出的回应“不够充分”，需要就伊朗仍存疑虑的问题作出<em>澄清</em>。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610123892135567.html"},{"date":"2026-10-12 16:42:00","image":"","code":"202610123892720196","title":"有色金属行<em>业</em>资金流出榜：云南锗<em>业</em>等10股净流出资金超亿元","content":"000657 中钨高新 -5.46 2.20 -16200.99 002466 天齐锂业 -5.17 2.38 -15842.87 001246 C力勤 -13.43 37.89 -13102.89 600111 北方稀土 -0.46 0.91 -12609.43 600362 <em>江西铜业</em>","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202610123892720196.html"},{"date":"2026-10-12 21:36:00","image":"","code":"202610123892967415","title":"香港证监会将修订上市规则<em> </em>预计2027年一季度生效","content":"就IPO个案而言，香港证监会将会审阅所有上市申请，如果香港证监会认为或有理由根据《证券市场上市规则》第6（2）条提出反对，但需要申请人作出进一步<em>澄清</em>。","mediaName":"证券日报","url":"http://hk.eastmoney.com/a/202610123892967415.html"},{"date":"2026-10-11 16:14:02","image":"","code":"202610113892062892","title":"华塑控股致歉：近日披露的收购股权进展公告因工作人员上传失误出现修订痕迹<em> </em>不存在刻意隐瞒或误导市场行为","content":"华塑控股(000509.SZ)公告称，公司<em>澄清</em>，近日披露的收购股权进展公告因工作人员上传失误出现修订痕迹，修订版与最终正式版内容完全一致，不涉及敏感或应予保密内容。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610113892062892.html"},{"date":"2026-10-13 08:36:00","image":"https://np-newspic.dfcfw.com/download/D24852546020637928245_w210h154.jpg","code":"202610133893322432","title":"科技日报：新质生产力不应成为资本炒作噱头！","content":"面对脱离实际的市场行情，企业不得不发布风险提示，<em>澄清</em>业务现状。 　　新质生产力领域资本泡沫潜藏多重风险。","mediaName":"科技日报","url":"http://finance.eastmoney.com/a/202610133893322432.html"},{"date":"2026-10-12 22:32:15","image":"","code":"202610123892975134","title":"资源禀赋构筑供给壁垒<em> </em>新兴产<em>业</em>打开长期需求<em> </em>沪市有色龙头“家底”有多厚？","content":"<em>江西铜业</em>（SH600362，股价41.29元，市值1430亿元）则体现出传统资源龙头较强的经营弹性。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610123892975134.html"},{"date":"2026-10-12 18:21:00","image":"","code":"202610123892794920","title":"从周期资源到战略资源<em> </em>沪市有色行<em>业</em>经营韧性与长期价值凸显","content":"<em>江西铜业</em>、紫金矿业、洛阳钼业等沪市主板龙头拥有从资源端到冶炼加工端的积累，在全球铜资源战略价值提升背景下，具有较高的行业壁垒。 　　铝产业的应用边界同样不断拓宽。新能源汽车轻量化、光伏、新型电力系统、高端装备等领域持续打开高端铝材需求空间。","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202610123892794920.html"},{"date":"2026-10-11 16:19:56","image":"","code":"202610113892067630","title":"华塑控股致歉：收购股权进展公告因工作人员上传失误出现修订痕迹<em> </em>不存在刻意隐瞒或误导市场行为","content":"10月11日，华塑控股发布<em>澄清</em>公告，近日披露的收购股权进展公告因工作人员上传失误出现修订痕迹，修订版与最终正式版内容完全一致，不涉及敏感或应予保密内容。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610113892067630.html"},{"date":"2026-10-12 22:26:00","image":"","code":"202610123892970218","title":"新华传媒：累计10个交易日涨停<em> </em>13日起停牌核查","content":"经公司核实，公司未发现对公司股票交易价格产生重大影响的需要<em>澄清</em>或回应的媒体报道或市场传闻，亦未涉及市场热点概念。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202610123892970218.html"},{"date":"2026-10-17 11:06:21","image":"","code":"202610173899022441","title":"人民日报评“纸尿裤风波”：网络测评不可儿戏，部分自媒体测评简化实验逻辑，隐去检测方法缺陷，将公众焦虑变成变现工具","content":"以权威调查回应热点质疑，以科学验证<em>澄清</em>谬误，以实际行动解决急难愁盼，快速响应、协同处置、环环相扣，这样一种“回应型治理”既是政府履职尽责的应有之义，也是激发社会自净机制的关键一步。 　　由此再看日前工信部等三部门针对有关车辆刹车踏板支架断裂问题的联合调查启动。","mediaName":"中新经纬","url":"http://finance.eastmoney.com/a/202610173899022441.html"},{"date":"2026-10-16 20:28:59","image":"","code":"202610163898704569","title":"“向彼、向实、向未来”<em> </em>评中欧贸易投资磋商机制第二次例会成果","content":"第9条针对的欧方有关逆变器项目的融资指导文件，直接关系中国新能源企业对欧投资与供应链布局，欧方“不针对特定国家”的<em>澄清</em>，等于为这类投资扫除了一项不确定性。 　　二是中国商品进入欧盟市场的需求。","mediaName":"中国新闻网","url":"http://finance.eastmoney.com/a/202610163898704569.html"},{"date":"2026-10-12 05:10:43","image":"","code":"202610123892142939","title":"伊朗称美国对其重开霍尔木兹海峡条件回应不充分","content":"据伊朗方面当地时间10月11日晚消息，伊朗最高国家安全委员会秘书雷扎伊表示，美国针对伊朗提出的重开霍尔木兹海峡条件所作出的回应“不够充分”，并要求美方就伊朗仍存疑虑的问题作出<em>澄清</em>。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610123892142939.html"},{"date":"2026-10-12 01:25:19","image":"","code":"202610123892135482","title":"伊朗高官称美国回应不够充分","content":"据伊朗媒体当地时间10月11日晚报道，伊朗最高国家安全委员会秘书雷扎伊表示，美国针对伊朗提出的重开霍尔木兹海峡的条件所作出的回应“不够充分”，需要就伊朗仍存疑虑的问题作出<em>澄清</em>。","mediaName":"CCTV国际时讯","url":"http://finance.eastmoney.com/a/202610123892135482.html"},{"date":"2026-10-12 22:24:00","image":"","code":"202610123892988617","title":"家底厚、造血强<em> </em>沪市有色龙头经营韧性与长期价值凸显","content":"<em>江西铜业</em>、紫金矿业、洛阳钼业等沪市主板龙头拥有从资源端到冶炼加工端的积累，在全球铜资源战略价值提升背景下，具有较高的行业壁垒。 　　铝产业的应用边界同样不断拓宽。新能源汽车轻量化、光伏、新型电力系统、高端装备等领域持续打开高端铝材需求空间。","mediaName":"中国证券报·中证网","url":"http://finance.eastmoney.com/a/202610123892988617.html"},{"date":"2026-10-16 20:17:04","image":"","code":"202610163898704856","title":"美国即将上岛大规模勘探？格陵兰安全协议搅动北极地缘博弈","content":"10月14日，美国总统特朗普称将在格陵兰开展大规模油气与矿产勘探，格陵兰自治政府与丹麦外交部旋即<em>澄清</em>，美方并不享有资源开发特权，所谓大规模开采短期内难以落地。","mediaName":"上观新闻","url":"http://finance.eastmoney.com/a/202610163898704856.html"},{"date":"2026-10-12 20:54:16","image":"","code":"202610123892933961","title":"沪市主板有色龙头夯实“硬家底”，盈利与现金流韧性显现","content":"<em>江西铜业</em>则体现出传统资源龙头较强的经营弹性。","mediaName":"大河财立方","url":"http://finance.eastmoney.com/a/202610123892933961.html"},{"date":"2026-10-12 19:39:20","image":"","code":"202610123892854641","title":"从周期资源迈向战略资源<em> </em>沪市有色行<em>业</em>长期价值凸显","content":"<em>江西铜业</em>(600362.SH)、紫金矿业、洛阳钼业等沪市主板龙头拥有从资源端到冶炼加工端的深厚积累，在全球铜资源战略价值提升背景下，其优质矿产资源和成熟产能具有较高进入壁垒。 　　铝产业的应用边界同样不断拓宽。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610123892854641.html"},{"date":"2026-10-12 17:37:39","image":"","code":"202610123892755621","title":"香港证监会将加强具针对性的工具以打击首次公开招股相关的失当行为及其他企<em>业</em>失当行为","content":"鉴于市场于咨询期内普遍支持修订《证券市场上市规则》的建议，香港证监会将因应回应者的意见，对有关建议作出若干<em>澄清</em>及轻微修改，然后予以落实。视乎立法程序的进度而定，香港证监会现时预期经修订的《证券市场上市规则》及对《证券及期货条例》的相关修订将于2027年第一季生效。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202610123892755621.html"},{"date":"2026-10-12 17:36:43","image":"","code":"202610123893019079","title":"香港证监会将加强具针对性的工具以打击首次公开招股相关的失当行为及其他企<em>业</em>失当行为","content":"鉴于市场于咨询期内普遍支持修订《证券市场上市规则》的建议，香港证监会将因应回应者的意见，对有关建议作出若干<em>澄清</em>及轻微修改，然后予以落实。视乎立法程序的进度而定，香港证监会现时预期经修订的《证券市场上市规则》及对《证券及期货条例》的相关修订将于2027年第一季生效。","mediaName":"界面新闻","url":"http://hk.eastmoney.com/a/202610123893019079.html"},{"date":"2026-10-12 10:34:54","image":"","code":"202610123892707152","title":"伊朗：美国已接受伊方所提部分条件但“不充分”","content":"综合伊朗新闻电视台、路透社等媒体消息，雷扎伊表示，美国同意了伊朗七项条件中的一部分，但就伊朗提出的其他条件，目前情况尚不明朗，美方必须<em>澄清</em>那些对伊朗而言尚不明确的问题。 　　雷扎伊透露，过去两个月里，美方通过巴基斯坦、卡塔尔、伊拉克三个不同渠道，要求伊朗提出提议。","mediaName":"中国新闻网","url":"http://finance.eastmoney.com/a/202610123892707152.html"},{"date":"2026-10-18 14:30:38","image":"https://np-newspic.dfcfw.com/download/D25366268097437166449_w210h154.jpg","code":"202610183899123734","title":"周末要闻汇总：深化拓展“人工智能+”<em> </em>国常会最新部署","content":"中证协拟健全不实信息快速<em>澄清</em>机制 　　记者获悉，中证协已起草形成《关于进一步深化证券行业文化建设工作的意见》，正向券商征意中。新规拟健全不实信息快速<em>澄清</em>机制，拟提出常态化推进行业舆情正面宣传引导，系统讲好资本市场高质量发展故事。","mediaName":"东方财富Choice数据","url":"http://finance.eastmoney.com/a/202610183899123734.html"},{"date":"2026-10-14 07:29:42","image":"","code":"202610143894713025","title":"香港证监会将修订规则！打击IPO失当行为","content":"鉴于市场于咨询期内普遍支持修订《证券市场上市规则》的建议，证监会将因应回应者的意见，对有关建议作出若干<em>澄清</em>及轻微修改，然后予以落实。视乎立法程序的进度而定，证监会现时预期经修订的《证券市场上市规则》及对《证券及期货条例》的相关修订将于2027年第一季生效。","mediaName":"大河财立方","url":"http://finance.eastmoney.com/a/202610143894713025.html"},{"date":"2026-10-15 10:40:00","image":"","code":"202610153896617651","title":"茶百道深陷IPO操纵疑云<em> </em>遭遇恒指火速剔除","content":"茶百道紧急应对：寻求法律意见与力证运营正常 　　表态尊重监管并全力配合调查 　　针对监管停牌通令，茶百道在港交所火速刊发<em>澄清</em>与应对公告。公司董事会强调，已注意到香港证监会对公司IPO阶段可能存在人为操纵以营造虚假需求的关切。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202610153896617651.html"},{"date":"2026-10-10 11:42:15","image":"","code":"202610103891874620","title":"美国中期选举遭遇“反数据中心”浪潮，近1万亿美元项目受阻；普京与特朗普通话90分钟细节曝光；OpenAI<em>澄清</em>将达700亿美元年化收入；美国国债攀升至41万亿美元<em> </em>|<em> </em>一周国际财经","content":"随后OpenAI方面<em>澄清</em>。这一表态导纳斯达克指数周五收复失地，周内基本收平。 　　本周，标普500指数报7811.54.72点，本周累涨1.15%。道指报51654.95点，本周累涨0.03%。纳指报27366.17点，本周累涨0.64%。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610103891874620.html"},{"date":"2026-09-30 17:48:20","image":"","code":"202609303887800680","title":"<em>江西铜业</em>：拟与控股股东签订2027-2029年度日常关联交易合同","content":"<em>江西铜业</em>(600362.SH)公告称，公司与控股股东江铜集团签订有效期自2027年1月1日至2029年12月31日的《综合供应及服务合同Ⅰ》《综合供应及服务合同Ⅱ》及《土地使用权和房屋租赁协议》。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202609303887800680.html"},{"date":"2026-10-14 09:01:05","image":"","code":"202610143894894261","title":"茶百道因涉嫌IPO操纵，被香港证监会暂停股份交易丨港股早报","content":"受政策利好影响，今年以来，包括<em>江西铜业</em>、海信集团、金斯瑞生物科技、信义玻璃、复星国际等多家公司推进港股分拆上市，港股分拆上市热度明显升温。","mediaName":"21世纪经济报道","url":"http://hk.eastmoney.com/a/202610143894894261.html"},{"date":"2026-10-09 18:31:57","image":"","code":"202610093891362631","title":"晚报丨特朗普称不会在中期选举前攻击伊朗；据悉苹果因需求疲软削减iPhone<em> </em>18<em> </em>Pro订单；美国光通信龙头称2029年初的产能也已售罄；OpenAI<em>澄清</em>年化营收：年底目标700亿美元；SK海力士押注需求增长","content":"OpenAI<em>澄清</em>年化营收：截至9月底约500亿美元，年底目标700亿美元 　　OpenAI年化收入与市场此前流传的数字相差约200亿美元，引发投资者对AI需求增长前景的担忧，并拖累美股科技板块周四走弱。","mediaName":"哈富证券","url":"http://hk.eastmoney.com/a/202610093891362631.html"},{"date":"2026-10-14 07:24:48","image":"","code":"202610143894571895","title":"港股分拆上市趋热：三种路径、双重定价、一场考验","content":"受政策利好影响，今年以来，包括<em>江西铜业</em>、海信集团、金斯瑞生物科技、信义玻璃、复星国际等多家公司推进港股分拆上市，港股分拆上市热度明显升温。 　　分拆路径各有不同 　　一般而言，在港股分拆上市有募资型IPO分拆、“实物分派+介绍上市”以及“实物分派+全球发售”三种主要形式。","mediaName":"中国证券报","url":"http://finance.eastmoney.com/a/202610143894571895.html"},{"date":"2026-10-14 13:32:25","image":"","code":"202610143895294544","title":"被字节开除的田柯宇回应“模型投毒”：看不惯新来实习生随意停掉他人程序<em> </em>组内领导也不干涉<em> </em>选择“以暴制暴”","content":"字节官方曾对外<em>澄清</em>，网传事件波及8000张GPU卡、造成上千万美元损失的说法严重夸大，受影响项目仅为商业化技术团队内部研究任务，并未影响字节线上业务和主力大模型项目。","mediaName":"海报新闻","url":"http://finance.eastmoney.com/a/202610143895294544.html"},{"date":"2026-10-12 06:28:20","image":"","code":"202610123892150196","title":"伊朗称美国已接受伊方所提部分条件","content":"他强调，美方必须<em>澄清</em>一些模糊之处，伊朗需要观察美方能否消除伊方疑虑，以便展开后续工作。 　　雷扎伊称，如果美国再次对伊朗发动侵略，美在西亚地区的资产，包括关键数据系统和人工智能设施，将成为打击目标。伊朗已准备好在战火重燃时展示新的军事能力。","mediaName":"新华网","url":"http://finance.eastmoney.com/a/202610123892150196.html"},{"date":"2026-10-16 07:17:32","image":"","code":"202610163897371760","title":"A股老牌黄金珠宝商，锁定退市","content":"对此，*ST萃华曾<em>澄清</em>，公司目前无正在筹划中的并购重组或实际控制权变更事宜，未来三个月内公司亦无并购重组计划或实际控制权变更计划。 　　最新公告显示，*ST萃华股票终止上市后，将转入全国股转公司代为管理的退市板块进行转让。","mediaName":"券商中国","url":"http://finance.eastmoney.com/a/202610163897371760.html"},{"date":"2026-10-12 19:52:04","image":"","code":"202610123892862034","title":"十连板大牛股，明起停牌核查","content":"经公司核实，公司未发现对公司股票交易价格产生重大影响的需要<em>澄清</em>或回应的媒体报道或市场传闻，亦未涉及市场热点概念；公司控股股东及其一致行动人及公司董事、高级管理人员在公司本次股票交易异常波动期间不存在买卖公司股票的情况。","mediaName":"上海证券报","url":"http://finance.eastmoney.com/a/202610123892862034.html"},{"date":"2026-10-11 18:46:06","image":"","code":"202610113892096717","title":"收购公告“带修订痕迹”引发猜测，华塑控股回应","content":"华塑控股（SZ000509，股价3.42元，市值36.70亿元）10月11日晚间发布<em>澄清</em>及致歉公告，就此前披露的《关于收购股权暨签署股权转让协议的进展公告》PDF版本流出修订痕迹一事作出回应。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610113892096717.html"},{"date":"2026-10-12 06:54:58","image":"","code":"202610123892155065","title":"伊朗：美国接受伊方所提部分条件，但其回应“不够充分”","content":"他强调，美方必须<em>澄清</em>一些模糊之处，伊朗需要观察美方能否消除伊方疑虑，以便展开后续工作。 　　雷扎伊称，伊朗已准备好在战火重燃时展示新的军事能力。“如今，我们已做好充分准备，一旦战火重燃，我们将向战场投入新的作战能力，”他补充道。","mediaName":"中国新闻网","url":"http://finance.eastmoney.com/a/202610123892155065.html"},{"date":"2026-10-15 20:29:27","image":"","code":"202610153897133980","title":"002731，终止上市！","content":"对此，*ST萃华曾<em>澄清</em>，公司目前无正在筹划中的并购重组或实际控制权变更事宜，未来三个月内公司亦无并购重组计划或实际控制权变更计划。 　　最新公告显示，*ST萃华股票终止上市后，将转入全国股转公司代为管理的退市板块进行转让。","mediaName":"证券时报","url":"http://finance.eastmoney.com/a/202610153897133980.html"}]},"searchId":"297ae1ff-0caf-424e-90e6-af04a13addb1"})