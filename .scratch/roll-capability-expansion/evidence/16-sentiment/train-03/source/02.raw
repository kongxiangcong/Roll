rollTrain03({"bizCode":"","bizMsg":"","code":0,"extra":{},"hitsTotal":16,"msg":"OK","result":{"cmsArticleWebOld":[{"date":"2026-09-25 17:31:04","image":"","code":"202609253884296444","title":"贝莱德在<em>江西铜业股份</em>的H<em>股</em>好仓比例下降0.99%至4.31%","content":"南财智讯9月25日电，香港交易所披露信息显示，BlackRock,Inc.（贝莱德）在江西铜业股份的H股好仓（L）比例于9月22日从5.30%下降至4.31%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202609253884296444.html"},{"date":"2026-09-23 17:19:00","image":"","code":"202609233882507346","title":"贝莱德在<em>江西铜业股份</em>的H<em>股</em>好仓比例上升0.38%至5.21%","content":"南财智讯9月23日电，香港交易所披露信息显示，BlackRock,Inc.（贝莱德）在江西铜业股份的H股好仓（L）比例于9月18日从4.83%上升至5.21%。同时淡仓（S）比例从0.49%降至0.46%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202609233882507346.html"},{"date":"2026-09-11 11:52:56","image":"","code":"202609113871913877","title":"港<em>股</em>异动 | 港<em>股</em>有色金属板块集体走弱 <em>江西铜业股份</em>、洛阳钼<em>业</em>均跌超10%","content":"上证报中国证券网讯（记者何治民）9月11日，港股有色金属板块集体走弱，截至11时03分，江西铜业股份、洛阳钼业、五矿资源大跌超10%，中国大冶有色金属、中国有色矿业、天齐锂业、紫金矿业跌超7%，赣锋锂业、中国铝业跟跌。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202609113871913877.html"},{"date":"2026-09-08 17:26:56","image":"","code":"202609083868128984","title":"贝莱德在<em>江西铜业股份</em>的H<em>股</em>好仓比例上升0.05%至5.03%","content":"南财智讯9月8日电，香港交易所披露信息显示，BlackRock,Inc.（贝莱德）在江西铜业股份的H股好仓（L）比例于9月3日从4.98%上升至5.03%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202609083868128984.html"},{"date":"2026-09-02 17:28:00","image":"","code":"202609023862844038","title":"摩根大通在<em>江西铜业股份</em>的H<em>股</em>好仓比例下降0.13%至5.88%","content":"南财智讯9月2日电，香港交易所披露信息显示，JPMorganChase&Co.（摩根大通）在江西铜业股份的H股好仓（L）比例于8月27日从6.01%下降至5.88%。同时淡仓（S）比例从1.90%降至1.77%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202609023862844038.html"},{"date":"2026-09-01 17:18:00","image":"","code":"202609013861549243","title":"摩根大通在<em>江西铜业股份</em>的H<em>股</em>好仓比例上升0.21%至6.01%","content":"南财智讯9月1日电，香港交易所披露信息显示，JPMorganChase&Co.（摩根大通）在江西铜业股份的H股好仓（L）比例于8月26日从5.80%上升至6.01%。同时淡仓（S）比例从1.69%升至1.90%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202609013861549243.html"},{"date":"2026-08-25 22:14:00","image":"","code":"202608253853369445","title":"<em>江西铜业股份</em>：上半财年净利润同比增长106.77%","content":"南财智讯8月25日电，江西铜业股份（00358.HK）公告，公司截至2026年6月30日止六个月（上半财年）实现营业收入3071.55亿元，同比增长；归属于上市公司股东的净利润86.32亿元，同比增长106.77%；基本每股收益2.50元。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202608253853369445.html"},{"date":"2026-08-26 17:09:30","image":"","code":"202608263854666351","title":"美银证券：升<em>江西铜业股份</em>目标价至50港元 中期纯利远超预期","content":"美银证券发布研报称，将江西铜业股份目标价由43港元上调16%至50港元，A股目标价由55元人民币上调11%至61元人民币，维持“买入”评级。该行上调江西铜业2026及2027年纯利预测37%及46%，至各136亿及154亿元人民币，看好韧性的铜价及硫酸价格、联营公司盈利潜在上行、估值吸引及铜箔业务在人工智能需求加速下潜在重估空间","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202608263854666351.html"},{"date":"2026-08-25 23:29:22","image":"","code":"202608253853438950","title":"<em>江西铜业股份</em>：上半年归母净利润88.97亿元 同比增长99.91%","content":"8月25日，江西铜业股份在港交所公告，2026年上半年营收3058.54亿元，同比增长19.46%；归属于母公司的期内溢利88.97亿元，同比增长99.91%；调整后基本每股盈利2.58元。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202608253853438950.html"},{"date":"2026-07-29 18:39:00","image":"","code":"202607293825229482","title":"<em>江西铜业股份</em>完成发行25亿元中期票据","content":"新京报贝壳财经讯 7月29日，江西铜业股份(00358)发布公告，2026年6月，公司收到交易商协会的《接受注册通知书》(中市协注〔2026〕MTN480号)，交易商协会决定接受公司中期票据注册，注册金额为70亿元，注册额度自通知书落款之日(2026年6月15日)起2年内有效。近日","mediaName":"新京报","url":"http://finance.eastmoney.com/a/202607293825229482.html"},{"date":"2026-07-07 21:48:00","image":"","code":"202607073797039539","title":"<em>江西铜业股份</em>：董事长郑高清辞任","content":"南财智讯7月7日电，江西铜业股份（00358.HK）公告，公司董事会于2026年7月7日收到执行董事郑高清先生递交的书面辞任函。因到法定退休年龄，郑高清先生辞去董事长、执行董事、提名委员会主席及环境、社会及管治发展委员会主席职务，不再担任公司任何职务。其辞任自送达董事会之日起生效，","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202607073797039539.html"},{"date":"2026-05-07 09:42:31","image":"","code":"202605073729705211","title":"港<em>股江西铜业股份</em>一度涨超3%","content":"5月7日，江西铜业股份(00358.HK)一度涨超3%，截至发稿涨2.98%，报38.68港元，成交额8044.23万港元。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202605073729705211.html"},{"date":"2026-05-05 09:49:00","image":"","code":"202605053727827554","title":"港<em>股铜业股</em>早盘走低 <em>江西铜业股份</em>跌超4%","content":"5月5日，港股铜业股早盘走低，江西铜业股份跌超4%，中国有色矿业跌近4%，五矿资源、中国黄金国际跌超2%。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202605053727827554.html"},{"date":"2026-05-05 09:47:46","image":"","code":"202605053727830226","title":"港<em>股铜业股</em>早盘走低，<em>江西铜业股份</em>跌超4%，中国有色矿<em>业</em>跌近4%，五矿资源、中国黄金国际跌超2%","content":"港股铜业股早盘走低，江西铜业股份跌超4%，中国有色矿业跌近4%，五矿资源、中国黄金国际跌超2%。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202605053727830226.html"},{"date":"2026-04-29 14:33:32","image":"","code":"202604293724305390","title":"<em>铜业股</em>集体走高，<em>江西铜业股份</em>涨4.99%","content":"每经AI快讯，铜业股集体走高，截至发稿，江西铜业股份涨4.99%，报38.3港元；洛阳钼业涨3.06%，报18.2港元；中国有色矿业涨2.89%，报13.55港元；紫金矿业涨2.77%，报36.34港元。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202604293724305390.html"},{"date":"2026-04-29 20:39:00","image":"","code":"202604293724920055","title":"<em>江西铜业股份</em>：2025年净利润同比增长2.41%","content":"南财智讯4月29日电，江西铜业股份（00358.HK）公告，截至2025年12月31日止年度，公司营业收入为人民币5446.23亿元，同比增长5.42%；年内归属于上市公司股东的净利润为人民币71.30亿元，同比增长2.41%；每股基本盈利为人民币2.07元。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202604293724920055.html"}]},"searchId":"64b17863-5354-418f-b9ac-9190b96150e8"})