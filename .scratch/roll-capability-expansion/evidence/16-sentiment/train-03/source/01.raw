rollTrain03({"bizCode":"","bizMsg":"","code":0,"extra":{},"hitsTotal":119,"msg":"OK","result":{"cmsArticleWebOld":[{"date":"2026-10-07 15:41:08","image":"","code":"202610073888887262","title":"<em>江西铜业</em>与控股股东重签关联交易合同，三年采购预计上限超520亿元","content":"9月30日晚间，江西铜业(600362)发布公告称，公司与控股股东江西铜业集团有限公司签署三项日常关联交易协议，有效期自2027年1月1日至2029年12月31日，涉及物料供应、产品销售及土地房屋租赁等多个领域。 　　此次签署的三项协议包括《综合供应及服务合同I》《综合供应及服务合同","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202610073888887262.html"},{"date":"2026-09-30 17:48:20","image":"","code":"202609303887800680","title":"<em>江西铜业</em>：拟与控股股东签订2027-2029年度日常关联交易合同","content":"江西铜业(600362.SH)公告称，公司与控股股东江铜集团签订有效期自2027年1月1日至2029年12月31日的《综合供应及服务合同Ⅰ》《综合供应及服务合同Ⅱ》及《土地使用权和房屋租赁协议》。其中，2027-2029年采购物料及接受服务预计金额分别为171.74亿元、173.78","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202609303887800680.html"},{"date":"2026-09-25 17:31:04","image":"","code":"202609253884296444","title":"贝莱德在<em>江西铜业</em>股份的H股好仓比例下降0.99%至4.31%","content":"南财智讯9月25日电，香港交易所披露信息显示，BlackRock,Inc.（贝莱德）在江西铜业股份的H股好仓（L）比例于9月22日从5.30%下降至4.31%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202609253884296444.html"},{"date":"2026-09-23 17:19:00","image":"","code":"202609233882507346","title":"贝莱德在<em>江西铜业</em>股份的H股好仓比例上升0.38%至5.21%","content":"南财智讯9月23日电，香港交易所披露信息显示，BlackRock,Inc.（贝莱德）在江西铜业股份的H股好仓（L）比例于9月18日从4.83%上升至5.21%。同时淡仓（S）比例从0.49%降至0.46%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202609233882507346.html"},{"date":"2026-09-22 14:13:15","image":"","code":"202609223881173677","title":"全球<em>铜</em>矿或迎近10年首次减产，伦<em>铜</em>冲击六连阳！<em>江西铜业</em>涨超2%，有色ETF汇添富(159652)标的指数涨0.54%，回归基本面定价的<em>铜</em>怎么看？","content":"9月22日，LME铜盘中再度冲高，冲击六连阳，逼近前高。“金铜含量”高的有色ETF汇添富（159652）标的指数涨0.54%。 　　有色ETF汇添富（159652）标的指数成分股多数冲高，江西铜业涨超2%，西部矿业、洛阳钼业等涨超1%，紫金矿业、北方稀土等微涨，山东黄金、厦门钨业等回调","mediaName":"界面新闻","url":"http://stock.eastmoney.com/a/202609223881173677.html"},{"date":"2026-09-10 17:44:00","image":"","code":"202609103870672054","title":"<em>江西铜业</em>完成发行总计15亿元第四期中期票据","content":"9月10日，江西铜业（600362/00358）发布公告，公司发行了2026年度第四期中期票据，具体情况如下： 　　品种一（26江铜股份MTN004A(并购)）的债券代码为102683574，发行总额为5亿元，期限为10年，发行价格为100元，发行利率为2.10%。 　　品种二（26","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202609103870672054.html"},{"date":"2026-09-11 11:52:56","image":"","code":"202609113871913877","title":"港股异动 | 港股有色金属板块集体走弱 <em>江西铜业</em>股份、洛阳钼<em>业</em>均跌超10%","content":"上证报中国证券网讯（记者何治民）9月11日，港股有色金属板块集体走弱，截至11时03分，江西铜业股份、洛阳钼业、五矿资源大跌超10%，中国大冶有色金属、中国有色矿业、天齐锂业、紫金矿业跌超7%，赣锋锂业、中国铝业跟跌。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202609113871913877.html"},{"date":"2026-09-08 10:35:07","image":"","code":"202609083867811984","title":"央行连续22个月增持黄金！紫金矿<em>业</em>、<em>江西铜业</em>强势上涨","content":"9月8日早盘，有色板块放量走强。有色矿业ETF招商（159690）标的指数涨1.56%，成份股紫金矿业、江西铜业涨幅居前。该基金年内份额扩容超416%，资金持续涌入上游资源龙头。 　　消息面上，国家外汇管理局9月7日公布数据显示，截至2026年8月末，中国黄金储备规模达7673万盎司","mediaName":"东方财富证券","url":"http://finance.eastmoney.com/a/202609083867811984.html"},{"date":"2026-09-08 17:26:56","image":"","code":"202609083868128984","title":"贝莱德在<em>江西铜业</em>股份的H股好仓比例上升0.05%至5.03%","content":"南财智讯9月8日电，香港交易所披露信息显示，BlackRock,Inc.（贝莱德）在江西铜业股份的H股好仓（L）比例于9月3日从4.98%上升至5.03%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202609083868128984.html"},{"date":"2026-09-08 19:40:00","image":"","code":"202609083868250866","title":"<em>江西铜业</em>：公司将于9月16日召开2026年半年度<em>业</em>绩说明会","content":"9月8日，江西铜业发布公告称，公司计划于2026年9月16日11：00-12：00举行2026年半年度业绩说明会。","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202609083868250866.html"},{"date":"2026-09-08 11:00:16","image":"","code":"202609083867911132","title":"LME<em>铜</em>价创历史新高！<em>江西铜业</em>涨超6%，有色矿<em>业</em>ETF招商（159690）强势上扬","content":"9月8日早盘，有色金属板块集体走强，有色矿业ETF招商（159690）标的指数涨1.67%，江西铜业大涨逾6%，西部矿业、云南铜业涨超5%，洛阳钼业、紫金矿业、湖南白银、铜陵有色等跟涨，板块呈现普涨格局。 　　消息面上，伦敦金属交易所（LME）铜价在美国关税预期搅动下一度升至14585","mediaName":"21世纪经济报道","url":"http://stock.eastmoney.com/a/202609083867911132.html"},{"date":"2026-09-03 13:14:45","image":"","code":"202609033863915596","title":"<em>江西铜业</em>武山<em>铜</em>矿三期扩建项目正式投产","content":"9月1日，江西铜业武山铜矿三期扩建项目正式投产。据介绍，武山铜矿三期扩建工程设计日处理矿石能力达1万吨，设计服务年限24年。项目达产后，武山铜矿将成为江西省规模最大的井下铜矿山。 　　武山铜矿三期扩建项目是江西省重点工程，总投资21亿元，于2021年7月开工建设，设计利用资源量约7700","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202609033863915596.html"},{"date":"2026-09-02 17:28:00","image":"","code":"202609023862844038","title":"摩根大通在<em>江西铜业</em>股份的H股好仓比例下降0.13%至5.88%","content":"南财智讯9月2日电，香港交易所披露信息显示，JPMorganChase&Co.（摩根大通）在江西铜业股份的H股好仓（L）比例于8月27日从6.01%下降至5.88%。同时淡仓（S）比例从1.90%降至1.77%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202609023862844038.html"},{"date":"2026-08-31 21:47:00","image":"","code":"202608313860403922","title":"<em>江西铜业</em>：关于董事会秘书离任的公告","content":"8月31日，江西铜业发布公告称，公司董事会收到公司副总经理、董事会秘书涂东阳先生递交的书面辞任函，因工作调动原因，涂东阳先生提请辞去公司副总经理、董事会秘书职务，并不再担任公司任何职务。涂东阳先生的辞任函自送达董事会之日起生效。截至本公告披露日，涂东阳先生未持有公司股票，不存在未履行完毕的公开承诺","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202608313860403922.html"},{"date":"2026-08-31 17:21:00","image":"","code":"202608313860156368","title":"<em>江西铜业</em>：涂东阳辞去董事会秘书等职位","content":"南财智讯8月31日电，江西铜业公告，公司董事会近日收到副总经理、董事会秘书涂东阳递交的书面辞任函，因工作调动原因，涂东阳辞去公司副总经理、董事会秘书职务，并不再担任公司任何职务。涂东阳所负责的工作已妥善交接，其离任不会影响公司相关工作的正常开展。根据相关规定，董事会秘书空缺期间，由代行董事长职责的副董事长周少兵同时代行董事会秘书职责","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202608313860156368.html"},{"date":"2026-09-01 17:18:00","image":"","code":"202609013861549243","title":"摩根大通在<em>江西铜业</em>股份的H股好仓比例上升0.21%至6.01%","content":"南财智讯9月1日电，香港交易所披露信息显示，JPMorganChase&Co.（摩根大通）在江西铜业股份的H股好仓（L）比例于8月26日从5.80%上升至6.01%。同时淡仓（S）比例从1.69%升至1.90%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202609013861549243.html"},{"date":"2026-08-31 17:26:00","image":"","code":"202608313860159294","title":"<em>江西铜业</em>：董秘兼副总经理涂东阳因工作调动离职","content":"8月31日，江西铜业（600362/00358）发布公告，因工作调动原因，涂东阳提请辞去公司副总经理、董事会秘书职务，并不再担任公司任何职务。 　　2026年中期，江西铜业实现收入3071.55亿元，归母净利润86.32亿元。","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202608313860159294.html"},{"date":"2026-08-26 09:57:01","image":"","code":"202608263854263526","title":"有色金属板块震荡走强 精艺股份、<em>江西铜业</em>涨停","content":"上证报中国证券网讯 8月26日早盘，有色金属板块震荡走强，截至9时55分，精艺股份、江西铜业涨停，西部矿业、云南铜业、北方铜业等跟涨。 来源：choice金融终端","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202608263854263526.html"},{"date":"2026-08-25 20:34:10","image":"","code":"202608253853251631","title":"<em>江西铜业</em>：上半年净利润同比增长106.77%","content":"上证报中国证券网讯（记者黄璐婧）江西铜业披露2026年半年度报告，公司实现营业收入3071.55亿元，同比增长19.53%；归属于上市公司股东的净利润86.32亿元，同比增长106.77%。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202608253853251631.html"},{"date":"2026-08-26 10:23:57","image":"","code":"202608263854273827","title":"有色龙头公司中报<em>业</em>绩全面验证！<em>江西铜业</em>10cm涨停","content":"8月26日早盘，有色金属板块强势反弹，有色矿业ETF招商（159690）标的指数涨超3%，江西铜业涨停，紫金矿业涨近4%，洛阳钼业涨近6%，北方稀土、中金黄金跟涨。 　　消息面上，成分股中报业绩的集中披露为板块上行提供了坚实支撑——已披露中报的22只成分股中，21只实现营收正增长，","mediaName":"东方财富证券","url":"http://finance.eastmoney.com/a/202608263854273827.html"},{"date":"2026-08-26 10:11:03","image":"","code":"202608263854307587","title":"<em>江西铜业</em>：2026年上半年净利润86.32亿元 同比增长106.77%","content":"中证智能财讯江西铜业（600362）8月26日披露2026年半年度报告。2026年上半年，公司实现营业总收入3071.55亿元，同比增长19.53%；归母净利润86.32亿元，同比增长106.77%；扣非净利润75.56亿元，同比增长73.73%；经营活动产生的现金流量净额为58.14","mediaName":"中国证券报·中证网","url":"http://finance.eastmoney.com/a/202608263854307587.html"},{"date":"2026-08-26 15:21:53","image":"","code":"202608263854514751","title":"<em>江西铜业</em>2026年半年报：资源端持续扩张，新材料<em>业</em>务打开第二增长曲线","content":"蓝鲸新闻8月26日讯，8月25日，江西铜业股份（00358）披露2026年半年度财报，年初至报告期末实现营业收入3071.5亿元，同比增长19.53%；归属于上市公司股东的净利润88.31亿元，同比大幅增长106.77%。截至2026年6月30日，公司资产合计2,932.65亿元，","mediaName":"蓝鲸财经","url":"http://finance.eastmoney.com/a/202608263854514751.html"},{"date":"2026-08-25 22:14:00","image":"","code":"202608253853369445","title":"<em>江西铜业</em>股份：上半财年净利润同比增长106.77%","content":"南财智讯8月25日电，江西铜业股份（00358.HK）公告，公司截至2026年6月30日止六个月（上半财年）实现营业收入3071.55亿元，同比增长；归属于上市公司股东的净利润86.32亿元，同比增长106.77%；基本每股收益2.50元。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202608253853369445.html"},{"date":"2026-08-26 21:31:00","image":"","code":"202608263855141379","title":"<em>江西铜业</em>上半年净赚86亿超预告上限，<em>铜</em>价再创新高助推<em>业</em>绩翻倍 | 债市财报观察","content":"财联社8月26日讯 8月25日，江西铜业股份有限公司（600362.SH）披露2026年半年度报告。报告期内，公司实现营业收入3071.55亿元，同比增长19.53%；归母净利润86.32亿元，同比大幅增长106.77%。这一业绩表现超出了公司此前发布的75.5亿元至85亿元的业绩预告区间上限","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202608263855141379.html"},{"date":"2026-08-25 17:55:18","image":"","code":"202608253852994392","title":"<em>江西铜业</em>：上半年净利润86.32亿元 同比增长106.77%","content":"江西铜业披露半年报，2026年上半年，公司实现营业收入3071.55亿元，同比增长19.53%；归属于上市公司股东的净利润86.32亿元，同比增长106.77%；基本每股收益2.5元。报告期内，营收业绩变动主要原因是主产品价格及销量变动。","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202608253852994392.html"},{"date":"2026-08-25 17:53:27","image":"","code":"202608253852994658","title":"<em>江西铜业</em>：上半年净利润86.32亿元 同比增长106.77%","content":"江西铜业(600362)8月25日披露半年报，2026年上半年，公司实现营业收入3071.55亿元，同比增长19.53%；归属于上市公司股东的净利润86.32亿元，同比增长106.77%；基本每股收益2.5元。报告期内，营收业绩变动主要原因是主产品价格及销量变动。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202608253852994658.html"},{"date":"2026-08-25 17:50:47","image":"","code":"202608253852967869","title":"<em>江西铜业</em>：上半年净利润86.32亿元 同比增长106.77%","content":"江西铜业(600362.SH)公告称，公司发布2026年半年度报告，实现营业收入3071.55亿元，同比增长19.53%；归属于上市公司股东的净利润86.32亿元，同比增长106.77%。 　　注：公司Q2净利润58.14亿，Q1净利润28.18亿，据此计算，Q2净利润环比增长106%","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202608253852967869.html"},{"date":"2026-08-26 17:09:30","image":"","code":"202608263854666351","title":"美银证券：升<em>江西铜业</em>股份目标价至50港元 中期纯利远超预期","content":"美银证券发布研报称，将江西铜业股份目标价由43港元上调16%至50港元，A股目标价由55元人民币上调11%至61元人民币，维持“买入”评级。该行上调江西铜业2026及2027年纯利预测37%及46%，至各136亿及154亿元人民币，看好韧性的铜价及硫酸价格、联营公司盈利潜在上行、估值吸引及铜箔业务在人工智能需求加速下潜在重估空间","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202608263854666351.html"},{"date":"2026-08-26 10:23:00","image":"","code":"202608263854318893","title":"美债收益率回落叠加“金九”旺季预期 港股有色板块走强 <em>江西铜业</em>涨超11%","content":"受益于市场利好，港股有色金属股全线走强。截至发稿，江西铜业股份(00358.HK)涨11.07%，中国有色矿业(01258.HK)涨9.07%，力勤资源(02245.HK)涨6.99%，五矿资源(01208.HK)涨5.32%。 　　消息方面，美国财政部长贝森特上周宣布将通过扩大长债回购规模压低美国融资成本","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202608263854318893.html"},{"date":"2026-08-25 18:00:31","image":"","code":"202608253852983637","title":"<em>江西铜业</em>：上半年归母净利润86.32亿元 同比增长106.77%","content":"江西铜业8月25日披露半年报，2026年上半年，公司实现营业收入3071.55亿元，同比增长19.53%；归属于上市公司股东的净利润86.32亿元，同比增长106.77%；基本每股收益2.5元。报告期内，营收业绩变动主要原因是主产品价格及销量变动。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202608253852983637.html"},{"date":"2026-08-25 23:29:22","image":"","code":"202608253853438950","title":"<em>江西铜业</em>股份：上半年归母净利润88.97亿元 同比增长99.91%","content":"8月25日，江西铜业股份在港交所公告，2026年上半年营收3058.54亿元，同比增长19.46%；归属于母公司的期内溢利88.97亿元，同比增长99.91%；调整后基本每股盈利2.58元。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202608253853438950.html"},{"date":"2026-08-25 18:20:00","image":"","code":"202608253853025583","title":"<em>江西铜业</em>：上半年归母净利润86.3亿元，同比增106.8%","content":"8月25日，江西铜业(600362)公布2026年半年报，公司营业收入为3071.5亿元，同比上升19.5%；归母净利润为86.3亿元，同比上升106.8%；扣非归母净利润为75.6亿元，同比上升73.7%；经营现金流净额为58.14亿元，同比增长102.5%；EPS(全面摊薄)为","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202608253853025583.html"},{"date":"2026-08-26 08:00:00","image":"","code":"202608263853767784","title":"能源早报｜<em>江西铜业</em>上半年归母净利润翻番；合盛硅<em>业</em>上半年扭亏为盈","content":"江西铜业上半年归母净利润翻番 　　江西铜业8月25日披露半年报，2026年上半年，公司实现营业收入3071.55亿元，同比增长19.53%；归属于上市公司股东的净利润86.32亿元，同比增长106.77%；基本每股收益2.5元。报告期内，营收业绩变动主要原因是主产品价格及销量变动。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202608263853767784.html"},{"date":"2026-08-25 23:28:42","image":"","code":"202608253853441660","title":"<em>江西铜业</em>2026年上半年归母净利润为86.32亿元 同比增长106.77%","content":"8月25日，江西铜业（600362.SH）披露2026年半年度报告。数据显示，2026年上半年公司实现营业收入3071.55亿元，同比增长19.53%；归属于上市公司股东的净利润为86.32亿元，同比增长106.77%；基本每股收益2.5元。报告期内，公司营收及业绩变动主要原因是主产品价格及销量变动","mediaName":"央广财经","url":"http://finance.eastmoney.com/a/202608253853441660.html"},{"date":"2026-08-26 19:22:40","image":"","code":"202608263854862187","title":"29亿元资产减值侵蚀利润，<em>江西铜业</em>半年度净利仍实现翻倍，加码千万吨级海外<em>铜</em>金资源储备","content":"8月25日，江西铜业（600362.SH/00358.HK）披露2026年半年报。报告期内，公司实现营业收入3071.55亿元，同比增长19.53%；实现归母净利润86.32亿元，同比增长106.77%；扣非后归母净利润75.56亿元，同比增长73.73%。 　　对于业绩变动的原因","mediaName":"时代周报","url":"http://finance.eastmoney.com/a/202608263854862187.html"},{"date":"2026-08-25 17:42:00","image":"","code":"202608253852961968","title":"<em>江西铜业</em>：2026年半年度净利润同比增长106.77% 营收增19.53%","content":"南财智讯8月25日电，江西铜业于2026年8月发布2026年半年度报告摘要，2026年上半年实现营业收入3071.55亿元，同比增加19.53%；归属于上市公司股东的净利润86.32亿元，同比增加106.77%；基本每股收益2.50元，同比增加106.61%。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202608253852961968.html"},{"date":"2026-08-25 20:44:00","image":"","code":"202608253853259542","title":"沪电股份、<em>江西铜业</em>上半年净利润分别增长73.72%、106.77%丨公告精选","content":"今日焦点 　　华盛昌：上半年净利增长73% Q2净利环比增长223% 　　华盛昌（002980.SZ）公告称，公司发布2026年半年度报告，实现营业收入4.79亿元，同比增长37.09%；归属于上市公司股东的净利润7518.54万元，同比增长72.94%。公司计划不派发现金红利，不送红股","mediaName":"21世纪经济报道","url":"http://finance.eastmoney.com/a/202608253853259542.html"},{"date":"2026-08-26 10:57:23","image":"","code":"202608263854339629","title":"伦<em>铜</em>纽<em>铜</em>齐创历史新高，<em>江西铜业</em>上半年净利增106.77%股价涨停，工<em>业</em>有色ETF万家涨近3%","content":"8月26日，A股主要股指涨跌互现，工业有色金属板块普涨，铜方向领涨。 　　截至10：04，热门ETF——工业有色ETF万家（560860）涨2.63％，成分股中，江西铜业涨停、金诚信涨停、云南铜业涨6.25%、西部矿业涨5.76%、洛阳钼业涨4.4%，东阳光跌1.93%、中钨高新跌","mediaName":"东方财富证券","url":"http://finance.eastmoney.com/a/202608263854339629.html"},{"date":"2026-08-25 20:37:00","image":"","code":"202608253853253230","title":"<em>江西铜业</em>：上半年净利润同比增长107%至86亿元 海外资源布局取得重大突破","content":"上证报中国证券网讯江西铜业8月25日晚间发布的2026年半年报显示，上半年，公司实现营业收入3071.55亿元，上年同期2569.59亿元，同比增加19.53%； 归属于上市公司股东净利润86.32亿元，上年同期41.75亿元，同比增长106.77%。 　　报告期内，公司财务费用为","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202608253853253230.html"},{"date":"2026-08-26 13:09:41","image":"","code":"202608263854481966","title":"<em>江西铜业</em>涨停，上半年归母净利润翻番，有色ETF泰康(159163)标的指数涨超3%","content":"截至2026年8月26日 13:02，有色ETF泰康(159163)跟踪指数中证有色金属矿业主题指数(931892)一度涨超3%，现涨2.85%，成分股白银有色上涨10.03%，江西铜业上涨10.01%，洛阳钼业上涨7.65%，西部矿业，云南铜业等个股跟涨。 　　从估值层面来看，有色","mediaName":"界面新闻","url":"http://stock.eastmoney.com/a/202608263854481966.html"},{"date":"2026-08-25 22:20:21","image":"","code":"202608253853370934","title":"超出预期<em>业</em>绩1亿元！<em>江西铜业</em>上半年净赚超86亿元，二季度归母净利润环比翻倍","content":"江西铜业（600362.SH，股价44.15元，市值1529亿元）于8月25日盘后披露2026年半年度报告。 　　公司上半年实现归母净利润86.32亿元，同比增长106.77%，超出此前业绩预告区间（75.50亿元至85.00亿元）。 \"\"图片来源：公告截图 　　这一成绩主要得益于铜价高位运行与公司精细化运营管理的双重驱动","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202608253853370934.html"},{"date":"2026-08-26 09:15:00","image":"","code":"202608263854078969","title":"<em>江西铜业</em>(600362.SH)：2026年中报净利润为86.32亿元、同比较去年同期上涨106.77%","content":"2026年8月26日，江西铜业(600362.SH)发布2026年中报。 　　公司营业总收入为3071.55亿元，在已披露的同业公司中排名第1，较去年同报告期营业总收入增加501.96亿元，同比较去年同期上涨19.53%。归母净利润为86.32亿元，在已披露的同业公司中排名第4，较去年同报告期归母净利润增加","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202608263854078969.html"},{"date":"2026-08-25 21:15:00","image":"","code":"202608253853315667","title":"公告精选：<em>江西铜业</em>上半年净利润同比增长106.77%；沪电股份上半年净利润同比增长73.72%","content":"人民财讯8月25日电，【经营数据】 　　江西铜业：上半年净利润86.32亿元同比增长106.77% 　　沪电股份：上半年净利润29.23亿元，同比增长73.72% 　　欧科亿：上半年净利润3.71亿元同比增长47734.24% 　　杭电股份：上半年净利润3.93亿元同比增长938.67%","mediaName":"人民财讯","url":"http://finance.eastmoney.com/a/202608253853315667.html"},{"date":"2026-08-26 10:36:28","image":"","code":"202608263854298145","title":"加拿大宣布对美等额反制关税、COMEX金盘中触及4755美元！黄金股ETF永赢盘中涨超2%，<em>江西铜业</em>涨停","content":"场内ETF方面，8月26日，黄金股ETF永赢(517520)成交额4.83亿元，换手率2.93%，最新规模162.94亿元（截至8月25日）。成分股江西铜业、深中华A涨停，江西铜业股份、白银有色、湖南白银等领涨。 　　消息面上，首先，美加贸易摩擦再度升级。8月25日，加拿大联邦政府宣布","mediaName":"东方财富证券","url":"http://finance.eastmoney.com/a/202608263854298145.html"},{"date":"2026-08-26 14:01:00","image":"","code":"202608263854454811","title":"市场聚焦沃什讲话指引，黄金股ETF华夏（159562）、有色金属ETF华夏（516650）的共同持仓股白银有色、<em>江西铜业</em>双双涨停","content":"8月26日午后，A股冲高回落，金价震荡回调至4700美元/盎司附近，截至13:20，黄金股ETF华夏（159562）跟踪的SSH黄金股票指数（931238）涨幅收窄至1.09%，有色金属ETF华夏（516650）跟踪的中证细分有色金属产业主题指数（000811）上涨2.27%，共同持仓股白银有色","mediaName":"21世纪经济报道","url":"http://stock.eastmoney.com/a/202608263854454811.html"},{"date":"2026-08-26 10:44:00","image":"","code":"202608263854446511","title":"中报<em>业</em>绩全面验证，10家矿<em>业</em>龙头利润翻番！<em>江西铜业</em>涨停，有色矿<em>业</em>ETF招商（159690）标的指数涨超2%","content":"8月26日早盘，有色金属板块强势反弹，有色矿业ETF招商（159690）标的指数涨超2%，江西铜业涨停，云南铜业、西部矿业、洛阳钼业、铜陵有色等跟涨。 　　消息面上，成分股中报业绩的集中披露或为板块上行提供了坚实支撑——已披露中报的22只成分股中，21只实现营收正增长，20只归母净利润同比正增长","mediaName":"21世纪经济报道","url":"http://stock.eastmoney.com/a/202608263854446511.html"},{"date":"2026-08-14 16:25:00","image":"","code":"202608143841762737","title":"<em>江西铜业</em>完成发行15亿元中期票据","content":"8月14日，江西铜业（600362/00358）发布公告，公司近日发行了2026年度第二期中期票据（并购）。 　　本期票据品种一发行总额为5亿元，中期票据的期限为10年，发行利率为2.14%（年利率）。品种二发行总额为10亿元，中期票据的期限为15年，发行利率为2.35%（年利率）","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202608143841762737.html"},{"date":"2026-08-09 13:15:18","image":"","code":"202608093835907248","title":"每经品牌100指数巩固千点，成分股<em>江西铜业</em>分拆<em>江铜铜</em>箔赴港上市获通过","content":"本周半导体芯片产业链集体反弹，A股主要股指震荡走高，每经品牌100指数在经历周线5连阳后进入短暂调整，周跌0.61%，以1010.16点报收，巩固千点关口。眼下，市场将回归流动性流入阶段，中报业绩的到来，也为资金的再配置行为提供基本面支撑，市场将由此呈现底部回升过程。 　　每经品牌","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202608093835907248.html"},{"date":"2026-07-29 16:47:00","image":"","code":"202607293825138147","title":"<em>江西铜业</em>完成发行25亿元中期票据","content":"7月29日，江西铜业（600362/00358）发布公告，公司于近日发行了2026年度第一期中期票据（并购）。 　　品种一发行总额为9亿元，中期票据的期限为10年，发行价格为100元，发行利率为2.20%（年利率）。 　　品种二发行总额为16亿元，中期票据的期限为15年，发行价格为","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202607293825138147.html"},{"date":"2026-07-29 18:39:00","image":"","code":"202607293825229482","title":"<em>江西铜业</em>股份完成发行25亿元中期票据","content":"新京报贝壳财经讯 7月29日，江西铜业股份(00358)发布公告，2026年6月，公司收到交易商协会的《接受注册通知书》(中市协注〔2026〕MTN480号)，交易商协会决定接受公司中期票据注册，注册金额为70亿元，注册额度自通知书落款之日(2026年6月15日)起2年内有效。近日","mediaName":"新京报","url":"http://finance.eastmoney.com/a/202607293825229482.html"},{"date":"2026-07-30 09:09:44","image":"","code":"202607303825951079","title":"<em>江西铜业</em>：完成发行25亿元中期票据 期限10年及15年","content":"中证智能财讯江西铜业（600362）7月30日公告，公司近日发行了2026年度第一期中期票据（并购），品种一发行总额为9亿元，期限10年，发行利率为2.20%；品种二发行总额为16亿元，期限15年，发行利率为2.40%。两品种合计发行25亿元。本期中期票据起息日为2026年7月28","mediaName":"中国证券报·中证网","url":"http://finance.eastmoney.com/a/202607303825951079.html"},{"date":"2026-07-20 19:57:00","image":"","code":"202607203813543762","title":"红板科技：公司已与<em>江西铜业</em>签署战略合作协议","content":"证券日报网讯 7月20日，红板科技在互动平台回答投资者提问时表示，公司已与江西铜业签署战略合作协议，江铜在同等条件下将优先为公司供应铜箔原材料，有助于稳固上游核心物料采购渠道，优化原材料采购管理。原材料价格受大宗商品行情、市场供需等多重外部因素影响，产品毛利率最终由产品结构、生产良率","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202607203813543762.html"},{"date":"2026-07-18 10:34:00","image":"","code":"202607183811658486","title":"再现A拆H！<em>江西铜业</em>分拆<em>江铜铜</em>箔冲刺港交所上市","content":"7月17日，国内铜业龙头江西铜业股份有限公司（以下简称“江西铜业”）公告，公司于7月15日召开董事会并全票通过旗下核心优质资产江西省江铜铜箔科技股份有限公司（以下简称“江铜铜箔”）赴港交所主板上市预案。 　　根据江西铜业最新公告，本次分拆上市采用“H股首发、港交所主板挂牌”模式，通过公开发售及国际配售相结合的方式发行新股","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202607183811658486.html"},{"date":"2026-07-16 21:05:06","image":"","code":"202607163809305456","title":"<em>江西铜业</em>拟分拆<em>江铜铜</em>箔至香港联交所主板上市","content":"上证报中国证券网讯江西铜业7月16日晚间公告，江西铜业拟分拆其所属子公司江铜铜箔至香港联交所主板上市。 　　本次分拆上市后，江西铜业仍为江铜铜箔的控股股东，不会导致公司丧失对江铜铜箔的控制权。本次分拆既有利于江铜铜箔以独立融资平台引入资本市场资源，在电解铜箔领域加大资本投入，把握新能源","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202607163809305456.html"},{"date":"2026-07-16 20:15:27","image":"","code":"202607163809242321","title":"<em>江西铜业</em>披露分拆子公司<em>江铜铜</em>箔赴港交所主板上市计划","content":"7月16日，江西铜业（600362.SH）发布公告称，公司拟分拆所属子公司江西省江铜铜箔科技股份有限公司至香港联交所主板上市。本次分拆不会导致公司股权结构发生重大变化，不影响公司对江铜铜箔的控制权。公司已召开董事会审议通过相关预案，但分拆尚需获得股东会、国有资产监督管理机构、证监会备案及香港联交所批准等","mediaName":"央广财经","url":"http://finance.eastmoney.com/a/202607163809242321.html"},{"date":"2026-07-16 22:01:00","image":"","code":"202607163809361361","title":"<em>江西铜业</em>：拟分拆控股子公司<em>江铜铜</em>箔赴港交所主板上市","content":"南财智讯7月16日电，江西铜业（00358.HK）发布内幕消息公告，公司拟分拆其控股子公司江西省江铜铜箔科技股份有限公司（简称“江铜铜箔”）至香港联合交易所主板上市。该分拆方案已于2026年7月15日经公司第十届董事会第十八次会议审议通过，符合《上市公司分拆规则（试行）》及相关法律法规要求","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202607163809361361.html"},{"date":"2026-07-16 17:24:03","image":"","code":"202607163809128193","title":"<em>江西铜业</em>：拟分拆子公司<em>江铜铜</em>箔至香港联交所主板上市","content":"江西铜业(600362.SH)公告称，公司拟分拆所属子公司江西省江铜铜箔科技股份有限公司至香港联交所主板上市。本次分拆不会导致公司股权结构发生重大变化，不影响公司对江铜铜箔的控制权。公司已召开董事会审议通过相关预案，但分拆尚需获得股东会、国有资产监督管理机构、证监会备案及香港联交所批准等","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202607163809128193.html"},{"date":"2026-07-16 20:13:00","image":"","code":"202607163809261619","title":"<em>江西铜业</em>：第十届董事会第十八次会议决议公告","content":"证券日报网讯 7月16日，江西铜业发布公告称，公司第十届董事会第十八次会议审议通过《关于分拆所属子公司江铜铜箔至香港联合交易所有限公司主板上市符合相关法律法规规定的议案》《关于分拆所属子公司江铜铜箔至香港联合交易所有限公司主板上市方案的议案》等多项议案。","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202607163809261619.html"},{"date":"2026-07-08 20:54:00","image":"","code":"202607083798636153","title":"<em>江西铜业</em>：2026年半年度<em>业</em>绩预告","content":"证券日报网讯 7月8日，江西铜业发布2026年半年度业绩预告称，公司2026年半年度预计实现归属于母公司所有者的净利润755，000万元至850，000万元，同比增加80.86%至103.61%。","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202607083798636153.html"},{"date":"2026-07-08 21:06:09","image":"","code":"202607083798642269","title":"<em>江西铜业</em>预计上半年净利同比增长80.86%到103.61%","content":"上证报中国证券网讯江西铜业7月8日晚间发布的2026年半年度业绩预告显示，公司预计2026年半年度实现归属于母公司所有者的净利润755,000万元到850,000万元，与上年同期相比，将增加337,545万元到432,545万元，同比增加80.86%到103.61%；公司预计2026","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202607083798642269.html"},{"date":"2026-07-08 17:34:07","image":"","code":"202607083798487969","title":"<em>江西铜业</em>：上半年净利同比预增81%~104%","content":"7月8日，江西铜业(600362.SH)公告称，预计2026年半年度归属于上市公司股东的净利润为75.50亿元~85.00亿元，同比增长80.86%~103.61%。业绩变动主要系公司深化降本增效，核心产品价格走高，带动整体经营效益提升。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202607083798487969.html"},{"date":"2026-07-07 21:01:00","image":"","code":"202607073797010674","title":"<em>江西铜业</em>：关于董事长离任的公告","content":"证券日报网讯 7月7日，江西铜业发布公告称，公司董事会近日收到董事长郑高清先生递交的书面辞任函，因到法定退休年龄，郑高清先生提请辞去公司董事长、董事、董事会提名委员会主席及董事会ESG发展委员会主任职务，并不再担任公司任何职务。郑高清先生的辞任函自送达董事会之日起生效。郑高清先生的离任不会影响公司日常经营活动的开展","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202607073797010674.html"},{"date":"2026-07-09 17:11:00","image":"","code":"202607093800106693","title":"<em>江西铜业</em>：每股派0.60元，股权登记日为7月16日","content":"南财智讯7月9日电，江西铜业发布2025年年度权益分派实施公告，每股派0.60元（含税），股权登记日为7月16日。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202607093800106693.html"},{"date":"2026-07-09 20:46:00","image":"","code":"202607093800299074","title":"核心产品价格走高 <em>江西铜业</em>预计2026年上半年净利同比增80.86%至103.61%","content":"7月9日，江西铜业股份有限公司（以下简称“江西铜业”）披露2026年半年度业绩预告，这份预告用亮眼的数据展现了该公司强劲发展势头，也让市场看到了国内铜业龙头的核心竞争力与业绩兑现能力。 　　公告显示，该公司预计2026年上半年实现归属于母公司所有者净利润75.5亿元至85亿元，较上年同期增加","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202607093800299074.html"},{"date":"2026-07-07 16:31:30","image":"","code":"202607073796742179","title":"<em>江西铜业</em>：董事长郑高清因退休离任","content":"7月7日，江西铜业(600362.SH)公告称，公司董事长郑高清因到法定退休年龄，提请辞去董事长、董事、董事会提名委员会主席及董事会ESG发展委员会主任职务，并不再担任公司任何职务。其辞任函自送达董事会之日起生效，离任不会影响公司日常经营，公司将尽快完成董事补选工作。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202607073796742179.html"},{"date":"2026-07-07 16:30:00","image":"","code":"202607073796739931","title":"<em>江西铜业</em>：董事长郑高清辞任","content":"南财智讯7月7日电，江西铜业公告，公司董事会近日收到董事长郑高清先生递交的书面辞任函，因到法定退休年龄，郑高清先生辞去公司董事长、董事、董事会提名委员会主席及董事会ESG发展委员会主任职务，并不再担任公司任何职务。郑高清先生的辞任函自送达董事会之日起生效，其离任不会影响公司日常经营活动的开展","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202607073796739931.html"},{"date":"2026-07-07 16:29:14","image":"","code":"202607073796741781","title":"<em>江西铜业</em>：董事长郑高清因退休离任","content":"江西铜业(600362.SH)公告称，公司董事长郑高清因到法定退休年龄，提请辞去董事长、董事、董事会提名委员会主席及董事会ESG发展委员会主任职务，并不再担任公司任何职务。其辞任函自送达董事会之日起生效，离任不会影响公司日常经营，公司将尽快完成董事补选工作。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202607073796741781.html"},{"date":"2026-07-07 17:58:40","image":"","code":"202607073796849951","title":"<em>江西铜业</em>董事长郑高清因到龄退休离任","content":"7月7日，江西铜业（600362.SH）发布公告称，公司董事长郑高清因达到法定退休年龄，提请辞去董事长、董事、董事会提名委员会主席及董事会ESG发展委员会主任职务，并不再担任公司任何职务。其辞任函自送达董事会之日起生效，本次离任不会对公司日常经营造成影响，公司将尽快完成董事补选工作","mediaName":"央广财经","url":"http://finance.eastmoney.com/a/202607073796849951.html"},{"date":"2026-07-07 21:48:00","image":"","code":"202607073797039539","title":"<em>江西铜业</em>股份：董事长郑高清辞任","content":"南财智讯7月7日电，江西铜业股份（00358.HK）公告，公司董事会于2026年7月7日收到执行董事郑高清先生递交的书面辞任函。因到法定退休年龄，郑高清先生辞去董事长、执行董事、提名委员会主席及环境、社会及管治发展委员会主席职务，不再担任公司任何职务。其辞任自送达董事会之日起生效，","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202607073797039539.html"},{"date":"2026-07-07 16:49:00","image":"","code":"202607073796755891","title":"<em>江西铜业</em>：董事长郑高清退休","content":"7月7日，江西铜业（600362/00358）发布公告，董事长郑高清因到法定退休年龄决定辞去公司董事长、董事、董事会提名委员会主席及董事会ESG发展委员会主任职务，并不再担任公司任何职务。 　　2026年一季度，江西铜业实现收入1391.24亿元，归母净利润28.18亿元。","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202607073796755891.html"},{"date":"2026-07-07 16:35:49","image":"","code":"202607073796745451","title":"<em>江西铜业</em>：董事长郑高清到龄退休辞职","content":"江西铜业7月7日公告，公司董事会近日收到董事长郑高清递交的书面辞任函，因到法定退休年龄，郑高清提请辞去公司董事长、董事等职务，并不再担任公司任何职务。郑高清的辞任函自送达董事会之日起生效。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202607073796745451.html"},{"date":"2026-07-08 17:47:00","image":"","code":"202607083798491626","title":"<em>江西铜业</em>：上半年净利润同比预增80.86%—103.61%","content":"人民财讯7月8日电，江西铜业(600362)7月8日披露业绩预告，预计2026年上半年归母净利润75.5亿元到85亿元，同比增加80.86%到103.61%。 　　报告期内，公司整体经营业绩同比实现较大幅度提升，主要原因为依托精细化运营管理，深挖内部降本增效潜力，通过工艺技改、能源降耗等举措拓宽盈利空间","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202607083798491626.html"},{"date":"2026-07-08 17:38:46","image":"","code":"202607083798489294","title":"<em>江西铜业</em>：预计上半年净利润同比增长80.86%-103.61%","content":"江西铜业公告，预计2026年半年度实现归属于母公司所有者的净利润75.5亿元到85亿元，同比增加80.86%到103.61%。报告期内，公司整体经营业绩同比实现较大幅度提升，主要原因为：一方面依托公司精细化运营管理，深挖内部降本增效潜力，通过工艺技改、能源降耗等举措拓宽盈利空间，关键技术经济指标持续改善","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202607083798489294.html"},{"date":"2026-07-07 16:41:00","image":"","code":"202607073796750997","title":"<em>江西铜业</em>：董事长郑高清因到退休年龄辞任","content":"人民财讯7月7日电，江西铜业(600362)7月7日公告，因到法定退休年龄，董事长郑高清提请辞去公司董事长、董事、董事会提名委员会主席及董事会ESG发展委员会主任职务，并不再担任公司任何职务。","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202607073796750997.html"},{"date":"2026-07-08 17:35:37","image":"","code":"202607083798488055","title":"<em>江西铜业</em>：预计上半年归母净利润同比增长80.86%-103.61%","content":"江西铜业7月8日公告，预计2026年半年度实现归属于母公司所有者的净利润755,000万元到850，000万元，与上年同期相比，将增加337,545万元到432,545万元，同比增加80.86%到103.61%。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202607083798488055.html"},{"date":"2026-07-07 16:59:42","image":"","code":"202607073796777825","title":"<em>江西铜业</em>(600362.SH)：董事长郑高清到龄退休离任","content":"2026年7月7日，江西铜业(600362.SH)公告，公司董事会收到董事长郑高清先生的书面辞任函，因到法定退休年龄，辞去公司董事长、董事、提名委员会主席及ESG发展委员会主任职务，辞任自送达董事会之日起生效，不再担任公司任何职务。 　　郑高清先生确认与董事会无任何意见分歧，不存在未履行完毕的公开承诺","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202607073796777825.html"},{"date":"2026-07-08 21:48:57","image":"","code":"202607083798701385","title":"<em>江西铜业</em>：预计2026年上半年净利75.5亿元-85亿元 同比增长80.86%-103.61%","content":"中证智能财讯江西铜业（600362）7月8日晚间披露业绩预告，预计2026年上半年归母净利润75.5亿元至85亿元，同比增长80.86%-103.61%；扣非净利润预计76.3亿元至85.8亿元，同比增长75.43%-97.27%。以7月8日收盘价计算，江西铜业目前市盈率（TTM）","mediaName":"中国证券报·中证网","url":"http://finance.eastmoney.com/a/202607083798701385.html"},{"date":"2026-07-08 17:45:00","image":"","code":"202607083798489934","title":"<em>江西铜业</em>：半年度归母净利润同比预增80.86%至103.61%","content":"7月8日，江西铜业（600362/00358）发布公告，预计2026年半年度实现归母净利润75.5亿元到85亿元，与上年同期相比，将增加33.75亿元到43.25亿元，同比增加80.86%到103.61%。 　　同时，预计扣非归母净利润为76.3亿元到85.8亿元，较上年同期增加32.81","mediaName":"财中社","url":"http://finance.eastmoney.com/a/202607083798489934.html"},{"date":"2026-07-08 17:32:21","image":"","code":"202607083798465549","title":"<em>江西铜业</em>：预计2026年半年度净利润同比增长80.86%-103.61%","content":"江西铜业(600362.SH)公告称，预计2026年半年度归属于上市公司股东的净利润为75.50亿元-85.00亿元，同比增长80.86%-103.61%。业绩变动主要系公司深化降本增效，核心产品价格走高，带动整体经营效益提升。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202607083798465549.html"},{"date":"2026-07-08 22:07:00","image":"","code":"202607083798737033","title":"<em>江西铜业</em>：预计上半年净利润75.50亿元~85.00亿元 同比增80.86%~103.61%","content":"江西铜业(600362)7月8日发布上半年业绩预增公告，预计实现净利润为75.50亿元~85.00亿元，净利润同比增长80.86%~103.61%。 　　证券时报·数据宝统计显示，江西铜业今日收于39.85元，下跌2.18%，日换手率为1.66%，成交额为13.83亿元，近5日下跌","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202607083798737033.html"},{"date":"2026-07-08 17:31:00","image":"","code":"202607083798462245","title":"<em>江西铜业</em>：上半年归属于上市公司股东的净利润同比预增80.86%—103.61%","content":"南财智讯7月8日电，江西铜业发布中期业绩预告，预计上半年归属于上市公司股东的净利润为755000万元—850000万元，同比预增80.86%—103.61%；预计上半年归属于上市公司股东的扣除非经常性损益的净利润为763000万元—858000万元，同比预增75.43%—97.27%","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202607083798462245.html"},{"date":"2026-06-23 17:38:00","image":"","code":"202606233779800673","title":"<em>江西铜业</em>跌停，机构龙虎榜净买入3543.39万元","content":"江西铜业(600362)今日跌停，全天换手率4.57%，成交额47.98亿元，振幅9.38%。龙虎榜数据显示，机构净买入3543.39万元，沪股通净卖出2.72亿元，营业部席位合计净卖出1.03亿元。 　　上交所公开信息显示，当日该股因日跌幅偏离值达-8.64%上榜，机构专用席位净买入","mediaName":"证券时报网","url":"http://finance.eastmoney.com/a/202606233779800673.html"},{"date":"2026-06-23 17:01:30","image":"","code":"202606233779759033","title":"<em>江西铜业</em>今日跌停 2家机构专用席位净买入1.17亿元","content":"6月23日，江西铜业今日跌停，成交额47.98亿元，换手率4.57%，盘后龙虎榜数据显示，沪股通专用席位买入1.19亿元并卖出3.91亿元，2家机构专用席位净买入1.17亿元，有1家机构专用席位净卖出8197.99万元。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202606233779759033.html"},{"date":"2026-06-23 17:00:04","image":"","code":"202606233779759139","title":"龙虎榜|<em>江西铜业</em>今日跌停 2家机构专用席位净买入1.17亿元","content":"江西铜业今日跌停，成交额47.98亿元，换手率4.57%，盘后龙虎榜数据显示，沪股通专用席位买入1.19亿元并卖出3.91亿元，2家机构专用席位净买入1.17亿元，有1家机构专用席位净卖出8197.99万元。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202606233779759139.html"},{"date":"2026-06-18 09:42:19","image":"","code":"202606183775633122","title":"有色·<em>铜</em>概念震荡拉升 <em>江西铜业</em>涨停","content":"早盘有色·铜概念震荡拉升，江西铜业涨停，云南铜业、北方铜业、西部矿业、铜陵有色、洛阳钼业跟涨。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202606183775633122.html"},{"date":"2026-06-18 10:16:26","image":"","code":"202606183775808126","title":"有色金属板块拉升 东方锆<em>业</em>、<em>江西铜业</em>涨停","content":"上证报中国证券网讯 6月18日早盘，有色金属板块拉升，截至9时40分，东方锆业、江西铜业涨停，盛和资源、云南铜业涨超7%，北方铜业、博迁新材等纷纷走高。","mediaName":"上海证券报·中国证券网","url":"http://finance.eastmoney.com/a/202606183775808126.html"},{"date":"2026-06-18 10:59:09","image":"","code":"202606183776018140","title":"<em>铜</em>板块直线拉升！有色金属ETF华夏(516650)持仓<em>江西铜业</em>涨停，高盛上调<em>铜</em>价10%","content":"2026年6月18日，有色板块拉升，铜、稀土概念活跃，截至10:35，持仓股江西铜业、海亮股份、中稀有色涨停，盛和资源涨9.14%，云南铜业涨4.18%。 　　消息面上，高盛分析师团队指出，美国2026年上半年的铜进口量超出预期，进一步收紧了美国以外市场的供需平衡。高盛预计，2026","mediaName":"界面新闻","url":"http://stock.eastmoney.com/a/202606183776018140.html"},{"date":"2026-06-15 14:01:30","image":"","code":"202606153771427020","title":"工<em>业</em>金属板块走高，<em>江西铜业</em>涨停","content":"工业金属板块走高，江西铜业涨停，金诚信、洛阳钼业、驰宏锌锗、铜陵有色跟涨。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202606153771427020.html"},{"date":"2026-06-17 15:09:39","image":"","code":"202606173774500486","title":"算力基建强化<em>铜</em>需求刚性，有色金属ETF华夏(516650)持仓股<em>江西铜业</em>、云南<em>铜业</em>盘中走强","content":"2026年6月17日，铜价盘中走强，截至14:50，有色金属ETF华夏(516650)下跌0.20%，其持仓股江西铜业、云南铜业、紫金矿业纷纷走强。 　　今日PCB概念领涨，消息面上，PCB上游材料涨价潮持续升温。6月16日，建滔积层板发布通知，因铜价高企、玻璃布价格持续上涨且供应紧张","mediaName":"界面新闻","url":"http://stock.eastmoney.com/a/202606173774500486.html"},{"date":"2026-06-18 10:37:00","image":"","code":"202606183775851624","title":"伦敦基本金属隔夜多数上涨，有色金属ETF天弘（159157）标的指数盘中涨超3%，<em>江西铜业</em>涨停","content":"6月18日，三大指数集体上涨，截至发稿上证综指上涨0.11%，深证成指上涨1.05%，创业板指上涨1.83%。中证工业有色金属主题指数(H11059.CSI)上涨超3%，该指数成分股中，江西铜业涨停，盛和资源上涨超8%，云南铜业与中国稀土上涨超4%，西部超导上涨近4%。 　　相关ETF","mediaName":"21世纪经济报道","url":"http://stock.eastmoney.com/a/202606183775851624.html"},{"date":"2026-06-15 14:47:11","image":"","code":"202606153771477375","title":"<em>江西铜业</em>、招金黄金双双涨停，黄金股ETF华夏(159562)涨超5.9%，强势冲击3连涨","content":"6月15日， 金价大幅反弹后小幅回落，COMEX黄金期货价格目前交投于4326美元附近，黄金概念股保持强势，截至14:35，黄金股ETF华夏(159562)上涨5.92%， 冲击3连涨。中证沪深港黄金产业股票指数(931238)强势上涨5.94%，成分股紫金黄金国际上涨15.62%","mediaName":"界面新闻","url":"http://stock.eastmoney.com/a/202606153771477375.html"},{"date":"2026-06-05 21:00:00","image":"","code":"202606053762225484","title":"<em>江西铜业</em>：2025年年度股东会决议公告","content":"证券日报网讯 6月5日，江西铜业发布公告称，公司2025年年度股东会审议通过《江西铜业股份有限公司2025年度董事会工作报告的议案》《江西铜业股份有限公司2025年度经审计的境内外财务报告、2025年度报告正文及其摘要的议案》《江西铜业股份有限公司关于2025年度末期利润分配方案的议案","mediaName":"证券日报","url":"http://finance.eastmoney.com/a/202606053762225484.html"},{"date":"2026-06-02 14:25:52","image":"","code":"202606023757478680","title":"有色ETF鹏华涨超3.5%，<em>江西铜业</em>盘中涨停","content":"有色金属整体上行，消息面上，人工智能催化下，锡、铜等金属价格飙涨，江西铜业盘中涨停。 　　华源证券指出，中长期看，铜矿资本开支不足，供给端扰动频发，铜矿供需格局或将由紧平衡转向短缺，铜价中长期有望上行。 　　截至2026年6月2日 13:25，国证有色金属行业指数(399395)强势上涨","mediaName":"东方财富证券","url":"http://finance.eastmoney.com/a/202606023757478680.html"},{"date":"2026-06-02 14:30:25","image":"","code":"202606023757497244","title":"有色ETF鹏华(159880)上涨3.5%，<em>江西铜业</em>盘中涨停","content":"有色金属整体上行，消息面上，人工智能催化下，锡、铜等金属价格飙涨，江西铜业盘中涨停。 　　华源证券指出，中长期看，铜矿资本开支不足，供给端扰动频发，铜矿供需格局或将由紧平衡转向短缺，铜价中长期有望上行。 　　截至2026年6月2日 14:25，国证有色金属行业指数(399395)强势上涨","mediaName":"界面新闻","url":"http://stock.eastmoney.com/a/202606023757497244.html"},{"date":"2026-06-02 14:40:04","image":"","code":"202606023757492813","title":"工<em>业</em>有色ETF万家盘中上涨超4%，成分股锡<em>业</em>股份、<em>江西铜业</em>10cm涨停","content":"2026年6月2日午后，A股有色板块涨势扩大，小金属方向领涨。截至13:47，中证工业有色金属主题指数(H11059)强势上涨3.63%，成分股锡业股份、江西铜业10cm涨停，兴业银锡上涨7.68%，洛阳钼业，云南铜业等个股跟涨。工业有色ETF万家(560860)上涨3.59%。拉长时间看","mediaName":"东方财富证券","url":"http://finance.eastmoney.com/a/202606023757492813.html"},{"date":"2026-06-02 14:38:00","image":"","code":"202606023757491842","title":"有色板块涨势扩大，工<em>业</em>有色ETF万家(560860)盘中上涨3.59%，成分股锡<em>业</em>股份、<em>江西铜业</em>10cm涨停","content":"2026年6月2日午后，A股有色板块涨势扩大，小金属方向领涨。截至13:47，中证工业有色金属主题指数(H11059)强势上涨3.63%，成分股锡业股份、江西铜业10cm涨停，兴业银锡上涨7.68%，洛阳钼业，云南铜业等个股跟涨。工业有色ETF万家(560860)上涨3.59%。拉长时间看","mediaName":"界面新闻","url":"http://stock.eastmoney.com/a/202606023757491842.html"},{"date":"2026-05-27 17:06:51","image":"","code":"202605273751371483","title":"金诚信(603979.SH)：签订<em>江西铜业</em>银山矿<em>业</em>井下采掘合同，预估金额约1.11亿元","content":"2026年5月27日，金诚信矿业管理股份有限公司（603979.SH）发布公告称，公司近日与江西铜业集团银山矿业有限责任公司签署了井下8000t项目采掘作业2026年度合同，合同为单价合同，根据预计工作量预估合同金额约11,080万元，最终以实际验收完成工作量及结算款为准。 　　合同地点位于银山矿业井下所有区域","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202605273751371483.html"},{"date":"2026-05-07 09:42:31","image":"","code":"202605073729705211","title":"港股<em>江西铜业</em>股份一度涨超3%","content":"5月7日，江西铜业股份(00358.HK)一度涨超3%，截至发稿涨2.98%，报38.68港元，成交额8044.23万港元。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202605073729705211.html"},{"date":"2026-05-06 11:09:00","image":"","code":"202605063728425941","title":"<em>江西铜业</em>：拟分拆控股子公司<em>江铜铜</em>箔赴港上市","content":"南方财经5月6日电，江西铜业(600362.SH)公告，公司拟筹划分拆控股子公司江西省江铜铜箔科技股份有限公司至香港联合交易所有限公司上市。本次分拆事项不会导致公司丧失对江铜铜箔的控制权，江铜铜箔仍为公司合并报表范围内的控股子公司。","mediaName":"南方财经网","url":"http://finance.eastmoney.com/a/202605063728425941.html"},{"date":"2026-05-05 09:49:00","image":"","code":"202605053727827554","title":"港股<em>铜业</em>股早盘走低 <em>江西铜业</em>股份跌超4%","content":"5月5日，港股铜业股早盘走低，江西铜业股份跌超4%，中国有色矿业跌近4%，五矿资源、中国黄金国际跌超2%。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202605053727827554.html"}]},"searchId":"03c05e2b-b89d-4089-9bc2-07e1876bf89c"})