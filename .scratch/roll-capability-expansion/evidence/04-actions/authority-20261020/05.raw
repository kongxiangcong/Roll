                                "reportType2": 'LSGG',
                                "reportType": 'QYXXGG',
                                "beginDate": begindate,
                                "endDate": enddate
                            });
                        }
                    } else {
                        enddate.val(today);
                        begindate.val(ccb_disclosure_module.turnDateToString(threeYearBefore));
                        ccb_disclosure_module.showajaxJumpf({
                            "isPagination": true, //是否分页
                            "productId": inputcdVal,
                            "reportType2": 'LSGG',
                            "reportType": 'QYXXGG',
                            "beginDate": begindate,
                            "endDate": enddate
                        });
