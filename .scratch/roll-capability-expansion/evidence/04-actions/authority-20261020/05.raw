        var zqdm = $.trim(jgwx.find("#inputCode").val()); //证券代码或简称
        var sjdx = jgwx.find("#ht_jglx").val(); //涉及对象
        var start = jgwx.find("#start_date").val(); //开始日期
        var end = jgwx.find("#end_date").val(); //结束日期

