                        arr.push('<tr><th>状态*</th><td>' + arrA[0].STATE_CODE_A_DESC + '/-/-</td></tr>');
                    } else if (arrA[0].TYPE == '2') {
                        arr.push('<tr><th>状态*</th><td>-/-/' + arrA[0].STATE_CODE_A_DESC + '</td></tr>');
