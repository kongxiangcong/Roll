                        'isPagination': true,
                        'pageHelp.pageSize': 15,
                        'pageHelp.pageNo': 1,
                        'pageHelp.beginPage': 1,
                        'pageHelp.cacheSize': 1,
                        'pageHelp.endPage': 5,
                        'type': selectChoiceNew
                    }
                })
            }
        });
        //初始化全部tab
        $(".jgcs .nav li:first").click();
    }
});

