        } else if ((start || end) && start < "1990-12-19") {
            alert("您选择的日期超出检索范围，请重输。");
        } else if ((start || end) && end > get_systemDate_global()) {
            alert("您选择的日期超出检索范围，请重输。");
        } else {
            ajaxJGWX({
                url: sseQueryURL + "commonSoaQuery.do",
