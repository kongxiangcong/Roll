  <script>
  var ww = $(window).width();   
    if(ww > 768){
        $(".mk_twoMenu").height($(window).height()-$(".mk_twoMenu").offset().top +"px")
        $(".header").removeClass("header2")
        var myFullpage = new fullpage('#FullpageC', {
            verticalCentered: true,
            navigation: true,
            navigationPosition:"left",
            //menu: '#fp-nav',
            //anchors: ['section1', 'section2', 'section3', 'section4', 'section5', 'section6'],
            onLeave: function(anchorLink,index){
               // console.log(index.index)
               // console.log(anchorLink)
                if(index.index == 0){
                    $('.header').removeClass("header2")
                    $(".nav").css("display","block")
                    $(".fp-left").css("display","none")
                    $(".pingVideo").get(0).play();
                }else{
                    $('.header').addClass("header2")
                    $(".nav").css("display","none")
                    $(".fp-left").css("display","block")
                    $(".pingVideo").get(0).pause();
                }
                $("#fp-nav .showpage em").text("0"+(index.index+1))
            }

        })
        $("#fp-nav").append("<p class='showpage'><em>01</em>/06</p>")
   
    }
    // banner轮播
    var swiper1 = new Swiper(".mySwiper", {
        spaceBetween: 30,
        centeredSlides: true,
        //autoplay: {
       //   delay: 1000,
       //   disableOnInteraction: false,
       // },
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
          renderBullet: function (index, className) {return '<span class="' + className + '">' + (index + 1)  +"</span>";},
        },
        navigation: {
          nextEl: ".swiper-button-next",
          prevEl: ".swiper-button-prev",
        },
      });
    $(".banner_but_con .prev").click(function(event) {
        swiper1.slidePrev();
    });
    $(".banner_but_con .next").click(function(event) {
        swiper1.slideNext();
    });
    //产品中心
    $(".cpList .bd li").each(function(i){
        $(".cpList .bd li").slice(i*6,i*6+6).wrapAll("<ul></ul>")
    })
    jQuery(".cpList").slide({mainCell:".bd",autoPage:true,effect:"leftLoop",autoPlay:false,pnLoop:false})
    //公司概况-公司简介图片
    var swiper2 = new Swiper('.aboutC .swiper-container', {
        /*autoplay: {
            delay:6000,
            disableOnInteraction: false
        },*/
        observeParents:false,
        observer:true, 
        navigation: {
            nextEl: ".swiper_btn .next",
            prevEl: ".swiper_btn .prev"
        }
    })
    $(".gsgkTitle li").click(function(){
        $(this).addClass("on").siblings().removeClass("on")
        $(".qygkCon .qygkTab").hide()
        $(".qygkCon .qygkTab").eq($(this).index()).show()

    })
    //新闻中心
    $(".newsTitle li").click(function(){
        $(this).addClass("on").siblings().removeClass("on")
        $(".newsTabC .newsList").hide()
        $(".newsTabC .newsList").eq($(this).index()).show()
        $(".newsTabC .newsList").eq($(this).index()).css({"-webkit-animation":"slideInRight .6s 1 linear","animation":"slideInRight .6s 1 linear","animation-fill-mode":"forwards"})
    })
    $(".newdata").each(function(){
      var data0=$(this).text()
      $(this).html(data0.substr(5)+"<em>"+data0.substr(0,4)+"</em>")
    })
    var swiper3 = new Swiper('.xwzxCon', {
        loop: false,
        observeParents:false,
        observer:true, 
        pagination: {
            el: '.pagination_xwzx p'
        },
        navigation: {
            nextEl: ".xwzxnext",
            prevEl: ".xwzxprev"
        }
    })
    var swiper4 = new Swiper('.dwmjCon', {
        loop: false,
        observeParents:false,
        observer:true, 
        pagination: {
            el: '.pagination_dwmj p'
        },
        navigation: {
            nextEl: ".dwmjnext",
            prevEl: ".dwmjprev"
        }
    })
    $(".newsList").eq(1).hide()
    /*$(".newsList2 .newimg").each(function(){
        if($(this).find("img").length==0){
            $(this).parents("dd").addClass("nonewimg")
        }
    })*/
</script> 
  <script>
// 获取页面高度
var height = window.innerHeight;
$(".mt_banner").css("height", height);
$(".pingVideo").css("height", height);

// 添加窗口大小改变的监听器
window.addEventListener('resize', function() {
  if (window.innerWidth >= 768) {
    var newHeight = window.innerHeight;
    $(".mt_banner").css("height", newHeight);
    $(".pingVideo").css("height", newHeight);
  } else {
    $(".mt_banner").css("height", "auto");
    $(".pingVideo").css("height", "auto");
  }
});
</script> 
  <script>
//视频点击
$(".Otab_one").hide();
$(".videoStart").click(function(){
$(this).hide();
$(".videoend").fadeIn();
  $(".pingVideo").get(0).pause();
})
$(".videoend").click(function(){ 
$(".Otab_one").hide();
$(this).hide();
$(".videoStart").fadeIn();
  $(".pingVideo").get(0).play();
})
$(".banner1").hover(function () {
$(".aboutVideo").show();
}, function () {
$(".aboutVideo").hide();
})

$(".first-flick").hover(function () {
$(".aboutVideo").show();
}, function () {
$(".aboutVideo").hide();
})
/*触摸显示视频中间开关*/
$(".tjyh_content").hover(function () {
$(".aboutVideo").show();
}, function () {
$(".aboutVideo").hide();
})

//搜索
$(".searchBtn").click(function(){
   $(".searchBtnrBox ").fadeIn(500);
   $(".searchBtn").fadeOut(500);
   $(".nav").fadeOut(500);
   $(".searchEN").fadeOut(500);
})

$(".searchBtnrImg").click(function(){
   $(".searchBtnrBox ").fadeOut(500);
   $(".searchBtn").fadeIn(500);
   $(".nav").fadeIn(500);
   $(".searchEN").fadeIn(500);
})

</script> 
